+                         float rayStartY, float rayLength, float& outY) {
+    if (!handle) return false;
+    auto* tw = static_cast<TerrainWrapper*>(handle);
+    if (TerrainWrapper::allInstances().find(tw) == TerrainWrapper::allInstances().end() || !tw->manager) {
