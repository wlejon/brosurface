+ * @example
+ *   // Raycasting and surface editing
+ *   const hit = terrain.raycast([0, 50, 0], [0, -1, 0], 100);
+ *   if (hit) {
+ *     terrain.setVoxel(hit.position[0], hit.position[1], hit.position[2], 0);
+ *     terrain.rebuild();
+ *   }
+ */
+
