/**
 * =============================================================================
 * bro.window & window.* — Runtime Window & Display Management
 * =============================================================================
 *
 * Runtime window state control (borderless, always-on-top, position, size limits,
 * display enumeration and placement).
 *
 * @example
 *   bro.window.borderless = true;
 *   bro.window.alwaysOnTop = true;
 *   const pos = bro.window.getPosition();
 *   console.log('Window position:', pos.x, pos.y);
 *   const displays = bro.window.getDisplays();
 *   console.log('Displays attached:', displays.length);
 */

/**
 * Desktop coordinates and dimensions of a rectangle.
 */
dictionary DisplayRect {
  /** X coordinate in desktop pixels. */
  long x;
  /** Y coordinate in desktop pixels. */
  long y;
  /** Width in desktop pixels. */
  long width;
  /** Height in desktop pixels. */
  long height;
};

/**
 * Display device descriptor.
 */
dictionary DisplayInfo {
  /** Stable SDL display identifier. */
  unsigned long id;
  /** Display device name. */
  DOMString name;
  /** X coordinate in desktop pixels. */
  long x;
  /** Y coordinate in desktop pixels. */
  long y;
  /** Width in desktop pixels. */
  long width;
  /** Height in desktop pixels. */
  long height;
  /** Usable work area X in desktop pixels. */
  long workX;
  /** Usable work area Y in desktop pixels. */
  long workY;
  /** Usable work area width in desktop pixels. */
  long workWidth;
  /** Usable work area height in desktop pixels. */
  long workHeight;
  /** Refresh rate in Hz. */
  double refreshRate;
  /** OS content scale multiplier (1.0 = 100%). */
  double contentScale;
  /** Whether this is the system primary display. */
  boolean isPrimary;
  /** Whether the active window currently sits on this display. */
  boolean isCurrent;
  /** The same rectangle as x/y/width/height, nested. */
  [manual] DisplayRect bounds;
  /** The same rectangle as workX/workY/workWidth/workHeight, nested. */
  [manual] DisplayRect workArea;
};

/**
 * 2D desktop position.
 */
dictionary WindowPosition {
  /** Desktop X coordinate. */
  long x;
  /** Desktop Y coordinate. */
  long y;
};

/**
 * 2D window dimensions.
 */
dictionary WindowSize {
  /** Width in pixels. */
  long width;
  /** Height in pixels. */
  long height;
};

/**
 * Runtime window management namespace.
 */
[cpp_namespace="bro::js", prefix="bro."]
namespace window {
  /**
   * Current window display state ('normal', 'minimized', 'maximized', 'fullscreen').
   */
  readonly attribute DOMString state;

  /**
   * Whether the window has OS borders and title bar removed.
   */
  attribute boolean borderless;

  /**
   * Whether the window stays pinned above standard windows.
   */
  attribute boolean alwaysOnTop;

  /**
   * Minimizes the window.
   */
  void minimize();

  /**
   * Maximizes the window.
   */
  void maximize();

  /**
   * Restores the window from minimized or maximized state.
   */
  void restore();

  /**
   * Retrieves current desktop coordinate position of the window.
   */
  WindowPosition getPosition();
  void setPosition(long x, long y);
  WindowSize getMinSize();
  void setMinSize(long width, long height);
  WindowSize getMaxSize();
  void setMaxSize(long width, long height);
  sequence<DisplayInfo> getDisplays();
  boolean moveToDisplay(unsigned long id);
};
