/**
 * =============================================================================
 * bro Scene Graph API Reference
 * =============================================================================
 *
 * 3D Scene Graph containing hierarchically nested nodes (MeshNode, SkinnedMeshNode,
 * InstancedMeshNode, LightNode, CameraNode, ParticleNode, HtmlNode, ShapeNode, SpriteNode).
 */

dictionary SceneNodeOptions {
  DOMString name;
  sequence<unrestricted double> position;
  sequence<unrestricted double> rotation;
  sequence<unrestricted double> scale;
  boolean visible;
};

/**
 * Camera view for setCamera() (the imperative view) and createCamera() (a
 * camera node). Three shapes:
 *
 *   perspective (default): { fov=60, near=0.1, far=1000, aspect, eye, target, up }
 *   quaternion:            { fov, near, far, aspect, eye, quaternion: [x,y,z,w] }
 *     camera local -Z is forward; `quaternion` overrides target/up/mode
 *   orthographic:          { mode: "orthographic", size=10, near, far, aspect, eye, target, up }
 *
 * `position` is accepted as an alias of `eye` and `lookAt` of `target`.
 */
dictionary SceneCameraOptions {
  /** Vertical field of view in degrees (perspective only, default 60). */
  unrestricted double fov;
  /** Near clipping plane (default 0.1). */
  unrestricted double near;
  /** Far clipping plane (default 1000). */
  unrestricted double far;
  /** Camera position [x,y,z] (default [0,5,-10]). `position` is an alias. */
  sequence<unrestricted double> eye;
  /** Look-at point [x,y,z] (default [0,0,0]). `lookAt` is an alias. */
  sequence<unrestricted double> target;
  /** Up vector [x,y,z] (default [0,1,0]). */
  sequence<unrestricted double> up;
  /**
   * width/height. Omit it (or pass <= 0) and the projection is built from
   * the current canvas size AND flagged to auto-follow future canvas
   * resizes, which is normally what you want; an explicit aspect pins the
   * projection. With no canvas size yet the omitted case falls back to 4/3.
   */
  unrestricted double aspect;
  /**
   * [x,y,z,w] camera orientation, local -Z forward. Set, it overrides
   * target/up/mode: the 6DOF / FPS path that avoids target+up precision loss.
   */
  sequence<unrestricted double> quaternion;
  /** "perspective" (default) or "orthographic" / "ortho". */
  DOMString mode;
  /** Orthographic view height in world units (default 10). */
  unrestricted double size;
};

dictionary WindConfig {
  /** Sway direction [x,y,z] (default [1,0,0]). */
  sequence<unrestricted double> direction;
  /** Displacement amplitude in world units (default 0: no sway). */
  unrestricted double strength;
  /** Oscillation frequency in rad/s (default 1.5). */
  unrestricted double frequency;
};

dictionary SceneRaycastResult {
  SceneNode node;
  sequence<unrestricted double> point;
  sequence<unrestricted double> normal;
  unrestricted double distance;
};

dictionary SceneCullStats {
  long totalNodes;
  long renderedNodes;
  long culledNodes;
};

dictionary ImpostorAtlasInfo {
  long width;
  long height;
  long cols;
  long rows;
  unrestricted double boundsRadius;
  sequence<unrestricted double> boundsCenter;
  Uint8Array atlasRGBA;
};

dictionary ImpostorOptions {
  unrestricted double margin;
  unrestricted double cullNear;
  unrestricted double cullFar;
};

dictionary ImpostorResult {
  SceneNode node;
  long quadCount;
};

dictionary MeshNodeOptions {
  Mesh mesh;
  DOMString material;
  DOMString castShadow;
  DOMString receiveShadow;
  sequence<unrestricted double> position;
  sequence<unrestricted double> rotation;
  sequence<unrestricted double> scale;
  boolean visible;
};

dictionary MeshGeometry {
  Float32Array positions;
  Uint32Array indices;
  Float32Array normals;
  Float32Array uvs;
  Float32Array colors;
  Float32Array tangents;
};

dictionary MeshUpdateOptions {
  boolean recomputeNormals;
};

dictionary SkinnedMeshNodeOptions {
  Mesh mesh;
  SkinData skin;
  Skeleton skeleton;
  DOMString material;
  sequence<unrestricted double> position;
  sequence<unrestricted double> rotation;
  sequence<unrestricted double> scale;
  boolean visible;
};

dictionary InstancedMeshNodeOptions {
  Mesh mesh;
  long capacity;
  DOMString material;
  sequence<unrestricted double> position;
  sequence<unrestricted double> rotation;
  sequence<unrestricted double> scale;
  boolean visible;
};

dictionary GaussianSplatNodeOptions {
  DOMString file;
  ArrayBuffer data;
  object cloud;
  sequence<unrestricted double> position;
  sequence<unrestricted double> rotation;
  sequence<unrestricted double> scale;
  boolean visible;
};

dictionary HtmlNodeOptions {
  DOMString html;
  unrestricted double width;
  unrestricted double height;
  sequence<unrestricted double> position;
  sequence<unrestricted double> rotation;
  sequence<unrestricted double> scale;
  boolean visible;
};

dictionary LightNodeOptions {
  DOMString type;
  sequence<unrestricted double> color;
  unrestricted double intensity;
  unrestricted double range;
  unrestricted double innerCone;
  unrestricted double outerCone;
  boolean castShadow;
  sequence<unrestricted double> position;
  sequence<unrestricted double> rotation;
};

dictionary ParticleNodeOptions {
  long maxParticles;
  DOMString texture;
  sequence<unrestricted double> position;
  boolean visible;
};

dictionary Particles3DNodeOptions {
  long maxParticles;
  DOMString mode;
  Mesh mesh;
  sequence<unrestricted double> position;
  boolean visible;
};

dictionary DecalNodeOptions {
  DOMString texture;
  sequence<unrestricted double> size;
  sequence<unrestricted double> position;
  sequence<unrestricted double> rotation;
};

dictionary ReflectionProbeNodeOptions {
  sequence<unrestricted double> size;
  long resolution;
  sequence<unrestricted double> position;
};

interface SceneNode {
  readonly attribute long id;
  attribute DOMString name;
  attribute boolean visible;
  attribute unrestricted double x;
  attribute unrestricted double y;
  attribute unrestricted double z;
  attribute sequence<unrestricted double> position;
  attribute sequence<unrestricted double> rotation;
  attribute unrestricted double rotationX;
  attribute unrestricted double rotationY;
  attribute unrestricted double rotationZ;
  attribute sequence<unrestricted double> scale;
  attribute unrestricted double scaleX;
  attribute unrestricted double scaleY;
  attribute unrestricted double scaleZ;
  attribute sequence<unrestricted double> quaternion;

  attribute unrestricted double fov;
  attribute unrestricted double near;
  attribute unrestricted double far;
  attribute unrestricted double aspect;
  attribute unrestricted double orthoHeight;
  attribute DOMString projection;

  readonly attribute sequence<unrestricted double> worldPosition;
  readonly attribute sequence<unrestricted double> worldMatrix;
  readonly attribute SceneNode? parent;
  readonly attribute sequence<SceneNode> children;

  SceneNode add(SceneNode child);
  void remove(SceneNode child);
  SceneNode addChild(SceneNode child);
  void removeChild(SceneNode child);
  void destroy();

  SceneNode setPosition(unrestricted double x, unrestricted double y, unrestricted double z);
  SceneNode setRotation(unrestricted double x, unrestricted double y, unrestricted double z, optional unrestricted double w);
  SceneNode setScale(unrestricted double x, optional unrestricted double y, optional unrestricted double z);
  SceneNode lookAt(sequence<unrestricted double> target, optional sequence<unrestricted double> up);
  [manual] object localToWorld(unrestricted double x, unrestricted double y, optional unrestricted double z);
  [manual] object worldToLocal(unrestricted double x, unrestricted double y, optional unrestricted double z);

  // Mesh & Skinned mesh methods
  /**
   * Replace a MeshNode's geometry in place: positions and indices (both
   * required), with normals, uvs, colors and tangents when given. A Mesh
   * object works too. The node, its material, transform and children are
   * untouched, so this is the per-frame path for geometry that deforms —
   * a soft body's vertices(), a procedural surface, a streamed chunk.
   * Normals are recomputed when the geometry carries none or when
   * `opts.recomputeNormals` is true. Throws on a node that is not a
   * MeshNode. Returns the node.
   * @example
   * const topo = cloth.topology();
   * const node = scene.createMesh({ positions: cloth.vertices(), indices: topo.indices });
   * // each frame, after Physics.step():
   * node.updateMesh({ positions: cloth.vertices(), indices: topo.indices },
   *                 { recomputeNormals: true });
   */
  [manual] SceneNode updateMesh((MeshGeometry or Mesh) mesh, optional MeshUpdateOptions opts);
  [manual] SceneNode setMaterial(object mat);
  [manual] SceneNode setSkeleton(Skeleton skeleton);
  [manual] SceneNode addClip(DOMString name, any anim);
  [manual] Float32Array? getBoneWorldMatrix(any nameOrIndex);
  [manual] SceneNode addBlendSpace1D(DOMString name, sequence<BlendSpace1DClip> clips);
  [manual] SceneNode addBlendSpace2D(DOMString name, sequence<BlendSpace2DClip> clips);
  [manual] SceneNode setBlendPos(DOMString name, unrestricted double x, optional unrestricted double y);
  [manual] object? blendState(optional DOMString name);
  [manual] SceneNode playLayer(long layer, DOMString clipName, optional object opts);
  [manual] SceneNode stopLayer(long layer, optional unrestricted double fadeTime);
  [manual] SceneNode setLayerWeight(long layer, unrestricted double weight);
  [manual] SceneNode addStateMachine(any nameOrDef, optional AnimStateMachineDef def);
  [manual] boolean travel(DOMString name, optional DOMString targetState);
  [manual] SceneNode setRootMotion(any enabledOrOpts);
  [manual] object consumeRootMotion();
  [manual] SceneNode play(optional DOMString clipName, optional object opts);
  [manual] SceneNode stop(optional object opts);
  [manual] SceneNode pause();
  [manual] SceneNode resume();
  [manual] long setSkinningMatrices(Float32Array matrices);

  // Animation player & Skinned mesh attributes
  readonly attribute long boneCount;
  readonly attribute boolean skinReady;
  readonly attribute boolean isPlaying;
  readonly attribute DOMString currentAnimation;
  readonly attribute unrestricted double animationDuration;
  attribute unrestricted double animationTime;
  attribute unrestricted double animationSpeed;
  readonly attribute DOMString state;

  // Instanced mesh methods
  void setInstanceTransform(long index, sequence<unrestricted double> matrix);
  void setInstanceColor(long index, sequence<unrestricted double> color);
  void setInstanceCount(long count);

  // HTML / Effects methods
  SceneNode setHtml(DOMString html);
  void markHtmlDirty();
  void burst(long count);
  void clear();
  void probeCapture();
  /** Writes a Gaussian-splat node's cloud as a PLY file; false when the write fails. */
  boolean savePly(DOMString path);
};

[cpp_namespace="bro::js", cpp_guard="BRO_WITH_3D", gate="BRO_WITH_3D"]
interface SceneGraph {
  readonly attribute SceneNode root;
  attribute unrestricted double cameraX;
  attribute unrestricted double cameraY;
  attribute unrestricted double cameraZoom;
  attribute boolean showLightIcons;
  attribute boolean frustumCulling;
  attribute boolean shadowCache;
  attribute unrestricted double renderScale;
  attribute unrestricted double msaa;
  attribute SceneNode? activeCamera;

  readonly attribute sequence<unrestricted double> viewMatrix;
  readonly attribute sequence<unrestricted double> projectionMatrix;
  readonly attribute sequence<unrestricted double> cameraEye;

  SceneNode createNode(optional SceneNodeOptions opts);
  [manual] SceneNode createShape(optional object opts);
  [manual] SceneNode createSprite(optional object opts);
  [manual] SceneNode createPhysicsNode(optional object opts);
  [manual] SceneNode createMesh(optional MeshNodeOptions opts);
  [manual] SceneNode createSkinnedMesh(optional SkinnedMeshNodeOptions opts);
  [manual] SceneNode createInstancedMesh(optional InstancedMeshNodeOptions opts);
  [manual] SceneNode createGaussianSplat(optional GaussianSplatNodeOptions opts);
  SceneNode createHtmlNode(optional HtmlNodeOptions opts);
  SceneNode createLight(optional LightNodeOptions opts);
  SceneNode createParticles(optional ParticleNodeOptions opts);
  [manual] SceneNode createParticles3D(optional Particles3DNodeOptions opts);
  SceneNode createDecal(optional DecalNodeOptions opts);
  SceneNode createReflectionProbe(optional ReflectionProbeNodeOptions opts);
  Tween createTween();
  AnimationPlayer createAnimationPlayer();
  Terrain createTerrain(optional TerrainConfig opts);
  [manual] ClipmapTerrain createClipmapTerrain(optional ClipmapTerrainConfig opts);
  [manual] TileWorld createTileWorld(optional TileWorldConfig opts);

  SceneNode? findById(long id);
  SceneNode? findByName(DOMString name);
  void destroyNode(SceneNode node);

  /**
   * Install the imperative view (see SceneCameraOptions). The LAST camera
   * call wins: setCamera deactivates the active camera node, and
   * setActiveCamera overrides an imperative view. `activeCamera` is null
   * while the imperative view is in effect.
   */
  void setCamera(optional SceneCameraOptions opts);
  /**
   * Create a camera NODE and add it to the root. The node's WORLD transform
   * is the view (local -Z forward, +Y up); only projection parameters live
   * on the node. `name` and `active` (activate it now) are also accepted.
   */
  SceneNode createCamera(optional SceneCameraOptions opts);
  void setActiveCamera(SceneNode camera);

  void setToneMap(optional ToneMapConfig opts);
  void setAmbient(optional AmbientConfig opts);
  /**
   * Global wind sway for meshes created with `wind` set:
   * pos += direction * sin(time*frequency + dot(pos.xz, k)) * strength * bend.
   * The engine advances the wind clock from the per-frame virtual delta so
   * offline captures stay deterministic.
   */
  void setWind(optional WindConfig opts);
  /**
   * Shadow atlas size and filter. `setShadowQuality(atlasSize, pcfTaps)`
   * positional is accepted too.
   */
  void setShadowQuality(optional ShadowQualityConfig opts);
  void setShadowCache(optional ShadowCacheConfig opts);
  void setFog(optional FogConfig opts);
  void setAtmosphere(optional AtmosphereConfig opts);
  void setStarfield(optional StarfieldConfig opts);
  void setTiltShift(optional TiltShiftConfig opts);
  void setBloom(optional BloomConfig opts);
  void setSSAO(optional SSAOConfig opts);
  void setSSR(optional SSRConfig opts);
  void setDepthOfField(optional DepthOfFieldConfig opts);
  /**
   * Loads a colour-grading LUT strip (`path`, `size` inferred from the strip
   * when 0, `amount` 0..1) and applies it as the last tonemap stage; false
   * when the strip fails to decode. Call with no options (or null) to clear.
   */
  boolean setColorLUT(optional ColorLUTConfig opts);
  void setFXAA(boolean enabled);
  void setRenderScale(unrestricted double scale);
  void setMSAA(long samples);
  void setEnvironment(optional EnvironmentConfig opts);
  void setFrustumCulling(boolean enabled);
  SceneCullStats cullStats();

  void clear();
  void syncPhysics();
  SceneRaycastResult? raycast(sequence<unrestricted double> origin, sequence<unrestricted double> direction);
  sequence<unrestricted double> unprojectLocal(SceneNode node, sequence<unrestricted double> screenPoint);
  [manual] ImageData toImageData();
  [manual] ImageData captureFrame(optional DOMString format, optional unrestricted double quality);
  [manual] object asTexture();
  void bindAudioListenerToCamera(boolean bind);
  [manual] void attachAIWorld(object aiWorld, optional object opts);
  void detachAIWorld();
};
