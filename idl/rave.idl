/**
 * =============================================================================
 * bro.rave — RAVE Neural Audio Autoencoder
 * =============================================================================
 *
 * Real-time variational audio autoencoder for high-fidelity compression,
 * latent space manipulation, and resynthesis.
 *
 * @example
 *   // Load model and encode/decode audio
 *   const audio = new Float32Array(48000);
 *   const rave = bro.rave.loadRave('../brosoundml-data/rave/magnets_z8');
 *   const { latent, nLatent, frames } = rave.encode(audio);
 *   const out = rave.decode(latent, frames);
 *   console.log('Decoded samples:', out.samples.length, 'sampleRate:', out.sampleRate);
 *
 * @example
 *   // Decode with noise synthesis
 *   const rave = bro.rave.loadRave('../brosoundml-data/rave/magnets_z8');
 *   const latent = new Float32Array(8 * 100);
 *   const noisy = rave.decode(latent, 100, { addNoise: true, seed: 42 });
 *
 * @example
 *   // Stereo decode with decorrelated channels
 *   const rave = bro.rave.loadRave('../brosoundml-data/rave/magnets_z8');
 *   const latent = new Float32Array(8 * 100);
 *   const stereo = rave.decode(latent, 100, { channels: 2, stereoWidth: 1.0, seed: 1 });
 *   console.log('Stereo channels:', stereo.channels);
 */

/**
 * Options for decoding a latent tensor into audio samples.
 */
dictionary RaveDecodeOptions {
  /** Run stochastic noise synthesis branch */
  boolean addNoise = false;
  /** RNG seed for noise and stereo decorrelation */
  long long seed;
  /** Channel count (1 = mono, 2 = stereo interleaved) */
  long channels = 1;
  /** Stereo width standard deviation for latent pad */
  double stereoWidth = 1.0;
};

/**
 * Result of encoding an audio waveform into latent space.
 */
dictionary RaveLatent {
  /** Channel-major latent tensor (nLatent * frames floats) */
  required Float32Array latent;
  /** Number of latent channels */
  required long nLatent;
  /** Number of temporal latent frames */
  required long frames;
};

/**
 * Decoded audio waveform buffer.
 */
dictionary RaveAudioBuffer {
  /** Decoded float32 PCM samples */
  required Float32Array samples;
  /** Sample rate in Hz */
  required long sampleRate;
  /** Channel count */
  required long channels;
};

/**
 * Options for loading a RAVE model.
 */
dictionary RaveLoadOptions {
  /** Target device ('cuda', 'metal', or 'cpu') */
  DOMString device;
  /** Async load success callback */
  Function onReady;
  /** Async load error callback */
  Function onError;
};

/**
 * RAVE neural audio autoencoder model handle.
 */
[cpp_namespace="bro::js"]
interface Rave {
  /** Whether the model is loaded and ready */
  readonly attribute boolean loaded;
  /** Native audio sample rate in Hz */
  readonly attribute long sampleRate;
  /** Number of retained latent dimensions */
  readonly attribute long nLatent;
  /** Full encoder distribution latent width */
  readonly attribute long fullLatent;
  /** PQMF band count */
  readonly attribute long nBand;
  /** Compression ratio (audio samples per latent frame) */
  readonly attribute long totalRatio;

  /**
   * Encodes a mono Float32Array waveform into its latent representation.
   * @param audio Input PCM audio at model sample rate
   * @returns Latent representation tensor
   */
  RaveLatent encode(Float32Array audio);

  /**
   * Decodes a latent representation back to an audio waveform.
   * @param latent Latent Float32Array tensor
   * @param frames Number of temporal frames
   * @param opts Decoding options
   * @returns Decoded audio waveform buffer
   */
  RaveAudioBuffer decode(Float32Array latent, long frames, optional RaveDecodeOptions opts);
};

/**
 * RAVE audio model namespace.
 */
[gate="BRO_WITH_SOUNDML", cpp_namespace="bro::js", prefix="bro."]
namespace rave {
  /**
   * Probes and initializes the brotensor runtime backend.
   */
  void init();

  /**
   * Loads a converted RAVE v2 model from a weights directory.
   * @param modelDir Directory containing config.json and model.safetensors
   * @param opts Optional load configuration and async callbacks
   * @returns Rave model instance
   */
  Rave loadRave(DOMString modelDir, optional RaveLoadOptions opts);
};
