/**
 * =============================================================================
 * Vendor Globals — Third-Party Vendored Library Bridges
 * =============================================================================
 *
 * Bridges global symbols loaded via script tags (signals, CodeMirror, acorn,
 * tern, esprima, jsonlint, draco_encoder) so AOT-compiled Bronze apps can read
 * and invoke them seamlessly.
 *
 * @example
 *   // Access vendored global library from compiled realm
 *   if (typeof CodeMirror !== 'undefined') {
 *     console.log('CodeMirror loaded');
 *   }
 */

/**
 * Third-party vendor globals bridge namespace.
 */
[
  bh_file="host_vendor_globals.cpp",
  bh_header="bronze_host/bronze_host.h",
  bh_includes="#include \"bronze_host/gl_internal.h\"\n#include \"bronze_host/host_internal.h\"\n#include \"bronze_host/host_interp.h\"\n#include \"util/log.h\"",
  bh_namespace="bro::bronze_host",
  bh_install="installVendorGlobals",
  bh_prologue="\nnamespace {\n\n// Registration order is web_host.globals' order, and the manifest is why the\n// list is spelled out rather than discovered: every name a module was compiled\n// against must be registered before the module runs, or the first READ of it\n// is a fatal() inside bronze rather than a catchable miss. So a name goes in\n// whether or not the page defined it — as the page's value when there is one,\n// and as `undefined` when there is not.\nconstexpr const char* kVendorGlobals[] = {\n    \"signals\", \"CodeMirror\", \"acorn\", \"tern\", \"esprima\", \"jsonlint\", \"draco_encoder\",\n};\n\n}  // namespace\n",
  bh_install_body="    std::string missing;\n    for (const char* name : kVendorGlobals) {\n        Value v = bridgeJsGlobal(name);\n        ev::registerGlobal(name, v);\n        if (ev::isUndefined(v)) {\n            if (!missing.empty()) missing += \", \";\n            missing += name;\n        }\n    }\n    // One line, not one per name: for most apps every one of these is absent\n    // and that is unremarkable — they are the three.js editor's dependencies,\n    // not the layer's. It is worth saying once, because \"CodeMirror is\n    // undefined\" thrown from inside a compiled module names neither the page\n    // nor the reason.\n    if (!missing.empty()) {\n        LOG_INFO(\"bronze_host: the page defines no %s; compiled reads of those names \"\n                 \"answer undefined\",\n                 missing.c_str());\n    }\n}",
  bh_no_proto_methods=true
]
namespace vendor_globals {
  /** Signals event emitter / reactive signal library. */
  readonly attribute any signals;

  /** CodeMirror in-browser code editor. */
  readonly attribute any CodeMirror;

  /** Acorn JavaScript parser. */
  readonly attribute any acorn;

  /** Tern JavaScript code-analysis engine. */
  readonly attribute any tern;

  /** Esprima ECMAScript parsing infrastructure. */
  readonly attribute any esprima;

  /** JSONLint JSON validator. */
  readonly attribute any jsonlint;

  /** Draco geometry mesh encoder. */
  readonly attribute any draco_encoder;
};
