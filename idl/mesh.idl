/**
 * =============================================================================
 * bro Mesh API Reference
 * =============================================================================
 *
 * The bromesh C++ library is exposed via these classes and namespaces:
 * Mesh, MeshBVH, ProgressiveMesh, PolyMesh, CapsuleField, LSystem.
 */

dictionary MeshOptions {
  Float32Array positions;
  Float32Array normals;
  Float32Array uvs;
  Float32Array colors;
  Uint32Array indices;
};

dictionary MeshBVHIntersectResult {
  boolean hit;
  unrestricted double distance;
  long triangle;
  sequence<unrestricted double> point;
  sequence<unrestricted double> normal;
  sequence<unrestricted double> uv;
  sequence<unrestricted double> barycentric;
};

dictionary MeshletGroupResult {
  long meshletCount;
  ArrayBuffer meshlets;
  Uint32Array vertices;
  Uint8Array triangles;
};

dictionary MeshUVQualityResult {
  unrestricted double coverage;
  unrestricted double minAreaRatio;
  unrestricted double maxAreaRatio;
  unrestricted double avgStretch;
  unrestricted double maxStretch;
  unrestricted double avgAngleError;
  long overlaps;
};

dictionary MeshUVDistortionResult {
  unrestricted double stretch;
  unrestricted double areaDistortion;
  unrestricted double angleDistortion;
};

dictionary MeshRepairStats {
  long nonManifoldEdgesFixed;
  long degenerateTrianglesRemoved;
  long selfIntersectionsResolved;
  long holesClosed;
};

dictionary MeshBakeTransferOptions {
  unrestricted double maxDistance;
  unrestricted double uvScale;
  sequence<unrestricted double> uvOffset;
  long sampleQuality;
  DOMString normalSpace;
};

dictionary MeshTreeOptions {
  sequence<unrestricted double> base;
  sequence<unrestricted double> canopyCenter;
  unrestricted double canopyRadius;
  long attractorCount;
  long sides;
  unrestricted double leafRadius;
  unrestricted double pipeExp;
  long seed;
  /** Space-colonization tuning for the skeleton pass. */
  MeshSpaceColonizationOptions colonize;
};

/** Result of Mesh.tree(): the thickened skeleton plus its swept branch mesh. */
dictionary MeshTreeResult {
  sequence<MeshBranchSegment> segments;
  Mesh branches;
};

dictionary MeshSweepOptions {
  boolean closeProfile;
  boolean capStart;
  boolean capEnd;
  boolean miterJoints;
  /** Per-ring profile scale: a number, or one entry per path point. */
  any profileScale;
  /** Per-ring twist in radians: a number, or one entry per path point. */
  any twist;
};

dictionary MeshTubeOptions {
  boolean capStart;
  boolean capEnd;
  boolean miterJoints;
};

dictionary MeshBladeStripOptions {
  unrestricted double width;
  unrestricted double thickness;
  boolean capStart;
  boolean capEnd;
  boolean miterJoints;
  any profileScale;
  any twist;
};

dictionary MeshBladePathOptions {
  sequence<unrestricted double> base;
  sequence<unrestricted double> tipDir;
  unrestricted double length;
  unrestricted double bend;
  unrestricted double lift;
  long segments;
};

/** Capsule obstacle for CapsuleField: the segment a→b swept by `radius`. */
dictionary MeshCapsule {
  sequence<unrestricted double> a;
  sequence<unrestricted double> b;
  unrestricted double radius;
  /** Optional identity used by the `excludeTag` query parameters. */
  long tag;
};

/** Sphere obstacle / keep-out volume. */
dictionary MeshSphere {
  sequence<unrestricted double> center;
  unrestricted double radius;
  long tag;
};

dictionary MeshCapsuleFieldNearest {
  sequence<unrestricted double> point;
  sequence<unrestricted double> normal;
  unrestricted double distance;
  long tag;
};

dictionary MeshAnchorPackOptions {
  unrestricted double minSpacing;
  unrestricted double minObstacleDistance;
  long maxCount;
  unrestricted double seed;
  /** CapsuleField the anchors must clear by `minObstacleDistance`. */
  any avoid;
  sequence<MeshSphere> keepOut;
};

dictionary MeshTurtleOptions {
  unrestricted double stepLength;
  /** Turn angle in radians. */
  unrestricted double angle;
  unrestricted double radius;
  sequence<unrestricted double> position;
  sequence<unrestricted double> heading;
  sequence<unrestricted double> up;
};

dictionary MeshLeafCardOptions {
  unrestricted double width;
  unrestricted double length;
  unrestricted double bend;
  unrestricted double curl;
  boolean stemOffset;
  unrestricted double cup;
  long widthSegments;
  long lengthSegments;
  boolean fullUV;
  boolean shapedSilhouette;
};

dictionary MeshFlowerOptions {
  long petalCount;
  DOMString petalShape;
  unrestricted double petalLength;
  unrestricted double petalWidth;
  unrestricted double petalCurl;
  unrestricted double petalBend;
  long layers;
  unrestricted double layerTwist;
  unrestricted double centerRadius;
  unrestricted double centerHeight;
  unrestricted double outerTilt;
  unrestricted double innerTilt;
  unrestricted double layerScaleFalloff;
  unrestricted double outerYLift;
  unrestricted double innerYLift;
  unrestricted double petalCup;
  boolean shapedPetals;
  sequence<unrestricted double> centerColor;
};

dictionary MeshBezierSweepOptions {
  long samples;
  boolean capStart;
  boolean capEnd;
  boolean closeProfile;
  boolean miterJoints;
  any profileScale;
  any twist;
};

dictionary MeshSpaceColonizationOptions {
  unrestricted double attractionRadius;
  unrestricted double killRadius;
  unrestricted double segmentLength;
  long maxIterations;
  unrestricted double tropismWeight;
  sequence<unrestricted double> tropism;
  any obstacles;
  unrestricted double obstacleClearance;
  unrestricted double obstacleSteer;
};

/** One segment of a branch skeleton (spaceColonize / lsystemToBranches / tree). */
dictionary MeshBranchSegment {
  /** Index of the parent segment, -1 at a root. */
  long parent;
  sequence<unrestricted double> from;
  sequence<unrestricted double> to;
  /** Radius at `from`; 0 until thickenBranches assigns the pipe model. */
  unrestricted double radius;
  long depth;
};

dictionary MeshLeafPlacementOptions {
  unrestricted double maxRadius;
  long minDepth;
  boolean terminalOnly;
  unrestricted double perUnitLength;
  unrestricted double densityFalloff;
  unrestricted double upBias;
  unrestricted double tiltJitter;
  unrestricted double rollJitter;
  unrestricted double baseScale;
  unrestricted double scaleJitter;
  unrestricted double scaleByRadius;
  unrestricted double dedupRadius;
  unrestricted double seed;
  sequence<unrestricted double> densityWeight;
  any avoid;
  unrestricted double obstacleClearance;
  unrestricted double obstaclePushout;
  sequence<object> keepOut;
};

dictionary MeshPlacedLeaves {
  long long count;
  Float32Array transforms;
  Float32Array branchRadius;
  Int32Array branchDepth;
};

dictionary MeshBlobOptions {
  unrestricted double radius;
  long seed;
  long nsub;
  any scale;
  any center;
};

dictionary MeshDracoDecodedAttribute {
  DOMString type;
  long uniqueId;
  long components;
  long count;
  DOMString kind;
  ArrayBufferView data;
};

dictionary MeshDracoDecoded {
  Float32Array positions;
  Float32Array normals;
  Float32Array uvs;
  Float32Array colors;
  Uint32Array indices;
  sequence<MeshDracoDecodedAttribute> attributes;
  Mesh mesh;
};

dictionary MeshDracoEncodeOptions {
  long positionBits;
  long normalBits;
  long uvBits;
  long colorBits;
  long genericBits;
  long compressionLevel;
  boolean sequential;
};

dictionary MeshExtrudeFaceResult {
  Uint32Array dupVerts;
  Uint32Array bridgeFaces;
  Uint32Array bridgeAdjGroup;
  long backFace;
};

dictionary MeshLSystemModule {
  DOMString symbol;
  sequence<unrestricted double> params;
};

dictionary MeshConvexDecompParams {
  long maxHulls;
  long maxVerticesPerHull;
  unrestricted double resolution;
  unrestricted double minVolumePerHull;
};

[cpp_namespace="bro::js", cpp_guard="BRO_WITH_3D", gate="BRO_WITH_3D"]
interface Mesh {
  constructor(optional MeshOptions opts);

  attribute Float32Array positions;
  attribute Float32Array normals;
  attribute Float32Array uvs;
  attribute Float32Array colors;
  attribute Uint32Array indices;

  readonly attribute long vertexCount;
  readonly attribute long triangleCount;
  readonly attribute boolean hasNormals;
  readonly attribute boolean hasUVs;
  readonly attribute boolean hasColors;
  readonly attribute boolean empty;

  Mesh clone();

  Mesh translate(unrestricted double dx, unrestricted double dy, unrestricted double dz);
  Mesh scale(unrestricted double sx, optional unrestricted double sy, optional unrestricted double sz);
  Mesh rotate(unrestricted double ax, unrestricted double ay, unrestricted double az, unrestricted double angle);
  Mesh center();
  Mesh fitToBox(unrestricted double size);
  Mesh transform(sequence<unrestricted double> matrix);
  [manual] Mesh applySkinning(SkinData skin, sequence<unrestricted double> matrices);
  Mesh applyMorphTarget(Mesh target, unrestricted double weight);
  Mesh computeNormals(optional unrestricted double creaseAngle);
  Mesh invertNormals();
  Mesh flipFaces();
  Mesh weld(optional unrestricted double threshold);
  Mesh simplify(unrestricted double ratio, optional unrestricted double targetError);
  Mesh subdivideLoop(optional long iterations);
  Mesh subdivideCatmullClark(optional long iterations);
  Mesh smooth(optional unrestricted double lambda, optional long iterations);
  Mesh remesh(optional unrestricted double targetEdgeLength);
  Mesh repair();
  Mesh repairSelfIntersections();
  Mesh shrinkwrap(Mesh target, optional unrestricted double factor, optional unrestricted double offset);
  sequence<Mesh> splitComponents();
  Mesh booleanUnion(Mesh other);
  Mesh booleanDifference(Mesh other);
  Mesh booleanIntersection(Mesh other);
  Mesh csgUnion(Mesh other);
  Mesh csgSubtract(Mesh other);
  Mesh csgIntersect(Mesh other);
  Mesh generateUVs(optional DOMString method);
  Mesh projectUVs(optional DOMString projection, optional sequence<unrestricted double> plane);
  Mesh optimize();
  MeshBVH buildBVH();
  ProgressiveMesh buildProgressiveMesh();
  MeshletGroupResult buildMeshlets(optional long maxVertices, optional long maxTriangles);
  sequence<MeshUVDistortionResult> computeUVDistortion();
  MeshUVQualityResult measureUVQuality();
  Mesh convexHull();
  sequence<Mesh> convexDecomposition(optional MeshConvexDecompParams params);
  Uint8Array toGLTF(optional DOMString name);
  DOMString toOBJ();
  DOMString toPLY();
  DOMString toSTL();
  ArrayBuffer toSTLB();
  ArrayBuffer toFBX();
  ArrayBuffer toVOX();

  static Mesh box(optional unrestricted double halfW, optional unrestricted double halfH, optional unrestricted double halfD);
  static Mesh sphere(optional unrestricted double radius, optional long segments, optional long rings);
  static Mesh cylinder(optional unrestricted double radius, optional unrestricted double halfHeight, optional long segments);
  static Mesh capsule(optional unrestricted double radius, optional unrestricted double halfHeight, optional long segments);
  static Mesh cone(optional unrestricted double radius, optional unrestricted double height, optional long segments);
  static Mesh plane(optional unrestricted double halfW, optional unrestricted double halfH, optional long segW, optional long segH);
  static Mesh torus(optional unrestricted double radius, optional unrestricted double tubeRadius, optional long segments, optional long tubeSegments);
  static Mesh icosahedron(optional unrestricted double radius);
  static Mesh dodecahedron(optional unrestricted double radius);
  static Mesh octahedron(optional unrestricted double radius);
  static Mesh tetrahedron(optional unrestricted double radius);
  static Mesh disk(optional unrestricted double radius, optional long segments);
  /**
   * Circular-cross-section sweep along `path` (Float32Array(3N) or
   * [[x,y,z], ...], at least 2 points). `radius` is a constant number or a
   * per-point list the same length as `path`; `sides` is the ring
   * resolution (>= 3, default 8).
   */
  [manual] static Mesh tube(sequence<sequence<unrestricted double>> path, optional any radius, optional long sides, optional MeshTubeOptions opts);
  static Mesh fromGLTF(ArrayBuffer buffer);
  static Mesh fromOBJ(DOMString text);
  static Mesh fromPLY(ArrayBuffer buffer);
  static Mesh fromSTL(ArrayBuffer buffer);
  static Mesh fromFBX(ArrayBuffer buffer);
  static Mesh fromVOX(ArrayBuffer buffer);
  [manual] static Mesh merge(sequence<Mesh> meshes);
  static Mesh marchingCubes(sequence<unrestricted double> values, long dimX, long dimY, long dimZ, unrestricted double isoLevel);
  static Mesh surfaceNets(sequence<unrestricted double> values, long dimX, long dimY, long dimZ, unrestricted double isoLevel);
  static Mesh dualContouring(sequence<unrestricted double> values, long dimX, long dimY, long dimZ, unrestricted double isoLevel);
  /**
   * Extrude a closed 2D `profile` (Float32Array(2N) or [[x,y], ...]) along a
   * 3D `path` (Float32Array(3N) or [[x,y,z], ...]).
   */
  [manual] static Mesh sweep(sequence<sequence<unrestricted double>> profile, sequence<sequence<unrestricted double>> path, optional MeshSweepOptions opts);
  [manual] static Mesh bezierSweep(sequence<sequence<unrestricted double>> controlPoints, sequence<sequence<unrestricted double>> profile, optional MeshBezierSweepOptions opts);
  [manual] static Mesh leafCard(any shape, optional MeshLeafCardOptions opts);
  static Mesh flower(optional MeshFlowerOptions opts);
  /** Sweep a 4-vertex diamond profile along `path`: grass / fern / succulent blades. */
  [manual] static Mesh bladeStrip(sequence<sequence<unrestricted double>> path, optional MeshBladeStripOptions opts);
  /** Quadratic-Bézier blade spine as [[x,y,z], ...], consumable by bladeStrip / sweep. */
  [manual] static sequence<sequence<unrestricted double>> bladePath(optional MeshBladePathOptions opts);
  [manual] static Mesh blob(optional MeshBlobOptions opts);
  [manual] static sequence<MeshBranchSegment> spaceColonize(sequence<sequence<unrestricted double>> attractors, sequence<sequence<unrestricted double>> seedPoints, sequence<unrestricted double> initialDirection, optional MeshSpaceColonizationOptions opts);
  static sequence<MeshBranchSegment> thickenBranches(sequence<MeshBranchSegment> segments, optional unrestricted double leafRadius, optional unrestricted double pipeExp);
  static Mesh meshBranches(sequence<MeshBranchSegment> segments, optional long sides);
  [manual] static MeshPlacedLeaves placeLeavesOnBranches(sequence<MeshBranchSegment> segments, optional MeshLeafPlacementOptions opts);
  [manual] static Mesh scatterLeaves(sequence<MeshBranchSegment> segments, Mesh leaf, optional MeshLeafPlacementOptions opts);
  /** spaceColonize → thickenBranches → meshBranches in one call. */
  [manual] static MeshTreeResult tree(optional MeshTreeOptions opts);
  static sequence<MeshLSystemModule> parseLSystem(DOMString text);
  /** Greedy spaced-anchor picker; returns the accepted candidate indices in acceptance order. */
  [manual] static Int32Array packAnchors(sequence<sequence<unrestricted double>> candidates, optional MeshAnchorPackOptions opts);
  /** Turtle-interpret a module stream (or an L-system string) into a branch skeleton. */
  [manual] static sequence<MeshBranchSegment> lsystemToBranches(sequence<MeshLSystemModule> modules, optional MeshTurtleOptions opts);
  [manual] static CapsuleField capsuleField(optional sequence<MeshCapsule> capsules, optional sequence<MeshSphere> spheres, optional unrestricted double cellSize);
  /** CapsuleField whose capsules carry the segment index as `tag`, so placement can exclude a leaf's own branch. */
  [manual] static CapsuleField capsuleFieldFromSegments(sequence<MeshBranchSegment> segments, optional unrestricted double radiusScale, optional sequence<MeshSphere> extraSpheres);
  [manual] static MeshDracoDecoded decodeDraco(ArrayBufferView bytes);
  [manual] static ArrayBuffer encodeDraco(object meshData, optional MeshDracoEncodeOptions opts);
};

interface MeshBVH {
  MeshBVHIntersectResult? raycast(sequence<unrestricted double> origin, sequence<unrestricted double> direction, optional unrestricted double maxDist);
  sequence<long> queryAABB(sequence<unrestricted double> min, sequence<unrestricted double> max);
};

interface ProgressiveMesh {
  Mesh getMesh(unrestricted double detail);
  readonly attribute long collapseCount;
  readonly attribute long minVertices;
  readonly attribute long maxVertices;
};

interface PolyMesh {
  [manual] constructor(optional Mesh mesh);
  readonly attribute long vertexCount;
  readonly attribute long faceCount;
  readonly attribute long edgeCount;
  Mesh toMesh();
  MeshExtrudeFaceResult extrudeFace(long faceIdx, sequence<unrestricted double> offset, optional boolean withBack, optional long bridgeGroup, optional long backGroup);
  void rematchTwins();
  void mergeFacesByGroup();
  void compact();
  sequence<sequence<long>> findGroupBoundary(long groupId);
};

/**
 * Capsule + sphere occupancy field: the shared obstacle substrate for
 * spaceColonize, placeLeavesOnBranches, scatterLeaves and packAnchors.
 * Queries take a point as [x,y,z] or {x,y,z}; `excludeTag` skips obstacles
 * carrying that tag (a leaf's own branch).
 */
interface CapsuleField {
  constructor(optional sequence<MeshCapsule> capsules, optional sequence<MeshSphere> spheres, optional unrestricted double cellSize);
  readonly attribute boolean empty;
  readonly attribute long capsuleCount;
  readonly attribute long sphereCount;
  readonly attribute unrestricted double cellSize;
  boolean contains(sequence<unrestricted double> point, optional long excludeTag, optional unrestricted double extraClearance);
  boolean tooClose(sequence<unrestricted double> point, unrestricted double clearance, optional long excludeTag);
  /** Signed distance to the nearest obstacle surface (negative inside). */
  unrestricted double distance(sequence<unrestricted double> point, optional long excludeTag);
  MeshCapsuleFieldNearest? nearest(sequence<unrestricted double> point, optional long excludeTag);
  boolean intersectsSphere(sequence<unrestricted double> center, unrestricted double radius, optional long excludeTag);
};

interface LSystem {
  constructor(optional DOMString axiom);
  LSystem setAxiom(DOMString text);
  LSystem addRule(DOMString predecessor, DOMString successor, optional unrestricted double weight);
  DOMString derive(long iterations, optional long long seed);
  sequence<MeshLSystemModule> deriveModules(long iterations, optional long long seed);
};
