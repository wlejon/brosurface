/**
 * =============================================================================
 * bro.diffusion — text-to-image neural diffusion inference pipeline
 * =============================================================================
 */

interface Pipeline {};

interface PipelineState {};

[cpp_namespace="bro::js", cpp_guard="BRO_WITH_DIFFUSION", prefix="bro."]
namespace diffusion {
  readonly attribute DOMString version;
  void init();
  [manual] Pipeline createPipeline(object config);
  [manual] Pipeline loadModel(DOMString dir, optional object opts);
  [manual] Float32Array expandNoise(Float32Array src, object opts);
};
