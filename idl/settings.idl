/**
 * =============================================================================
 * bro.settings — persistent layered settings & action binding system
 * =============================================================================
 *
 * Persistent, layered settings system for graphics, audio, input, and appearance
 * configuration. The engine provides sensible defaults; apps can override them;
 * users can override those. User settings persist across sessions.
 *
 * Categories:
 *   - graphics: width, height, fullscreen, vsync, resizable, maxFrameIntervalMs, maxFps
 *   - audio: masterVolume, musicVolume, sfxVolume, muted
 *   - input: scrollSpeed, doubleClickThresholdMs, doubleClickDistancePx, overlayToggleKey
 *   - appearance: colorScheme ("system" | "light" | "dark")
 *
 * @example
 *   // Read and write settings
 *   const vol = bro.settings.get("audio.masterVolume");
 *   bro.settings.set("audio.masterVolume", 0.8);
 *   bro.settings.setDefault("graphics.width", 1280);
 *
 * @example
 *   // Action bindings
 *   bro.settings.defineAction("jump", [" ", "ArrowUp"]);
 *   const keys = bro.settings.getActionKeys("jump");
 *   bro.settings.rebindAction("jump", [" ", "w"]);
 *
 * @example
 *   // Display modes
 *   const modes = bro.settings.getDisplayModes();
 *   for (const m of modes) {
 *     console.log(m.width + "x" + m.height + " @" + m.refreshRate + "Hz");
 *   }
 */

/**
 * Options for action binding definitions.
 */
dictionary ActionOptions {
  /** Deadzone threshold for analog axis bindings (default ~0.1). */
  unrestricted double deadzone;
};

/**
 * Information describing a registered action and its key bindings.
 */
dictionary ActionBindingInfo {
  /** Action name identifier. */
  DOMString action;

  /** Sequence of bound key and input strings. */
  sequence<DOMString> keys;
};

/**
 * Display video mode describing available fullscreen resolution and refresh rate.
 */
dictionary DisplayModeInfo {
  /** Horizontal width in pixels. */
  long width;

  /** Vertical height in pixels. */
  long height;

  /** Vertical refresh rate in Hz. */
  unrestricted double refreshRate;
};

/**
 * Persistent layered settings and action binding management namespace.
 */
[
  cpp_file="settings_bindings.cpp",
  cpp_header="js/settings_bindings.h",
  cpp_includes="\"engine/engine.h\"\n\"engine/settings.h\"\n\"platform/sdl_window.h\"\n\"util/log.h\"\n<string>\n<vector>",
  cpp_namespace="bro::js",
  cpp_install="SettingsBindings::install",
  install_signature="void SettingsBindings::install(JSContext* ctx, engine::Settings* settings, platform::Window* window, engine::Engine* engine)",
  prefix="bro.",
  layered_store
]
namespace settings {
  /**
   * Get a single typed setting value (boolean, number, or string).
   *
   * @param key Setting key (e.g. 'graphics.vsync', 'audio.masterVolume')
   * @returns Typed setting value or undefined
   */
  any get(DOMString key);

  /**
   * Get all settings as a nested object or for a specific category.
   *
   * @param category Optional category name ('graphics', 'audio', 'input', 'appearance')
   * @returns Settings dictionary object
   */
  object getAll(optional DOMString category);

  /**
   * Set a user-level setting override (persisted across sessions).
   *
   * @param key Setting key
   * @param value New setting value
   */
  void set(DOMString key, any value);

  /**
   * Set an app-level default setting value (not persisted).
   *
   * @param key Setting key
   * @param value Default setting value
   */
  void setDefault(DOMString key, any value);

  /**
   * Reset user overrides for a category or for all settings to defaults.
   *
   * @param category Optional category name to reset
   */
  void reset(optional DOMString category);

  /**
   * Define an action with default input bindings (app-level).
   *
   * @param name Action name identifier
   * @param keys Sequence of key and input binding strings
   * @param options Optional binding options such as axis deadzone
   */
  void defineAction(DOMString name, sequence<DOMString> keys, optional ActionOptions options);

  /**
   * Rebind an action at the user level (persisted across sessions).
   *
   * @param name Action name identifier
   * @param keys New sequence of key and input binding strings
   */
  void rebindAction(DOMString name, sequence<DOMString> keys);

  /**
   * Reset user-level rebind for a single action to its default bindings.
   *
   * @param name Action name identifier
   */
  void resetAction(DOMString name);

  /**
   * Reset all user-level action rebinds to default bindings.
   */
  void resetAllActions();

  /**
   * Get current active key bindings for an action.
   *
   * @param name Action name identifier
   * @returns Array of bound input strings
   */
  sequence<DOMString> getActionKeys(DOMString name);

  /**
   * Reverse lookup the action bound to a given input key or button.
   *
   * @param key Input key string
   * @returns Bound action name or null
   */
  DOMString? getKeyAction(DOMString key);

  /**
   * Polled analog strength of an action in range [0, 1].
   *
   * @param name Action name identifier
   * @returns Action analog strength
   */
  unrestricted double getActionStrength(DOMString name);

  /**
   * Polled boolean press state of an action.
   *
   * @param name Action name identifier
   * @returns Whether the action is currently pressed
   */
  boolean isActionPressed(DOMString name);

  /**
   * Get all defined actions (engine and app level).
   *
   * @returns Sequence of action descriptors
   */
  sequence<ActionBindingInfo> getActions();

  /**
   * Get actions declared specifically by the current app.
   *
   * @returns Sequence of app action descriptors
   */
  sequence<ActionBindingInfo> getAppActions();

  /**
   * Enumerate supported fullscreen video display modes and refresh rates.
   *
   * @returns Array of available display modes
   */
  sequence<DisplayModeInfo> getDisplayModes();

  /**
   * Get app and engine default settings ignoring user overrides.
   *
   * @param category Optional category filter
   * @returns Default settings object
   */
  object getDefaults(optional DOMString category);
};
