/**
 * =============================================================================
 * bro.settings — Engine & Display Settings Management
 * =============================================================================
 */

[cpp_namespace="bro::js", prefix="bro."]
namespace settings {
  DOMString get(DOMString key);
  DOMString getAllJson(DOMString category);
  DOMString getDefaultsJson(DOMString category);
  void setString(DOMString key, DOMString value);
  void setNumber(DOMString key, double value);
  void setBool(DOMString key, boolean value);
  void setDefaultString(DOMString key, DOMString value);
  void setDefaultNumber(DOMString key, double value);
  void setDefaultBool(DOMString key, boolean value);
  void reset(DOMString category);
  void defineAction(DOMString action, DOMString keysJoined, double deadzone);
  void rebindAction(DOMString action, DOMString keysJoined);
  void resetAction(DOMString action);
  void resetAllActions();
  DOMString actionKeysJson(DOMString action);
  DOMString keyAction(DOMString key);
  double actionStrength(DOMString action);
  boolean isActionPressed(DOMString action);
  DOMString actionsJson();
  DOMString appActionsJson();
  DOMString displayModesJson();
  void onChange(Function listener);
};
