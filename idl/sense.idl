// idl/sense.idl - WebIDL definition for bro.sense (tier-0 acoustic sensor bus)

/**
 * @file sense.idl
 * @description Real-time tier-0 acoustic sensing (VAD, pitch, onset, tonality, centroid).
 * Dual-homed on bro.sense (default mic) and stream.sense (bro.listen.open handle).
 */

dictionary SenseStartOptions {
  double vadFloorDb = -55.0;
  double vadSnrDb = 8.0;
  double vadRiseDbps = 6.0;
  long vadHangFrames = 25;
  double onsetRatio = 2.5;
  double onsetAbs = 0.05;
  double onsetEma = 0.05;
  long onsetRefractoryFrames = 5;
  double tonalMinPeriodicity = 0.6;
  double tonalFminHz = 80.0;
  double tonalFmaxHz = 4000.0;
};

dictionary SenseSnapshot {
  long long frames;
  double t;
  double rms;
  double peak;
  double db;
  boolean voice;
  double noiseFloorDb;
  double snrDb;
  long long voiceFrames;
  long long voiceEvents;
  long long lastVoiceFrame;
  double flux;
  boolean onset;
  long long onsets;
  long long lastOnsetFrame;
  double periodicity;
  double dominantHz;
  boolean tonal;
  long long tonalFrames;
  long long tonalEvents;
  long long lastTonalFrame;
  double centroid;
};

dictionary SenseStats {
  long long framesDelivered;
  long long samplesDelivered;
  double rollingPeak;
};

dictionary SenseAnalysis {
  long long frames;
  long long hop;
  long long win;
  long long rate;
  double frameMs;
  Float32Array db;
  Float32Array dominantHz;
  Float32Array periodicity;
  Float32Array centroid;
  Int32Array flags;
};

interface SenseStreamView {
  readonly attribute boolean active;

  void start(optional SenseStartOptions opts);
  void stop();
  boolean isActive();
  SenseSnapshot? snapshot();
  long sampleRate();
  SenseStats? stats();
  SenseSnapshot? feed(Float32Array samples);
  SenseAnalysis? analyze(Float32Array samples, optional SenseStartOptions opts);
};

[cpp_namespace="bro::js", gate="BRO_WITH_SOUNDML", prefix="bro."]
namespace sense {
  void init();
  void start(optional SenseStartOptions opts);
  void stop();
  boolean isActive();
  SenseSnapshot? snapshot();
  long sampleRate();
  SenseStats? stats();
  SenseSnapshot? feed(Float32Array samples);
  SenseAnalysis? analyze(Float32Array samples, optional SenseStartOptions opts);
};
