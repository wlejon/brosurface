/**
 * =============================================================================
 * bro.vision — Vision-model inference (brovisionml)
 * =============================================================================
 *
 * Image-understanding and dense prediction models: promptable segmentation (SAM),
 * monocular depth (Depth-Anything-V2), surface normals (DSINE), ControlNet annotators
 * (HED, Lineart, MLSD, OpenPose, SegFormer, BiRefNet, StyleGAN3, DINOv2, DINOv3).
 *
 * @example
 *   bro.vision.init();
 *   const depth = bro.vision.loadDepth('weights/depth-anything-v2-small');
 *   const result = depth.estimate(imageBitmap);
 */

interface DepthEstimator {
  readonly attribute DOMString device;
  [manual] object estimate(any image, optional object opts);
};

interface Sam {
  readonly attribute DOMString device;
  readonly attribute boolean hasImage;
  [manual] any setImage(any image, optional object opts);
  [manual] object segment(optional object opts);
  [manual] any segmentEverything(any image, optional object opts);
};

interface NormalEstimator {
  readonly attribute DOMString device;
  [manual] object estimate(any image, optional object opts);
};

interface Hed {
  readonly attribute DOMString device;
  [manual] object estimate(any image, optional object opts);
};

interface Lineart {
  readonly attribute DOMString device;
  [manual] object estimate(any image, optional object opts);
};

interface Mlsd {
  readonly attribute DOMString device;
  [manual] object estimate(any image, optional object opts);
};

interface Openpose {
  readonly attribute DOMString device;
  [manual] object estimate(any image, optional object opts);
};

interface Segformer {
  readonly attribute DOMString device;
  [manual] object estimate(any image, optional object opts);
};

interface Birefnet {
  readonly attribute DOMString device;
  [manual] object estimate(any image, optional object opts);
};

interface StyleGAN3 {
  readonly attribute DOMString device;
  readonly attribute long zDim;
  readonly attribute long cDim;
  readonly attribute long wDim;
  readonly attribute long imgResolution;
  readonly attribute long imgChannels;
  [manual] object generate(Float32Array z, optional object opts);
};

interface Dinov2 {
  readonly attribute DOMString device;
  [manual] object estimate(any image, optional object opts);
};

interface Dinov3 {
  readonly attribute DOMString device;
  [manual] object estimate(any image, optional object opts);
};

[cpp_namespace="bro::js", cpp_guard="BRO_WITH_VISION", prefix="bro."]
namespace vision {
  void init();
  [manual] any loadDepth(DOMString modelDir, optional object opts);
  [manual] any loadSam(DOMString modelDir, optional object opts);
  [manual] any loadNormal(DOMString modelDir, optional object opts);
  [manual] any loadHed(DOMString modelDir, optional object opts);
  [manual] any loadLineart(DOMString modelDir, optional object opts);
  [manual] any loadMlsd(DOMString modelDir, optional object opts);
  [manual] any loadOpenpose(DOMString modelDir, optional object opts);
  [manual] any loadSegformer(DOMString modelDir, optional object opts);
  [manual] any loadBirefnet(DOMString modelDir, optional object opts);
  [manual] any loadStyleGAN3(DOMString modelDir, optional object opts);
  [manual] any loadDinov2(DOMString modelDir, optional object opts);
  [manual] any loadDinov3(DOMString modelDir, optional object opts);
};
