/**
 * =============================================================================
 * bro.ai.game — Game AI, Navigation Grids/Meshes, ORCA Avoidance, and MCTS
 * =============================================================================
 *
 * Real-time game AI simulation system providing agents, spatial worlds,
 * navigation grids, navmesh pathfinding, local collision avoidance (ORCA),
 * tactical steering behaviors, and Monte Carlo Tree Search (MCTS).
 *
 * @example
 *   const world = bro.ai.game.createWorld();
 *   const agent = bro.ai.game.createAgent(world, { radius: 0.5, maxSpeed: 5.0 });
 *   agent.setPosition(0, 0, 0);
 *   world.step(1 / 60);
 */

interface AIAgent {
  readonly attribute long id;
  void setPosition(double x, double y, double z);
  void setVelocity(double x, double y, double z);
  void setGoal(double x, double y, double z);
  void stop();
};

interface AIWorld {
  void step(double dt);
  AIAgent createAgent(optional object opts);
  void destroyAgent(AIAgent agent);
};

interface AINavGrid {
  boolean isWalkable(double x, double z);
  void setWalkable(double x, double z, boolean walkable);
  sequence<object> findPath(double startX, double startZ, double endX, double endZ);
};

interface AINavMesh {
  sequence<object> findPath(double startX, double startY, double startZ, double endX, double endY, double endZ);
};

interface AIMcts {
  object search(object state, optional object opts);
};

interface CombatAction {
  attribute double targetX;
  attribute double targetZ;
  attribute long actionType;
};

interface Formation {
  void setLeader(AIAgent agent);
  void addFollower(AIAgent agent, double offsetX, double offsetZ);
  void update(double dt);
};

interface VecSim {
  void step(double dt);
};

[cpp_namespace="bro::js", cpp_guard="BRO_WITH_GAMEAI", prefix="bro.ai.game."]
namespace game {
  AIAgent createAgent(AIWorld world, optional object opts);
  AIWorld createWorld(optional object opts);
  AINavGrid createNavGrid(double minX, double minZ, double maxX, double maxZ, double cellSize);
  AINavMesh createNavMesh(optional object opts);
  AIMcts createMcts(object config);
  CombatAction createCombatAction();
  Formation createFormation(optional object opts);
  VecSim createVecSim(optional object opts);
  void registerCapability(DOMString name, object definition);
};
