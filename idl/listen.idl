// idl/listen.idl - WebIDL definition for bro.listen (listen host & stream pipelines)

/**
 * @file listen.idl
 * @description Core audio streaming pipelines and listen host retention.
 */

dictionary ListenSourceOptions {
  boolean mic;
  boolean system;
  unsigned long process;
  unsigned long pid;
  boolean exclude;
  long channel;
};

typedef (DOMString or ListenSourceOptions) ListenSource;

dictionary ListenRetentionInfo {
  boolean active;
  long seconds;
  long rate;
  long hop;
  double frameRate;
  long long streamFrame;
  long long heldFrames;
  double heldSeconds;
};

dictionary AudioApp {
  unsigned long pid;
  DOMString name;
};

interface ListenStream {
  readonly attribute unsigned long id;
  readonly attribute DOMString kind;
  readonly attribute boolean valid;

  readonly attribute WakeStreamView wake;
  readonly attribute KwsStreamView kws;
  readonly attribute SenseStreamView sense;
  readonly attribute GestureStreamView gesture;

  void retain(optional long seconds = 0);
  [manual] Float32Array? audio(long long startFrame, long long endFrame);
  long long frame();
  ListenRetentionInfo info();
  void feed(Float32Array samples);
  void close();
};

[cpp_namespace="bro::js", gate="BRO_WITH_SOUNDML", prefix="bro."]
namespace listen {
  [manual] ListenStream open(optional ListenSource source);
  boolean supported();
  sequence<AudioApp> apps();
  void retain(optional long seconds = 0);
  [manual] Float32Array? audio(long long startFrame, long long endFrame);
  long long frame();
  ListenRetentionInfo info();
};
