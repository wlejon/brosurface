/**
 * =============================================================================
 * bro Clipmap Terrain API Reference
 * =============================================================================
 *
 * A camera-centred GEOMETRY CLIPMAP: concentric square rings of fixed topology,
 * built once, parked on the camera, displaced on the GPU from a streamed height
 * pyramid. This is the "continuous world from underfoot to the horizon" case.
 */

dictionary ClipmapMaterialComponent {
  sequence<unrestricted double> albedo;
  unrestricted double roughness;
};

dictionary ClipmapMaterialsOptions {
  ClipmapMaterialComponent rock;
  ClipmapMaterialComponent snow;
  ClipmapMaterialComponent sand;
  ClipmapMaterialComponent grass;
};

dictionary ClipmapForestOptions {
  sequence<unrestricted double> albedo;
  unrestricted double strength;
};

dictionary ClipmapDetailOptions {
  unrestricted double wavelength;
  unrestricted double relief;
  unrestricted double gain;
  long octaves;
};

dictionary ClipmapHeightLayerOptions {
  Float32Array data;
  long width;
  long height;
  unrestricted double originX;
  unrestricted double originZ;
  unrestricted double metresPerCell;
  boolean wrapX;
  boolean bandLimited;
};

dictionary ClipmapSurfaceLayerOptions {
  Float32Array data;
  long width;
  long height;
  unrestricted double originX;
  unrestricted double originZ;
  unrestricted double metresPerCell;
  long components;
};

dictionary ClipmapTerrainConfig {
  long levels;
  long resolution;
  unrestricted double cellSize;
  unrestricted double heightScale;
  unrestricted double seaLevel;
  unrestricted double snowLine;
  unrestricted double maxCellScale;
  unrestricted double planetRadius;
  boolean layerFade;
  boolean coverageFloor;
  boolean cubicSurface;
  boolean cubicHeight;
  unrestricted double detailWavelength;
  unrestricted double detailRelief;
  unrestricted double detailGain;
  long detailOctaves;
};

[cpp_namespace="bro::js", cpp_guard="BRO_WITH_3D", gate="BRO_WITH_3D"]
interface ClipmapTerrain {
  readonly attribute SceneNode? node;
  readonly attribute long levels;
  readonly attribute long resolution;
  readonly attribute unrestricted double cellSize;
  readonly attribute long layerCount;
  readonly attribute long triangleCount;
  readonly attribute long vertexCount;
  readonly attribute unrestricted double farDistance;
  readonly attribute unrestricted double cellScale;
  readonly attribute unrestricted double planetRadius;

  [manual] ClipmapTerrain setHeightLayer(long index, ClipmapHeightLayerOptions? desc);
  ClipmapTerrain setSnowLine(unrestricted double m);
  [manual] ClipmapTerrain setChartCenter(unrestricted double? x, optional unrestricted double z);
  ClipmapTerrain setDetail(ClipmapDetailOptions desc);
  ClipmapTerrain setMaterials(ClipmapMaterialsOptions desc);
  ClipmapTerrain setForest(ClipmapForestOptions desc);
  [manual] ClipmapTerrain setSurfaceLayer(any indexOrDesc, optional ClipmapSurfaceLayerOptions? desc);
  ClipmapTerrain update(unrestricted double camX, unrestricted double camY, unrestricted double camZ);
  DOMString shaderSource(DOMString stage);
  unrestricted double elevationAt(unrestricted double x, unrestricted double z);
  unrestricted double renderedElevationAt(unrestricted double x, unrestricted double z);
  unrestricted double coverageDistance(unrestricted double eyeAboveSeaLevel);
  unrestricted double horizonDistance(unrestricted double eyeAboveSeaLevel);
  void destroy();
};
