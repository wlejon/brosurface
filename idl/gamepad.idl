/**
 * =============================================================================
 * Gamepad API — W3C Controller Input and Dual-Motor Rumble Haptics
 * =============================================================================
 *
 * Implements the W3C Gamepad API for polling game controller hardware,
 * button/axis states, standard mappings, and dual-rumble / trigger-rumble haptic actuators.
 *
 * @example
 *   // Polling gamepad in input loop
 *   const gp = navigator.getGamepads()[0];
 *   if (gp) {
 *     const moveX = gp.axes[0];
 *     const jump = gp.buttons[0].pressed;
 *     const boost = gp.buttons[7].value;
 *     console.log("Gamepad:", gp.id, "jump:", jump, "moveX:", moveX, "boost:", boost);
 *   }
 *
 * @example
 *   // Playing rumble haptic effect
 *   const gp = navigator.getGamepads()[0];
 *   if (gp && gp.vibrationActuator) {
 *     gp.vibrationActuator.playEffect("dual-rumble", {
 *       duration: 200,
 *       strongMagnitude: 1.0,
 *       weakMagnitude: 0.4
 *     });
 *   }
 *
 * @example
 *   // Trigger-rumble haptic effect
 *   const gp = navigator.getGamepads()[0];
 *   if (gp && gp.vibrationActuator) {
 *     gp.vibrationActuator.playEffect("trigger-rumble", {
 *       duration: 120,
 *       strongMagnitude: 0.2,
 *       weakMagnitude: 0.2,
 *       leftTrigger: 0.0,
 *       rightTrigger: 1.0
 *     });
 *   }
 */

/**
 * Parameters for playing vibration haptic effects on a Gamepad.
 */
dictionary GamepadEffectParameters {
  /** Duration of effect in milliseconds */
  double duration = 0.0;
  /** Strong motor magnitude [0.0 - 1.0] */
  double strongMagnitude = 0.0;
  /** Weak motor magnitude [0.0 - 1.0] */
  double weakMagnitude = 0.0;
  /** Left trigger motor magnitude [0.0 - 1.0] (trigger-rumble only) */
  double leftTrigger = 0.0;
  /** Right trigger motor magnitude [0.0 - 1.0] (trigger-rumble only) */
  double rightTrigger = 0.0;
};

/**
 * Represents a hardware vibration actuator attached to a Gamepad.
 */
interface GamepadHapticActuator {
  /** Type of actuator (e.g. "dual-rumble") */
  readonly attribute DOMString type;
  /** Supported effect types (e.g. ["dual-rumble", "trigger-rumble"]) */
  readonly attribute sequence<DOMString> effects;

  /**
   * Plays a haptic effect on the gamepad motors.
   * @param type Effect type ("dual-rumble" or "trigger-rumble")
   * @param params Vibration parameters
   * @returns Promise resolving to "complete" or "preempted"
   */
  Promise<DOMString> playEffect(DOMString type, optional GamepadEffectParameters params);

  /**
   * Resets and stops any active vibration effect.
   * @returns Promise resolving to "complete"
   */
  Promise<DOMString> reset();
};

/**
 * An individual button on a Gamepad device.
 */
interface GamepadButton {
  /** Whether the button is currently pressed past activation threshold */
  readonly attribute boolean pressed;
  /** Whether the button is touched or analog value > 0 */
  readonly attribute boolean touched;
  /** Current analog displacement value [0.0 - 1.0] */
  readonly attribute double value;
};

/**
 * Represents a gamepad/controller connected to the system.
 */
[cpp_namespace="bro::js"]
interface Gamepad {
  /** Identifier string of the gamepad device */
  readonly attribute DOMString id;
  /** Unique zero-based slot index */
  readonly attribute long index;
  /** Whether the gamepad is connected */
  readonly attribute boolean connected;
  /** Layout mapping ("standard") */
  readonly attribute DOMString mapping;
  /** 17 button snapshot states */
  readonly attribute sequence<GamepadButton> buttons;
  /** 4 stick axis values [-1.0 - 1.0] */
  readonly attribute sequence<double> axes;
  /** Timestamp in ms when the state changed */
  readonly attribute double timestamp;
  /** Vibration haptic actuator handle */
  readonly attribute GamepadHapticActuator vibrationActuator;
};

/**
 * Event fired when a Gamepad is connected or disconnected.
 */
interface GamepadEvent {
  /** The gamepad snapshot associated with this event */
  readonly attribute Gamepad gamepad;
};

/**
 * Direct native gamepad querying and haptic actuation namespace.
 */
namespace gamepad {
  /** Checks if a gamepad is connected at the specified slot index. */
  boolean isConnected(long index);
  /** Queries an axis value [-1.0 to 1.0] for the specified gamepad and axis index. */
  double getAxis(long index, long axis);
  /** Queries a button value [0.0 to 1.0] for the specified gamepad and button index. */
  double getButton(long index, long button);
  /** Actuates dual-motor rumble haptics. */
  boolean rumble(long index, float strong, float weak, long duration);
  /** Actuates trigger rumble haptics. */
  boolean rumbleTriggers(long index, float left, float right, long duration);
};
