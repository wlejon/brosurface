  void conv2dBackwardBias(GpuTensor dY, long N, long C_out, long H_out, long W_out, GpuTensor dB);

  void upsampleNearest2xForward(GpuTensor X, long N, long C, long H, long W, GpuTensor Y);
  void upsampleNearest2xBackward(GpuTensor dY, long N, long C, long H, long W, GpuTensor dX);
  void upsampleBilinear2xForward(GpuTensor X, long N, long C, long H, long W, GpuTensor Y);
  void upsampleBilinear2xBackward(GpuTensor dY, long N, long C, long H, long W, GpuTensor dX);
