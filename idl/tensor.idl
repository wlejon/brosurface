  void resblockForward(object opts);
  void resblockBackward(object opts);

  void maskedMeanPoolForward(GpuTensor X, GpuTensor? mask, GpuTensor y);
  void maskedMeanPoolBackward(GpuTensor dY, GpuTensor? mask, long K, GpuTensor dX);
  double mseVecForward(GpuTensor pred, GpuTensor target);
  void mseVecBackward(GpuTensor pred, GpuTensor target, GpuTensor dPred);
  void mseVecPerSample(GpuTensor pred, GpuTensor target, GpuTensor dPred, GpuTensor lossPerSample);
  double softmaxXentFused(GpuTensor logits, GpuTensor target, GpuTensor? mask, GpuTensor probs, GpuTensor dLogits);
