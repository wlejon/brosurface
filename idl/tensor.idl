  void downsampleAvg2xBackward(GpuTensor dY, long N, long C, long H, long W, GpuTensor dX);

  void nchwToSequence(GpuTensor X, long N, long C, long H, long W, GpuTensor Y);
  void sequenceToNchw(GpuTensor X, long N, long C, long H, long W, GpuTensor Y);

  void interp2dForward(GpuTensor X, long N, long C, long H_in, long W_in, long H_out, long W_out, long mode, GpuTensor Y);
  void interp2dAlignCornersForward(GpuTensor X, long N, long C, long H_in, long W_in, long H_out, long W_out, long mode, GpuTensor Y);
  void unfold2dForward(GpuTensor X, long N, long C, long H, long W, long kH, long kW, long sH, long sW, long padT, long padB, long padL, long padR, long mode, GpuTensor Y);
