/**
 * =============================================================================
 * bro.tensor — GPU tensor + ops (brotensor: CUDA or Metal)
 * =============================================================================
 *
 * Wraps the brotensor sibling library. brotensor exposes one unified tensor
 * type with a runtime Device tag and device-neutral ops; bro.tensor is the
 * GPU-resident face of it. The op surface is identical across CUDA (NVIDIA)
 * and Metal (Apple) backends.
 *
 * @example
 *   if (bro.tensor.available) {
 *     bro.tensor.init();
 *     const t = bro.tensor.createTensor(3, 4);
 *     t.zero();
 *     const data = t.download();
 *   }
 */

interface GpuTensor {
  readonly attribute long rows;
  readonly attribute long cols;
  readonly attribute long size;
  readonly attribute long bytes;

  void zero();
  [manual] void resize(long rows, long cols, optional (DOMString or long) dtype);
  DOMString dtype();
  GpuTensor clone();
  [manual] void upload((Float32Array or object) src);
  [manual] (Float32Array or void) download(optional object dst);
  void uploadFp16(Uint16Array data);
  Uint16Array downloadFp16();
  void uploadInt8(Int8Array data);
};

[cpp_namespace="bro::js", cpp_guard="BRO_WITH_TENSOR", prefix="bro."]
namespace tensor {
  readonly attribute boolean available;
  readonly attribute DOMString backend;

  void init();
  void sync();
  [manual] GpuTensor createTensor(long rows, optional long cols = 1, optional (DOMString or long) dtype = "fp32");

  void linearForward(GpuTensor W, GpuTensor b, GpuTensor x, GpuTensor y);
  void linearBackward(GpuTensor W, GpuTensor x, GpuTensor dY, GpuTensor dX, GpuTensor dW, GpuTensor dB);
  void reluForward(GpuTensor x, GpuTensor y);
  void reluBackward(GpuTensor x, GpuTensor dY, GpuTensor dX);
  void tanhForward(GpuTensor x, GpuTensor y);
  void tanhBackward(GpuTensor y, GpuTensor dY, GpuTensor dX);
  void sigmoidForward(GpuTensor x, GpuTensor y);
  void sigmoidBackward(GpuTensor y, GpuTensor dY, GpuTensor dX);

  void addInplace(GpuTensor y, GpuTensor x);
  void addScalarInplace(GpuTensor y, double s);
  void scaleInplace(GpuTensor y, double s);
  void mulInplace(GpuTensor y, GpuTensor x);
  void clamp(GpuTensor y, double lo, double hi);
  void buildSlotMask(GpuTensor x, long offset, long K, long stride, GpuTensor mask);
  void copyD2D(GpuTensor src, long srcOff, GpuTensor dst, long dstOff, long n);
  [manual] void cast(GpuTensor src, GpuTensor dst, (DOMString or long) outDtype);

  void siluForward(GpuTensor x, GpuTensor y);
  void siluBackward(GpuTensor x, GpuTensor dY, GpuTensor dX);
  void geluForward(GpuTensor x, GpuTensor y);
  void geluBackward(GpuTensor x, GpuTensor dY, GpuTensor dX);
  void geluExactForward(GpuTensor x, GpuTensor y);
  void geluExactBackward(GpuTensor x, GpuTensor dY, GpuTensor dX);
  void quickGeluForward(GpuTensor x, GpuTensor y);
  void quickGeluBackward(GpuTensor x, GpuTensor dY, GpuTensor dX);

  void swigluForward(GpuTensor X, GpuTensor Y);
  void swigluBackward(GpuTensor X, GpuTensor dY, GpuTensor dX);
  void gegluForward(GpuTensor X, GpuTensor Y);
  void gegluBackward(GpuTensor X, GpuTensor dY, GpuTensor dX);
  void gegluExactForward(GpuTensor X, GpuTensor Y);
  void gegluExactBackward(GpuTensor X, GpuTensor dY, GpuTensor dX);

  [manual] void softmaxForward(GpuTensor logits, GpuTensor probs, optional GpuTensor? mask);
  void softmaxBackward(GpuTensor probs, GpuTensor dProbs, GpuTensor dLogits);

  [manual] object layernormForward(GpuTensor x, GpuTensor gamma, GpuTensor beta, GpuTensor y, GpuTensor xhat, optional double eps = 1e-5);
  void layernormBackward(GpuTensor dY, GpuTensor xhat, GpuTensor gamma, double rstd, GpuTensor dX, GpuTensor dGamma, GpuTensor dBeta);
  void layernormForwardInferenceBatched(GpuTensor X_RD, GpuTensor gamma, GpuTensor beta, GpuTensor Y_RD, optional double eps = 1e-5);
  void layernormForwardInferenceBatchedFp16(GpuTensor X_RD, GpuTensor gamma, GpuTensor beta, GpuTensor Y_RD, optional double eps = 1e-5);

  void rmsNormForward(GpuTensor X, GpuTensor gamma, double eps, GpuTensor Y);
  void rmsNormBackward(GpuTensor X, GpuTensor gamma, GpuTensor dY, double eps, GpuTensor dX, GpuTensor dGamma);

  void groupNormForward(GpuTensor X, GpuTensor gamma, GpuTensor beta, long N, long C, long H, long W, long numGroups, double eps, GpuTensor Y);
  void groupNormBackward(GpuTensor X, GpuTensor gamma, GpuTensor dY, long N, long C, long H, long W, long numGroups, double eps, GpuTensor dX, GpuTensor dGamma, GpuTensor dBeta);

  void matmul(GpuTensor A, GpuTensor B, GpuTensor C);
  void matmulBackward(GpuTensor A, GpuTensor B, GpuTensor dC, GpuTensor dA, GpuTensor dB);

  void ropeForward(GpuTensor X, long headDim, long numHeads, long seqOffset, double thetaBase, GpuTensor Y);
  void ropeBackward(GpuTensor dY, long headDim, long numHeads, long seqOffset, double thetaBase, GpuTensor dX);
  void ropeApply(GpuTensor X, GpuTensor cosTbl, GpuTensor sinTbl, long headDim, long numHeads, GpuTensor Y);
  void ropeApplyBackward(GpuTensor dY, long headDim, long numHeads, GpuTensor dX);

  void modulate(GpuTensor X, GpuTensor scale, GpuTensor shift, GpuTensor Y);
  void broadcastMul(GpuTensor X, GpuTensor v, GpuTensor Y);

  void sumRows(GpuTensor X, GpuTensor Y);
  void sumCols(GpuTensor X, GpuTensor Y);
  void argmaxRows(GpuTensor X, GpuTensor Idx);

  [manual] void attentionForward(GpuTensor X, GpuTensor Wq, GpuTensor Wk, GpuTensor Wv, GpuTensor Wo, GpuTensor? mask, GpuTensor Q, GpuTensor K, GpuTensor V, GpuTensor Attn, GpuTensor Y_pre_Wo, GpuTensor O);
  [manual] void attentionBackward(GpuTensor dO, GpuTensor X, GpuTensor Q, GpuTensor K, GpuTensor V, GpuTensor Attn, GpuTensor Y_pre_Wo, GpuTensor Wq, GpuTensor Wk, GpuTensor Wv, GpuTensor Wo, GpuTensor? mask, GpuTensor dX, GpuTensor dWq, GpuTensor dWk, GpuTensor dWv, GpuTensor dWo);
  [manual] void mhaForward(GpuTensor X, GpuTensor Wq, GpuTensor Wk, GpuTensor Wv, GpuTensor Wo, GpuTensor? mask, long numHeads, GpuTensor Qh, GpuTensor Kh, GpuTensor Vh, GpuTensor Attnh, GpuTensor Yconcat, GpuTensor O);
  [manual] void mhaBackward(GpuTensor dO, GpuTensor X, GpuTensor Qh, GpuTensor Kh, GpuTensor Vh, GpuTensor Attnh, GpuTensor Yconcat, GpuTensor Wq, GpuTensor Wk, GpuTensor Wv, GpuTensor Wo, GpuTensor? mask, long numHeads, GpuTensor dX, GpuTensor dWq, GpuTensor dWk, GpuTensor dWv, GpuTensor dWo);

  [manual] void selfAttentionForward(GpuTensor X, GpuTensor Wq, GpuTensor Wk, GpuTensor Wv, GpuTensor Wo, GpuTensor? mask, long numHeads, GpuTensor O);
  [manual] void selfAttentionForwardTrain(GpuTensor X, GpuTensor Wq, GpuTensor Wk, GpuTensor Wv, GpuTensor Wo, GpuTensor? mask, long numHeads, GpuTensor Qh, GpuTensor Kh, GpuTensor Vh, GpuTensor Attnh, GpuTensor Yconcat, GpuTensor O);
  [manual] void selfAttentionBackward(GpuTensor dO, GpuTensor X, GpuTensor Qh, GpuTensor Kh, GpuTensor Vh, GpuTensor Attnh, GpuTensor Yconcat, GpuTensor Wq, GpuTensor Wk, GpuTensor Wv, GpuTensor Wo, GpuTensor? mask, long numHeads, GpuTensor dX, GpuTensor dWq, GpuTensor dWk, GpuTensor dWv, GpuTensor dWo);

  [manual] void crossAttentionForward(GpuTensor X, GpuTensor Ctx, GpuTensor Wq, GpuTensor Wk, GpuTensor Wv, GpuTensor Wo, GpuTensor? mask, long numHeads, GpuTensor O);
  [manual] void crossAttentionForwardWithAttn(GpuTensor X, GpuTensor Ctx, GpuTensor Wq, GpuTensor Wk, GpuTensor Wv, GpuTensor Wo, GpuTensor? mask, GpuTensor? attnLogitBias, long numHeads, GpuTensor O, GpuTensor AttnAvg);
  [manual] void crossAttentionForwardTrain(GpuTensor X, GpuTensor Ctx, GpuTensor Wq, GpuTensor Wk, GpuTensor Wv, GpuTensor Wo, GpuTensor? mask, long numHeads, GpuTensor Qh, GpuTensor Kh, GpuTensor Vh, GpuTensor Attnh, GpuTensor Yconcat, GpuTensor O);
  [manual] void crossAttentionBackward(GpuTensor dO, GpuTensor X, GpuTensor Ctx, GpuTensor Qh, GpuTensor Kh, GpuTensor Vh, GpuTensor Attnh, GpuTensor Yconcat, GpuTensor Wq, GpuTensor Wk, GpuTensor Wv, GpuTensor Wo, GpuTensor? mask, long numHeads, GpuTensor dX, GpuTensor dCtx, GpuTensor dWq, GpuTensor dWk, GpuTensor dWv, GpuTensor dWo);

  void attentionTokenMoments(GpuTensor Attn, long h_lat, long w_lat, GpuTensor mass, GpuTensor centroid);
  void buildCausalMaskRow(long L, long q, GpuTensor mask);

  [manual] void selfAttentionBiasForward(GpuTensor X, GpuTensor Wq, GpuTensor Wk, GpuTensor Wv, GpuTensor Wo, GpuTensor? mask, GpuTensor? attnBias, long numHeads, double scale, GpuTensor O);
  [manual] void flashAttentionForward(GpuTensor Q, GpuTensor K, GpuTensor V, GpuTensor? mask, long numHeads, boolean causal, GpuTensor O);
  [manual] void flashAttentionWindowedForward(GpuTensor Q, GpuTensor K, GpuTensor V, GpuTensor? mask, long numHeads, long window, GpuTensor O);
  [manual] void flashAttentionBackward(GpuTensor Q, GpuTensor K, GpuTensor V, GpuTensor O, GpuTensor dO, GpuTensor? mask, long numHeads, boolean causal, GpuTensor dQ, GpuTensor dK, GpuTensor dV);
  [manual] void flashAttentionQkvoForward(GpuTensor X, GpuTensor? Ctx, GpuTensor Wq, GpuTensor? bq, GpuTensor Wk, GpuTensor? bk, GpuTensor Wv, GpuTensor? bv, GpuTensor Wo, GpuTensor? bo, GpuTensor? mask, long numHeads, boolean causal, GpuTensor O);
  [manual] void flashAttentionQkvoBackward(object opts);
  [manual] void flashAttentionProjectKv(GpuTensor ctx, GpuTensor Wk, GpuTensor? bk, GpuTensor Wv, GpuTensor? bv, GpuTensor K_out, GpuTensor V_out);
  [manual] void flashAttentionQWithKvCachedForward(GpuTensor X, GpuTensor K, GpuTensor V, GpuTensor Wq, GpuTensor? bq, GpuTensor Wo, GpuTensor? bo, GpuTensor? mask, long numHeads, boolean causal, GpuTensor O);
  void flashAttentionDecode(GpuTensor Q, GpuTensor K_cache, GpuTensor V_cache, long validLen, long numHeads, GpuTensor O, optional long numKvHeads, optional double attnSoftcap = 0, optional long window = 0);
  void flashAttentionDecodeMasked(GpuTensor Q, GpuTensor K_cache, GpuTensor V_cache, GpuTensor dMask, long numHeads, GpuTensor O, optional long numKvHeads, optional double attnSoftcap = 0, optional long window = 0);
  void kvCacheAppend(GpuTensor K_new, GpuTensor V_new, long curLen, GpuTensor K_cache, GpuTensor V_cache);

  [manual] void conv2dForward(GpuTensor X, GpuTensor Wt, GpuTensor? bias, long N, long C_in, long H, long W, long C_out, long kH, long kW, long sH, long sW, long pH, long pW, long dH, long dW, long groups, GpuTensor Y);
  void conv2dBackwardInput(GpuTensor Wt, GpuTensor dY, long N, long C_in, long H, long W, long C_out, long kH, long kW, long sH, long sW, long pH, long pW, long dH, long dW, long groups, GpuTensor dX);
  void conv2dBackwardWeight(GpuTensor X, GpuTensor dY, long N, long C_in, long H, long W, long C_out, long kH, long kW, long sH, long sW, long pH, long pW, long dH, long dW, long groups, GpuTensor dWt);
  void conv2dBackwardBias(GpuTensor dY, long N, long C_out, long H_out, long W_out, GpuTensor dB);

  void upsampleNearest2xForward(GpuTensor X, long N, long C, long H, long W, GpuTensor Y);
  void upsampleNearest2xBackward(GpuTensor dY, long N, long C, long H, long W, GpuTensor dX);
  void upsampleBilinear2xForward(GpuTensor X, long N, long C, long H, long W, GpuTensor Y);
  void upsampleBilinear2xBackward(GpuTensor dY, long N, long C, long H, long W, GpuTensor dX);
  void downsampleAvg2xForward(GpuTensor X, long N, long C, long H, long W, GpuTensor Y);
  void downsampleAvg2xBackward(GpuTensor dY, long N, long C, long H, long W, GpuTensor dX);

  void nchwToSequence(GpuTensor X, long N, long C, long H, long W, GpuTensor Y);
  void sequenceToNchw(GpuTensor X, long N, long C, long H, long W, GpuTensor Y);

  void interp2dForward(GpuTensor X, long N, long C, long H_in, long W_in, long H_out, long W_out, long mode, GpuTensor Y);
  void interp2dAlignCornersForward(GpuTensor X, long N, long C, long H_in, long W_in, long H_out, long W_out, long mode, GpuTensor Y);
  void unfold2dForward(GpuTensor X, long N, long C, long H, long W, long kH, long kW, long sH, long sW, long padT, long padB, long padL, long padR, long mode, GpuTensor Y);
  void l2NormalizeNchwForward(GpuTensor X, long N, long C, long H, long W, double eps, GpuTensor Y);
  void convexUpsampleForward(GpuTensor X, GpuTensor Mask, long N, long C, long H, long W, long scale, GpuTensor Y);

  [manual] void resblockForward(object opts);
  [manual] void resblockBackward(object opts);

  [manual] void maskedMeanPoolForward(GpuTensor X, GpuTensor? mask, GpuTensor y);
  [manual] void maskedMeanPoolBackward(GpuTensor dY, GpuTensor? mask, long K, GpuTensor dX);
  double mseVecForward(GpuTensor pred, GpuTensor target);
  void mseVecBackward(GpuTensor pred, GpuTensor target, GpuTensor dPred);
  void mseVecPerSample(GpuTensor pred, GpuTensor target, GpuTensor dPred, GpuTensor lossPerSample);
  [manual] double softmaxXentFused(GpuTensor logits, GpuTensor target, GpuTensor? mask, GpuTensor probs, GpuTensor dLogits);
  [manual] void softmaxXentFusedBatched(GpuTensor logits_BL, GpuTensor target_BL, GpuTensor? mask, GpuTensor headOffsets, long n_heads, GpuTensor probs_BL, GpuTensor dLogits_BL, GpuTensor lossPerSample);

  void embeddingLookupForward(GpuTensor table, GpuTensor idxAsInt32, long B, GpuTensor out);
  void embeddingLookupBackward(GpuTensor dOut, GpuTensor idxAsInt32, long B, GpuTensor dTable);

  [manual] void concatRows(sequence<GpuTensor> parts, GpuTensor out);
  [manual] void splitRows(GpuTensor in_, sequence<GpuTensor> parts);
  [manual] void concatBatchedRows(sequence<GpuTensor> parts, GpuTensor out);
  [manual] void concatNchwChannels(sequence<GpuTensor> parts, long N, long H, long W, sequence<long> C_per_part, GpuTensor out);
  [manual] void concatNchwChannelsBackward(GpuTensor dY, long N, long H, long W, sequence<long> C_per_part, sequence<GpuTensor> dParts);

  void sgdStep(GpuTensor param, GpuTensor grad, GpuTensor velocity, double lr, double momentum);
  void adamStep(GpuTensor param, GpuTensor grad, GpuTensor m, GpuTensor v, double lr, double beta1, double beta2, double eps, long step);
};
