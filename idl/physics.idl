/**
 * =============================================================================
 * Physics — Jolt Physics 3D Simulation & Collision System
 * =============================================================================
 *
 * Complete 3D physics engine binding backed by Jolt Physics.
 * Includes rigid body dynamics, collision queries (raycast, shape cast, overlap),
 * character virtual controllers, vehicles, ragdolls, soft bodies, constraints,
 * and sandbox worlds.
 *
 * @example
 *   Physics.setGravity(0, -9.81, 0);
 *   const body = Physics.createBody({
 *     shape: { type: 'box', halfExtents: [1, 1, 1] },
 *     position: [0, 10, 0],
 *     motionType: 'dynamic'
 *   });
 *   Physics.addImpulse(body, 0, 5, 0);
 */

[json]
dictionary PhysicsVec3 {
  double x;
  double y;
  double z;
};

[json]
dictionary PhysicsQuat {
  double x;
  double y;
  double z;
  double w;
};

[json]
dictionary PhysicsTransform {
  PhysicsVec3 position;
  PhysicsQuat rotation;
  unrestricted double userData;
};

[json]
dictionary PhysicsVelocity {
  PhysicsVec3 linear;
  PhysicsVec3 angular;
};

[json]
dictionary PhysicsAreaOverride {
  DOMString gravityMode;
  PhysicsVec3 gravity;
  boolean gravityPoint;
  double gravityStrength;
  double falloffDistance;
  double gravityScale;
  double linearDamping;
  double angularDamping;
  long priority;
};

[json]
dictionary PhysicsCompoundPart {
  DOMString shape;
  PhysicsVec3 position;
  PhysicsQuat rotation;
  PhysicsVec3 localPosition;
  PhysicsQuat localRotation;
  PhysicsVec3 halfExtents;
  double radius;
  double halfHeight;
  double density;
  double friction;
  double restitution;
};

[json]
dictionary PhysicsBodyOptions {
  DOMString shape;
  PhysicsVec3 position;
  PhysicsQuat rotation;
  PhysicsVec3 localPosition;
  PhysicsQuat localRotation;
  PhysicsVec3 halfExtents;
  double radius;
  double halfHeight;
  boolean static;
  boolean isStatic;
  boolean sensor;
  boolean isSensor;
  boolean ccd;
  double friction;
  double restitution;
  DOMString frictionCombine;
  DOMString restitutionCombine;
  double density;
  double mass;
  double gravityFactor;
  double linearDamping;
  double angularDamping;
  double maxLinearVelocity;
  double maxAngularVelocity;
  unrestricted double userData;
  DOMString dofs;
  long layer;
  sequence<double> points;
  sequence<double> positions;
  sequence<long> indices;
  sequence<PhysicsCompoundPart> parts;
  PhysicsAreaOverride area;
};

[json]
dictionary PhysicsLayersConfig {
  sequence<DOMString> names;
  sequence<boolean> matrix;
};

[json]
dictionary PhysicsRayHit {
  long body;
  long bodyId;
  double fraction;
  unrestricted double userData;
  PhysicsVec3 position;
  PhysicsVec3 normal;
};

[json]
dictionary PhysicsShapeCastHit {
  long body;
  long bodyId;
  double fraction;
  unrestricted double userData;
  PhysicsVec3 position;
  PhysicsVec3 normal;
};

[json]
dictionary PhysicsShapeCastOptions {
  DOMString shape;
  PhysicsVec3 position;
  PhysicsQuat rotation;
  PhysicsVec3 halfExtents;
  double radius;
  double halfHeight;
  PhysicsVec3 direction;
  double maxDistance;
  long ignoreBody;
  sequence<long> ignoreBodies;
  sequence<DOMString> layers;
};

[json]
dictionary PhysicsOverlapShapeOptions {
  DOMString shape;
  PhysicsVec3 position;
  PhysicsQuat rotation;
  PhysicsVec3 halfExtents;
  double radius;
  double halfHeight;
  long ignoreBody;
  sequence<long> ignoreBodies;
  sequence<DOMString> layers;
};

[json]
dictionary PhysicsContactPoint {
  double x;
  double y;
  double z;
};

[json]
dictionary PhysicsContact {
  DOMString type;
  long body1;
  long body2;
  boolean sensor;
  PhysicsVec3 normal;
  double penetration;
  double impulse;
  sequence<PhysicsContactPoint> points;
};

[json]
dictionary PhysicsBodyProperties {
  double mass;
  double friction;
  double restitution;
  double linearDamping;
  double angularDamping;
  double gravityFactor;
  DOMString motionType;
  long layer;
  boolean isSensor;
  unrestricted double userData;
};

[json]
dictionary PhysicsWorldOptions {
  PhysicsVec3 gravity;
  long maxBodies;
};

[json]
dictionary PhysicsCharacterOptions {
  PhysicsVec3 position;
  double radius;
  double halfHeight;
  double mass;
  double maxSlopeAngle;
  double maxStrength;
  PhysicsVec3 shapeOffset;
  DOMString layer;
};

[json]
dictionary PhysicsCharacterState {
  DOMString groundState;
  PhysicsVec3 groundPosition;
  PhysicsVec3 groundNormal;
  PhysicsVec3 groundVelocity;
};

[json]
dictionary PhysicsVehicleOptions {
  PhysicsVec3 position;
  PhysicsQuat rotation;
};

[json]
dictionary PhysicsRagdollOptions {
  PhysicsVec3 position;
  PhysicsQuat rotation;
};

[json]
dictionary PhysicsClothOptions {
  long gridX;
  long gridZ;
  double spacing;
  double mass;
  DOMString pinned;
};

[json]
dictionary PhysicsSoftBodyOptions {
  PhysicsClothOptions cloth;
  PhysicsVec3 position;
  PhysicsQuat rotation;
};

[json]
dictionary PhysicsSoftBodyTopology {
  long gridX;
  long gridZ;
};

[json]
dictionary PhysicsBounds {
  PhysicsVec3 min;
  PhysicsVec3 max;
};

/**
 * A ragdoll pose. What crosses is the FLAT ARRAY a `pose()` / `localPose()`
 * read answers with (7 floats per part: position xyz + quaternion xyzw, or 16
 * per part for a column-major matrix), serialised as JSON; the wrapper hands
 * `Array.from(pose)` to the native, so a Float32Array is accepted directly.
 */
[json]
dictionary PhysicsPose {
  sequence<double> data;
};

/** Motor options for `PhysicsRagdoll.driveToPose`. */
[json]
dictionary PhysicsRagdollMotorOptions {
  double frequency;
  double damping;
  double maxTorque;
};

/**
 * `{ interpolated }` option of `Physics.getTransform` / `getAllTransforms`:
 * read the render-interpolated transform instead of the last stepped one.
 */
dictionary PhysicsTransformOptions {
  boolean interpolated = false;
};

/** Driver input of `PhysicsVehicle.setInput`; tracked vehicles read leftRatio/rightRatio. */
[json]
dictionary PhysicsVehicleInput {
  double forward;
  double right;
  double brake;
  double handBrake;
  double leftRatio;
  double rightRatio;
};

/** One wheel's state, from `PhysicsVehicle.wheelState(index)`. */
[json]
dictionary PhysicsWheelState {
  double suspensionLength;
  double angularVelocity;
  double steerAngle;
  double rotationAngle;
  boolean contact;
  long contactBody;
  PhysicsVec3 contactNormal;
  PhysicsVec3 position;
  PhysicsQuat rotation;
};

/** Vehicle state, from `PhysicsVehicle.getState()`. */
[json]
dictionary PhysicsVehicleState {
  double speed;
  double rpm;
  long gear;
};

/** One overlapping body, from the JSON overlap natives. */
[json]
dictionary PhysicsOverlapHit {
  long bodyId;
  unrestricted double userData;
};

/**
 * Query filter of the raw raycast / overlap natives: a layer mask, named
 * layers, and bodies to ignore.
 */
[json]
dictionary PhysicsQueryFilter {
  long layerMask;
  sequence<DOMString> layers;
  long ignoreBody;
  sequence<long> ignoreBodies;
};

[json]
dictionary PhysicsConstraintOptions {
  DOMString type;
  long body1;
  long body2;
  PhysicsVec3 point1;
  PhysicsVec3 point2;
  double minDistance;
  double maxDistance;
  PhysicsVec3 axis1;
  PhysicsVec3 axis2;
  double minAngle;
  double maxAngle;
  double minLimit;
  double maxLimit;
};

[json]
dictionary PhysicsConstraintMotorOptions {
  DOMString type;
  double target;
  double maxForce;
  double maxTorque;
  double frequency;
  double damping;
  DOMString axis;
};

[global]
interface PhysicsWorldHandle {
  void destroy();
  void step(double dt);
  /** Makes this world the active one for the `Physics.*` calls that follow (pushes it). */
  void enter();
  /** Undoes `enter()` (pops the active world). */
  void exit();
};

[global]
interface PhysicsCharacter {
  void setPosition(double x, double y, double z);
  void setVelocity(double x, double y, double z);
  void setLinearVelocity(double x, double y, double z);
  PhysicsVec3 getPosition();
  PhysicsVec3 getVelocity();
  PhysicsVec3 getLinearVelocity();
  PhysicsCharacterState getState();
  /** Swaps the character's collision shape (crouch / stand); false if it would overlap. */
  boolean setShape(PhysicsBodyOptions shape);
  /** Tag of the inner rigid body other bodies collide with, or -1. */
  readonly attribute long innerBody;
  void update(double dt);
  void destroy();
};

[global]
interface PhysicsVehicle {
  void setDriverInput(double forward, double steer, double brake, double handBrake);
  /** Driver input as one object; tracked vehicles may give leftRatio/rightRatio. */
  void setInput(optional PhysicsVehicleInput input = {});
  /** Motorcycle lean controller on/off. */
  void setLeanController(boolean enabled);
  /** Selects a gear (-1 reverse, 0 neutral, 1..n) with a clutch fraction. */
  void setGear(long gear, optional double clutch = 1.0);
  /** The state of wheel `index`, or null. */
  PhysicsWheelState wheelState(long index);
  /** Speed, engine rpm and current gear. */
  PhysicsVehicleState getState();
  PhysicsTransform getTransform();
  readonly attribute long wheelCount;
  /** Tag of the chassis rigid body. */
  readonly attribute long chassisBody;
  /** 'wheeled', 'tracked' or 'motorcycle'. */
  readonly attribute DOMString type;
  readonly attribute double speed;
  readonly attribute double rpm;
  readonly attribute long gear;
  void destroy();
};

[global]
interface PhysicsRagdoll {
  /** World-space pose: 7 floats per part (position xyz, quaternion xyzw). */
  Float32Array pose();
  /** Parent-relative pose, same layout as `pose()`. */
  Float32Array localPose();
  /** Teleports every part to `pose`. */
  boolean setPose(PhysicsPose pose);
  /** Drives the parts toward `pose` with motorised joints. */
  boolean driveToPose(PhysicsPose pose, optional PhysicsRagdollMotorOptions motor);
  /** Moves the parts kinematically toward `pose` over `dt` seconds. */
  boolean driveToPoseKinematic(PhysicsPose pose, double dt);
  void stopDrive();
  void addImpulse(double x, double y, double z);
  void activate();
  void deactivate();
  boolean isActive();
  readonly attribute long partCount;
  /** Body tag of part `index`, or -1. */
  long partBody(long index);
  /** Parent part index of part `index`, or -1 for the root. */
  long partParent(long index);
  /** Index of the part named `name`, or -1. */
  long partIndex(DOMString name);
  void destroy();
};

[global]
interface PhysicsSoftBody {
  /** Tag of the underlying rigid body. */
  readonly attribute long body;
  readonly attribute long vertexCount;
  PhysicsSoftBodyTopology topology();
  Float32Array vertices();
  boolean pin(long index, optional boolean pinned = true);
  boolean setVertex(long index, double x, double y, double z);
  boolean setVertexVelocity(long index, double x, double y, double z);
  PhysicsBounds getBounds();
  void destroy();
};

[prefix=""]
namespace Physics {
  PhysicsWorldHandle createWorldHandle(optional PhysicsWorldOptions opts);
  void createWorld(optional PhysicsWorldOptions opts);
  void setGravity(double x, double y, double z);
  PhysicsVec3 getGravity();
  boolean setLayers(PhysicsLayersConfig config);
  long createBody(PhysicsBodyOptions config);
  void destroyBody(long tag);
  void destroyAll();
  PhysicsTransform getTransform(long tag, optional PhysicsTransformOptions opts);
  PhysicsVelocity getVelocity(long tag);
  void setPosition(long tag, double x, double y, double z);
  void setRotation(long tag, double x, double y, double z, double w);
  void setLinearVelocity(long tag, double x, double y, double z);
  void setAngularVelocity(long tag, double x, double y, double z);
  void addForce(long tag, double x, double y, double z);
  void addImpulse(long tag, double x, double y, double z);
  void addTorque(long tag, double x, double y, double z);
  void setUserData(long tag, unrestricted double data);
  unrestricted double getUserData(long tag);
  /** Moves a body to a named collision layer (see `setLayers`); false if unknown. */
  boolean setLayer(long tag, DOMString layer);
  void setKinematic(long tag);
  /**
   * 'static' | 'dynamic' | 'kinematic', or a boolean (true = static). The
   * native behind it takes the boolean; the wrapper maps the strings.
   */
  [manual] void setMotionType(long tag, any type);
  void moveKinematic(long tag, double x, double y, double z, double dt);

  [manual] void raycast();
  [manual] void raycastClosest();
  [manual] void castShape();
  [manual] void castShapeClosest();
  [manual] void overlapShape();
  [manual] void overlapSphere();
  [manual] void overlapBox();
  [manual] void overlapPoint();
  [manual] void onContact();
  [manual] void addEventListener();
  [manual] void removeEventListener();

  PhysicsRayHit raycastClosestRaw(double ox, double oy, double oz, double dx, double dy, double dz, double maxDist, optional long mask = 0);
  sequence<PhysicsRayHit> raycastRaw(double ox, double oy, double oz, double dx, double dy, double dz, double maxDist, optional long mask = 0);
  sequence<PhysicsShapeCastHit> castShapeRaw(PhysicsShapeCastOptions config);
  PhysicsShapeCastHit castShapeClosestRaw(PhysicsShapeCastOptions config);
  sequence<long> overlapShapeRaw(PhysicsOverlapShapeOptions config);
  sequence<long> overlapSphereRaw(double x, double y, double z, double radius);
  sequence<long> overlapBoxRaw(double cx, double cy, double cz, double hx, double hy, double hz);
  sequence<long> overlapPointRaw(double x, double y, double z, optional long mask = 0);

  // The natives behind the [manual] raycast / raycastClosest / overlapShape /
  // overlapPoint wrappers: a JSON filter in, JSON hits out (null when nothing
  // was hit).
  PhysicsRayHit raycastClosestJsonRaw(double ox, double oy, double oz, double dx, double dy, double dz, double maxDist, optional PhysicsQueryFilter filter);
  sequence<PhysicsRayHit> raycastJsonRaw(double ox, double oy, double oz, double dx, double dy, double dz, double maxDist, optional PhysicsQueryFilter filter);
  sequence<PhysicsOverlapHit> overlapShapeJsonRaw(PhysicsOverlapShapeOptions config);
  sequence<PhysicsOverlapHit> overlapPointJsonRaw(double x, double y, double z, optional PhysicsQueryFilter filter);

  sequence<PhysicsContact> getContacts();
  void setFrictionCombine(long tag, DOMString mode);
  void setRestitutionCombine(long tag, DOMString mode);
  double getMass(long tag);
  void setMass(long tag, double mass);
  void setLinearDamping(long tag, double damping);
  void setAngularDamping(long tag, double damping);
  void setGravityFactor(long tag, double factor);
  void setFriction(long tag, double friction);
  void setRestitution(long tag, double restitution);
  PhysicsBodyProperties getBodyProperties(long tag);
  /** False when `tag` is not a sensor body. */
  boolean setAreaOverride(long tag, PhysicsAreaOverride config);
  void setTimeStep(double dt);
  /** The fixed step in seconds (1/60 with no world). */
  double getTimeStep();
  void step(double dt);
  void setInterpolation(boolean enabled);
  boolean getInterpolation();
  boolean isActive(long tag);
  void activate(long tag);
  /** Every body's transform, 8 floats per body (tag, position xyz, quaternion xyzw), in one array. */
  Float32Array getAllTransforms(optional PhysicsTransformOptions opts);
  PhysicsCharacter createCharacter(PhysicsCharacterOptions config);
  PhysicsVehicle createVehicle(PhysicsVehicleOptions config);
  PhysicsRagdoll createRagdoll(PhysicsRagdollOptions config);
  PhysicsSoftBody createSoftBody(PhysicsSoftBodyOptions config);
  long createConstraint(PhysicsConstraintOptions config);
  void destroyConstraint(long tag);
  void setConstraintEnabled(long tag, boolean enabled);
  boolean isConstraintEnabled(long tag);
  /**
   * Adjusts a 'wheel' constraint's motor at run time (no-op for other
   * constraints): `enabled` as 0/1 (the wrapper maps a boolean), the target
   * angular `speed` and the `maxTorque` it may apply.
   */
  void setWheelMotor(long handle, long enabled, double speed, double maxTorque);
  /** False when `tag` is not a constraint with a motor. */
  boolean setConstraintMotor(long tag, PhysicsConstraintMotorOptions config);
  void setConstraintBreakingImpulse(long tag, double impulse);
  double getConstraintBreakingImpulse(long tag);
  sequence<long> getBrokenConstraints();
};
