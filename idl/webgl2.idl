/**
 * =============================================================================
 * WebGL2RenderingContext — WebGL 2.0 Graphics Rendering Pipeline
 * =============================================================================
 *
 * OpenGL ES 3.0 compatible 3D hardware-accelerated rendering interface for WebGL2.
 * Includes buffer objects, textures, shaders, programs, framebuffers, renderbuffers,
 * vertex array objects, samplers, queries, and sync primitives.
 *
 * @example
 *   const gl = canvas.getContext('webgl2');
 *   gl.clearColor(0.0, 0.0, 0.0, 1.0);
 *   gl.clear(gl.COLOR_BUFFER_BIT | gl.DEPTH_BUFFER_BIT);
 */

interface WebGLBuffer {};

interface WebGLTexture {};

interface WebGLProgram {};

interface WebGLShader {};

interface WebGLFramebuffer {};

interface WebGLRenderbuffer {};

interface WebGLVertexArrayObject {};

interface WebGLUniformLocation {};

interface WebGLSampler {};

interface WebGLQuery {};

interface WebGLSync {};

interface WebGLTransformFeedback {};

[cpp_namespace="bro::js", prefix=""]
interface WebGL2RenderingContext {
  readonly attribute long canvasWidth;
  readonly attribute long canvasHeight;

  void clearColor(double r, double g, double b, double a);
  void clear(unsigned long mask);
  void viewport(long x, long y, long width, long height);
  void enable(unsigned long cap);
  void disable(unsigned long cap);
  void blendFunc(unsigned long sfactor, unsigned long dfactor);
  void depthFunc(unsigned long func);

  WebGLBuffer? createBuffer();
  void deleteBuffer(WebGLBuffer? buffer);
  void bindBuffer(unsigned long target, WebGLBuffer? buffer);
  void bufferData(unsigned long target, (ArrayBuffer or ArrayBufferView or long) data, unsigned long usage);

  WebGLTexture? createTexture();
  void deleteTexture(WebGLTexture? texture);
  void bindTexture(unsigned long target, WebGLTexture? texture);
  void activeTexture(unsigned long texture);

  WebGLProgram? createProgram();
  void deleteProgram(WebGLProgram? program);
  void linkProgram(WebGLProgram? program);
  void useProgram(WebGLProgram? program);

  WebGLShader? createShader(unsigned long type);
  void deleteShader(WebGLShader? shader);
  void shaderSource(WebGLShader? shader, DOMString source);
  void compileShader(WebGLShader? shader);
  void attachShader(WebGLProgram? program, WebGLShader? shader);

  WebGLVertexArrayObject? createVertexArray();
  void deleteVertexArray(WebGLVertexArrayObject? array);
  void bindVertexArray(WebGLVertexArrayObject? array);

  WebGLUniformLocation? getUniformLocation(WebGLProgram? program, DOMString name);
  void drawArrays(unsigned long mode, long first, long count);
  void drawElements(unsigned long mode, long count, unsigned long type, long offset);
};
