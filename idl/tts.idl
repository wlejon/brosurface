// idl/tts.idl - WebIDL definition for bro.tts (text-to-speech synthesis)

/**
 * @file tts.idl
 * @description Text-to-speech synthesis engines: Kokoro (82M), Qwen3-TTS, and Supertonic-3.
 */

dictionary KokoroLoadOptions {
  DOMString device;
};

dictionary VoiceLoadOptions {
  DOMString path;
};

dictionary KokoroSynthesizeOptions {
  double speed = 1.0;
  Function onDone;
};

dictionary KokoroSynthesizeResult {
  Float32Array samples;
  long sampleRate;
};

dictionary KokoroStreamOptions {
  double speed = 1.0;
  Function onChunk;
  Function onDone;
};

dictionary QwenLoadOptions {
  DOMString device;
};

dictionary QwenSynthesizeOptions {
  DOMString speaker;
  double speed = 1.0;
  Function onDone;
};

dictionary QwenSynthesizeResult {
  Float32Array samples;
  long sampleRate;
};

dictionary QwenStreamOptions {
  DOMString speaker;
  double speed = 1.0;
  Function onChunk;
  Function onDone;
};

dictionary QwenAudioCodes {
  Int32Array codes;
  long numFrames;
};

dictionary SupertonicLoadOptions {
  DOMString device;
};

dictionary SupertonicSynthesizeOptions {
  SupertonicVoice voice;
  double speed = 1.0;
  Function onDone;
};

dictionary SupertonicSynthesizeResult {
  Float32Array samples;
  long sampleRate;
};

dictionary SpeakerEncoderLoadOptions {
  DOMString device;
};

dictionary SpeakerEncoderEmbedOptions {
  (Float32Array or SttAudioBuffer) audio;
  Function onDone;
};

dictionary TtsAssetsOptions {
  DOMString root;
  DOMString lexicon;
  DOMString pos;
  DOMString kokoroConfig;
};

interface KokoroModel {
  readonly attribute boolean loaded;
  readonly attribute DOMString device;

  [manual] Int32Array encodePhonemes(DOMString ipa);
  Voice loadVoice(DOMString path);
  KokoroSession createSession();
};

interface Voice {
  readonly attribute boolean loaded;
  readonly attribute DOMString name;
};

interface KokoroSession {
  readonly attribute boolean loaded;

  [manual] AsyncHandle synthesize((Int32Array or sequence<long>) phonemes, Voice voice, optional KokoroSynthesizeOptions opts);
  void reset();
};

interface QwenTtsModel {
  readonly attribute boolean loaded;
  readonly attribute DOMString device;
  readonly attribute DOMString variant;

  QwenTtsSession createSession();
  [manual] QwenAudioCodes encodeAudio(Float32Array audio);
  [manual] Float32Array decodeCodes(Int32Array codes);
};

interface QwenTtsSession {
  readonly attribute boolean loaded;
  readonly attribute DOMString variant;

  [manual] AsyncHandle synthesize(DOMString text, optional QwenSynthesizeOptions opts);
  void reset();
};

interface SupertonicModel {
  readonly attribute boolean loaded;
  readonly attribute DOMString device;

  SupertonicVoice loadVoiceStyle(DOMString path);
};

interface SupertonicVoice {
  readonly attribute boolean loaded;
  readonly attribute DOMString name;
};

interface SpeakerEncoder {
  readonly attribute boolean loaded;
  readonly attribute DOMString device;

  [manual] AsyncHandle embedSpeaker(Float32Array audio, optional SpeakerEncoderEmbedOptions opts);
};

[cpp_namespace="bro::js", gate="BRO_WITH_SOUNDML", prefix="bro."]
namespace tts {
  void init();
  [manual] (KokoroModel or AsyncHandle) loadKokoro(DOMString dir, optional KokoroLoadOptions opts);
  [manual] (QwenTtsModel or AsyncHandle) loadQwen(DOMString dir, optional QwenLoadOptions opts);
  [manual] (SupertonicModel or AsyncHandle) loadSupertonic(DOMString dir, optional SupertonicLoadOptions opts);
  [manual] (SpeakerEncoder or AsyncHandle) loadSpeakerEncoder(DOMString dir, optional SpeakerEncoderLoadOptions opts);
  [manual] Int32Array phonemize(DOMString text, optional object opts);
  void setAssetRoot(DOMString dir);
  void setAssets(TtsAssetsOptions opts);
  [manual] AsyncHandle synthesize(object model, any textOrPhonemes, any voiceOrOpts, optional object opts);
  [manual] AsyncHandle synthesizeStream(object model, any textOrChunks, any voiceOrOpts, optional object opts);
  [manual] AsyncHandle decodeFrom(KokoroModel kokoro, Voice voice, Float32Array asr, Float32Array F0, Float32Array N, long nPhonemes, optional object opts);
};
