// idl/gesture.idl - WebIDL definition for bro.gesture (acoustic gesture matching)

/**
 * @file gesture.idl
 * @description Non-speech acoustic gesture matching (clicks, rhythms, whistles).
 * Dual-homed on bro.gesture (default mic) and stream.gesture (bro.listen.open handle).
 */

dictionary GesturePolicyOptions {
  double tempoTol = 0.40;
  double pitchTol = 0.12;
  double pitchStabilityTol = 0.06;
  double shapeTol = 0.30;
  long refractoryFrames = 40;
  long minOnsets = 2;
  long minToneFrames = 8;
  long onsetSigFrames = 5;
};

dictionary GestureListenOptions {
  required Function onGesture;
};

dictionary GestureOnsetSignature {
  double voiced;
  double pitchHz;
  double bright;
};

dictionary GestureInspection {
  DOMString name;
  DOMString kind;
  double frameMs;
  sequence<double> intervalsMs;
  sequence<GestureOnsetSignature> onsets;
  double toneHz;
  double toneMs;
  double toneSpread;
};

interface GestureStreamView {
  readonly attribute boolean active;

  long enrollFromAudio(DOMString name, Float32Array samples, optional GesturePolicyOptions policy);
  boolean remove(DOMString name);
  void clear();
  sequence<DOMString> templates();
  GestureInspection? inspect(DOMString name);
  void reset();
  void listen(GestureListenOptions opts);
  void stop();
  boolean isActive();
  long sampleRate();
};

[cpp_namespace="bro::js", gate="BRO_WITH_SOUNDML", prefix="bro."]
namespace gesture {
  void init();
  long enrollFromAudio(DOMString name, Float32Array samples, optional GesturePolicyOptions policy);
  boolean remove(DOMString name);
  void clear();
  sequence<DOMString> templates();
  GestureInspection? inspect(DOMString name);
  void reset();
  void listen(GestureListenOptions opts);
  void stop();
  boolean isActive();
  long sampleRate();
};
