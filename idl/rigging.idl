/**
 * =============================================================================
 * bro Rigging, Animation & Inverse Kinematics API Reference
 * =============================================================================
 *
 * Skeletal structures, joint hierarchies, inverse kinematics solvers (TwoBoneIK, FABRIK, LookAt),
 * skinning weight assignment, automated procedural rigging, and pose retargeting.
 */

dictionary SkinDataOptions {
  long vertexCount;
  long maxWeightsPerVertex;
  Uint16Array indices;
  Float32Array weights;
};

dictionary SkeletonBone {
  DOMString name;
  long parent;
  sequence<unrestricted double> localBindPose;
  sequence<unrestricted double> inverseBindMatrix;
};

dictionary SkeletonSocket {
  DOMString name;
  long boneIndex;
  sequence<unrestricted double> offset;
};

dictionary SkeletonOptions {
  sequence<SkeletonBone> bones;
  sequence<SkeletonSocket> sockets;
};

dictionary PoseTRS {
  sequence<unrestricted double> translation;
  sequence<unrestricted double> rotation;
  sequence<unrestricted double> scale;
};

dictionary IKTwoBoneOptions {
  sequence<unrestricted double> rootPos;
  sequence<unrestricted double> midPos;
  sequence<unrestricted double> endPos;
  sequence<unrestricted double> targetPos;
  sequence<unrestricted double> poleVector;
  unrestricted double length1;
  unrestricted double length2;
};

dictionary IKFabrikOptions {
  sequence<sequence<unrestricted double>> jointPositions;
  sequence<unrestricted double> targetPos;
  unrestricted double tolerance;
  long maxIterations;
};

dictionary IKLookAtOptions {
  sequence<unrestricted double> headPos;
  sequence<unrestricted double> targetPos;
  sequence<unrestricted double> forward;
  sequence<unrestricted double> up;
  unrestricted double maxAngle;
};

dictionary RigLandmark {
  DOMString name;
  sequence<unrestricted double> position;
  unrestricted double confidence;
};

dictionary RigDetectionResult {
  sequence<RigLandmark> landmarks;
  DOMString detectedType;
};

dictionary RigFitResult {
  Skeleton skeleton;
  SkinData skin;
};

dictionary AutoRigOptions {
  DOMString rigType;
  long maxBones;
  boolean voxelize;
  unrestricted double voxelResolution;
};

dictionary LocomotionOptions {
  unrestricted double speed;
  unrestricted double strideLength;
  unrestricted double cycleDuration;
};

[cpp_namespace="bro::js", cpp_guard="BRO_WITH_3D", gate="BRO_WITH_3D"]
interface SkinData {
  constructor(optional SkinDataOptions opts);
  readonly attribute long vertexCount;
  readonly attribute long maxWeights;
  SkinData clone();
  boolean validate();
  void normalize();
};

interface Skeleton {
  constructor(optional SkeletonOptions opts);
  readonly attribute long boneCount;
  long findBone(DOMString name);
  DOMString boneName(long index);
  long boneParent(long index);
  sequence<unrestricted double> boneBindPose(long index);
  sequence<unrestricted double> boneInverseBind(long index);
  Skeleton clone();
};

interface Pose {
  constructor(Skeleton skeleton);
  readonly attribute long boneCount;
  PoseTRS getBoneLocal(long index);
  void setBoneLocal(long index, PoseTRS trs);
  sequence<unrestricted double> getBoneModelMatrix(long index);
  Pose clone();
};

interface SkeletalAnimation {
  readonly attribute DOMString name;
  readonly attribute unrestricted double duration;
  readonly attribute long trackCount;
  void evaluate(unrestricted double time, Pose outPose);
};

interface RigSpec {
  constructor(DOMString type);
  readonly attribute DOMString type;
  readonly attribute sequence<DOMString> requiredBones;
};

interface VoxelChunk {
  constructor(long dimX, long dimY, long dimZ);
  void set(long x, long y, long z, long value);
  long get(long x, long y, long z);
  Mesh toMesh();
};

interface IK {
  static sequence<sequence<unrestricted double>> solveTwoBone(IKTwoBoneOptions opts);
  static sequence<sequence<unrestricted double>> solveFabrik(IKFabrikOptions opts);
  static sequence<unrestricted double> solveLookAt(IKLookAtOptions opts);
};

interface Rig {
  static RigDetectionResult detectLandmarks(Mesh mesh);
  static RigFitResult fitSkeleton(Mesh mesh, RigSpec spec);
  static RigFitResult autoRig(Mesh mesh, optional AutoRigOptions opts);
  static SkinData transferWeights(Mesh sourceMesh, SkinData sourceSkin, Mesh targetMesh);
};
