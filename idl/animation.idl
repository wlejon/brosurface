/**
 * =============================================================================
 * bro Animation & Tweening API Reference
 * =============================================================================
 *
 * Data-driven animation clips, blend spaces, state machines, and property tweening.
 */

dictionary AnimationKeyDef {
  unrestricted double time;
  any value;
  DOMString easing;
};

dictionary AnimationTrackDef {
  DOMString target;
  DOMString property;
  sequence<AnimationKeyDef> keys;
  DOMString interpolation;
};

dictionary AnimationClipDef {
  DOMString name;
  unrestricted double duration;
  boolean loop;
  sequence<AnimationTrackDef> tracks;
};

dictionary TweenPropertyTargets {
  sequence<unrestricted double> position;
  sequence<unrestricted double> rotation;
  sequence<unrestricted double> scale;
  sequence<unrestricted double> color;
  unrestricted double opacity;
  unrestricted double intensity;
  unrestricted double fov;
  unrestricted double custom;
};

dictionary TweenOptions {
  unrestricted double duration;
  DOMString easing;
  long loop;
  boolean yoyo;
  unrestricted double delay;
};

dictionary BlendSpace1DClip {
  DOMString clip;
  unrestricted double pos;
};

dictionary BlendSpace2DClip {
  DOMString clip;
  sequence<unrestricted double> pos;
};

dictionary AnimStateMachineTransition {
  DOMString to;
  DOMString trigger;
  unrestricted double blendTime;
};

dictionary AnimStateMachineState {
  DOMString clip;
  boolean loop;
  sequence<AnimStateMachineTransition> transitions;
};

dictionary AnimStateMachineDef {
  DOMString initialState;
  record<DOMString, AnimStateMachineState> states;
};

[cpp_namespace="bro::js", cpp_guard="BRO_WITH_3D", gate="BRO_WITH_3D"]
interface Tween {
  [manual] Tween to(object target, TweenPropertyTargets props, unrestricted double duration, optional DOMString easing);
  [manual] Tween parallel(sequence<Tween> tweens);
  Tween call(Function callback);
  Tween loop(optional long count);
  Tween start();
  Tween stop();
  Tween pause();
  Tween resume();
  void destroy();
};

interface AnimationPlayer {
  [manual] void addClip(DOMString name, any clip);
  [manual] void clipDef(DOMString name, AnimationClipDef def);
  [manual] void play(DOMString clipName, optional object opts);
  void pause();
  void resume();
  void stop();
  void seek(unrestricted double time);
  void destroy();
};
