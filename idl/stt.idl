// idl/stt.idl - WebIDL definition for bro.stt (speech-to-text inference)

/**
 * @file stt.idl
 * @description Speech-to-text inference models: Whisper, Parakeet, and Qwen3-ASR.
 */

dictionary WhisperLoadOptions {
  DOMString device;
  boolean quantize;
};

dictionary TokenizerLoadOptions {
  required DOMString path;
  DOMString specialTokens;
};

dictionary WhisperTranscribeOptions {
  long maxNewTokens;
  (Int32Array or sequence<long>) prompt;
  double temperature;
  Function onToken;
  Function onDone;
};

dictionary ParakeetTranscribeOptions {
  Function onToken;
  Function onDone;
};

dictionary ParakeetResult {
  Int32Array tokenIds;
  Int32Array frameOffsets;
};

dictionary QwenAsrTranscribeOptions {
  long maxNewTokens;
  (Int32Array or sequence<long>) contextIds;
  Function onToken;
  Function onDone;
};

dictionary QwenAsrEncodeResult {
  Int32Array tokenIds;
};

dictionary QwenAsrStreamOptions {
  DOMString device;
};

dictionary SttAudioBuffer {
  Float32Array samples;
  long sampleRate;
};

interface WhisperTokenizer {
  readonly attribute boolean loaded;

  [manual] (Int32Array or sequence<long>) encode(DOMString text);
  [manual] DOMString decode((Int32Array or sequence<long>) tokenIds);
  [manual] Int32Array buildPrompt(optional object opts);
};

interface WhisperModel {
  readonly attribute boolean loaded;
  readonly attribute DOMString device;

  [manual] AsyncHandle transcribe((Float32Array or SttAudioBuffer) audio, optional (Int32Array or sequence<long> or WhisperTranscribeOptions) promptOrOpts, optional WhisperTranscribeOptions opts);
  WhisperSession createSession();
};

interface WhisperSession {
  readonly attribute boolean loaded;

  [manual] AsyncHandle transcribe((Float32Array or SttAudioBuffer) audio, optional (Int32Array or sequence<long> or WhisperTranscribeOptions) promptOrOpts, optional WhisperTranscribeOptions opts);
  void reset();
};

interface ParakeetTokenizer {
  readonly attribute boolean loaded;

  [manual] (Int32Array or sequence<long>) encode(DOMString text);
  [manual] DOMString decode((Int32Array or sequence<long>) tokenIds);
};

interface ParakeetModel {
  readonly attribute boolean loaded;
  readonly attribute DOMString device;

  [manual] AsyncHandle transcribe((Float32Array or SttAudioBuffer) audio, optional ParakeetTranscribeOptions opts);
  ParakeetSession createSession();
};

interface ParakeetSession {
  readonly attribute boolean loaded;

  [manual] AsyncHandle transcribe((Float32Array or SttAudioBuffer) audio, optional ParakeetTranscribeOptions opts);
  void reset();
};

interface QwenAsrModel {
  readonly attribute boolean loaded;
  readonly attribute DOMString device;

  [manual] AsyncHandle transcribe((Float32Array or SttAudioBuffer) audio, optional QwenAsrTranscribeOptions opts);
  QwenAsrSession createSession();
};

interface QwenAsrSession {
  readonly attribute boolean loaded;

  [manual] AsyncHandle transcribe((Float32Array or SttAudioBuffer) audio, optional QwenAsrTranscribeOptions opts);
  void reset();
};

interface QwenAsrStream {
  readonly attribute boolean loaded;

  [manual] void feed((Float32Array or SttAudioBuffer) audio);
  [manual] QwenAsrEncodeResult finish();
};

[cpp_namespace="bro::js", gate="BRO_WITH_SOUNDML", prefix="bro."]
namespace stt {
  void init();
  [manual] (WhisperModel or AsyncHandle) loadWhisper(DOMString dir, optional WhisperLoadOptions opts);
  [manual] (WhisperTokenizer or AsyncHandle) loadTokenizer(TokenizerLoadOptions opts);
  [manual] (ParakeetModel or AsyncHandle) loadParakeet(DOMString dir, optional WhisperLoadOptions opts);
  [manual] (ParakeetTokenizer or AsyncHandle) loadParakeetTokenizer(DOMString path, optional WhisperLoadOptions opts);
  [manual] (QwenAsrModel or AsyncHandle) loadQwenAsr(DOMString dir, optional WhisperLoadOptions opts);
  [manual] (QwenAsrStream or AsyncHandle) loadQwenAsrStream(DOMString dir, optional QwenAsrStreamOptions opts);
  [manual] AsyncHandle transcribe(object model, (Float32Array or SttAudioBuffer) audio, optional any promptOrOpts, optional object opts);
};
