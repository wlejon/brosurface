// idl/kws.idl - WebIDL definition for bro.kws (streaming keyword spotting)

/**
 * @file kws.idl
 * @description Open-vocabulary keyword spotting via PhonemeSpotter. Dual-homed on bro.kws
 * (default microphone) and stream.kws (bro.listen.open handle).
 */

dictionary KwsSmoothingOptions {
  long hits;
  long window;
};

dictionary KwsPolicyOptions {
  DOMString weights;
  DOMString device;
  double threshold = 0.40;
  long refractoryMs = 600;
  KwsSmoothingOptions smoothing;
  long minPhonemes = 3;
  long entrySilenceFrames = 2;
  double emissionFloor = 0.15;
  double minCoverage = 0.0;
  double scoreNorm = 0.0;
  boolean enrollGaps = false;
  long gapMinFrames = 5;
  double gapTolerance = 0.5;
};

dictionary KwsListenOptions {
  required Function onSpot;
};

dictionary KwsSpan {
  long long startFrame;
  long long endFrame;
  long long matchedFrames;
};

dictionary KwsStateInspection {
  long cls;
  DOMString label;
  boolean gap;
  long gapLo;
  long gapHi;
};

dictionary KwsInspection {
  DOMString name;
  double threshold;
  double frameMs;
  boolean hasGaps;
  sequence<KwsStateInspection> states;
};

dictionary KwsTemplateProgress {
  DOMString name;
  long matched;
  long length;
  double progress;
  double confidence;
  long long completions;
  long long lastAdvanceFrame;
  long long lastFireFrame;
};

dictionary KwsProgress {
  long long frames;
  long long generation;
  sequence<KwsTemplateProgress> templates;
};

dictionary KwsPosteriorTopClass {
  long cls;
  DOMString label;
  double p;
};

dictionary KwsPosterior {
  long long frame;
  sequence<KwsPosteriorTopClass> top;
};

dictionary KwsStats {
  long long framesDelivered;
  long long samplesDelivered;
  double rollingPeak;
};

dictionary KwsEvent {
  DOMString name;
  double confidence;
};

interface KwsStreamView {
  readonly attribute boolean active;

  long enroll(DOMString name, (Int32Array or sequence<long>) phonemeIds, optional KwsPolicyOptions policy);
  long enrollFromAudio(DOMString name, Float32Array samples, optional KwsPolicyOptions policy);
  long enrollFromClasses(DOMString name, (Int32Array or sequence<long>) classIds, optional KwsPolicyOptions policy);
  KwsInspection? inspect(DOMString name);
  boolean remove(DOMString name);
  void clear();
  sequence<DOMString> templates();
  void reset();
  void listen(KwsListenOptions opts);
  void stop();
  void suspend();
  void resume();
  boolean isActive();
  boolean isSuspended();
  boolean isLoaded();
  long sampleRate();
  double prefixProgress();
  KwsProgress? progress();
  KwsPosterior? posterior(optional long topK = 3);
  KwsStats? stats();
  [manual] sequence<KwsEvent>? feed(Float32Array samples);
};

[cpp_namespace="bro::js", gate="BRO_WITH_SOUNDML", prefix="bro."]
namespace kws {
  void init();
  void load(KwsPolicyOptions opts);
  void unload();
  long enroll(DOMString name, (Int32Array or sequence<long>) phonemeIds, optional KwsPolicyOptions policy);
  long enrollFromAudio(DOMString name, Float32Array samples, optional KwsPolicyOptions policy);
  long enrollFromClasses(DOMString name, (Int32Array or sequence<long>) classIds, optional KwsPolicyOptions policy);
  KwsInspection? inspect(DOMString name);
  boolean remove(DOMString name);
  void clear();
  sequence<DOMString> templates();
  void reset();
  void listen(KwsListenOptions opts);
  void stop();
  void suspend();
  void resume();
  boolean isActive();
  boolean isSuspended();
  boolean isLoaded();
  long sampleRate();
  double prefixProgress();
  KwsProgress? progress();
  KwsPosterior? posterior(optional long topK = 3);
  KwsStats? stats();
  [manual] sequence<KwsEvent>? feed(Float32Array samples);
};
