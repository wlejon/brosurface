/**
 * =============================================================================
 * bro Lighting, PBR Materials & Post-FX API Reference
 * =============================================================================
 *
 * Physical lights, PBR materials, post-processing stack, tonemapping, and environmental effects.
 */

dictionary LightConfig {
  DOMString type;
  sequence<unrestricted double> color;
  unrestricted double intensity;
  unrestricted double range;
  unrestricted double innerCone;
  unrestricted double outerCone;
  boolean castShadow;
};

dictionary PBRMaterialConfig {
  sequence<unrestricted double> albedo;
  DOMString albedoTexture;
  unrestricted double roughness;
  DOMString roughnessTexture;
  unrestricted double metallic;
  DOMString metallicTexture;
  sequence<unrestricted double> emissive;
  DOMString emissiveTexture;
  unrestricted double emissiveIntensity;
  DOMString normalTexture;
  unrestricted double normalScale;
  DOMString occlusionTexture;
  unrestricted double occlusionStrength;
  DOMString alphaMode;
  unrestricted double alphaCutoff;
  boolean doubleSided;
};

dictionary EnvironmentConfig {
  DOMString panorama;
  DOMString cubeMap;
  sequence<unrestricted double> color;
  unrestricted double intensity;
  unrestricted double blur;
  boolean background;
};

dictionary ToneMapConfig {
  DOMString mode;
  unrestricted double exposure;
  unrestricted double whitePoint;
};

dictionary AmbientConfig {
  sequence<unrestricted double> color;
  unrestricted double intensity;
};

dictionary ShadowQualityConfig {
  long resolution;
  long cascades;
  unrestricted double maxDistance;
  unrestricted double bias;
  unrestricted double normalBias;
};

dictionary ShadowCacheConfig {
  boolean enabled;
  long staticResolution;
};

dictionary FogConfig {
  DOMString mode;
  sequence<unrestricted double> color;
  unrestricted double density;
  unrestricted double start;
  unrestricted double end;
  unrestricted double heightFalloff;
  unrestricted double height;
};

dictionary AtmosphereConfig {
  sequence<unrestricted double> rayleigh;
  sequence<unrestricted double> mie;
  unrestricted double turbidity;
  sequence<unrestricted double> sunPosition;
  unrestricted double sunIntensity;
};

dictionary StarfieldConfig {
  long starCount;
  unrestricted double starSize;
  unrestricted double twinkleSpeed;
  sequence<unrestricted double> tint;
};

dictionary TiltShiftConfig {
  unrestricted double blur;
  unrestricted double focus;
  unrestricted double range;
};

dictionary BloomConfig {
  unrestricted double threshold;
  unrestricted double intensity;
  unrestricted double radius;
  long iterations;
};

dictionary SSAOConfig {
  unrestricted double radius;
  unrestricted double bias;
  unrestricted double intensity;
  long sampleCount;
};

dictionary SSRConfig {
  unrestricted double maxDistance;
  unrestricted double thickness;
  long stepCount;
  unrestricted double roughnessCutoff;
};

dictionary DepthOfFieldConfig {
  unrestricted double focusDistance;
  unrestricted double focalLength;
  unrestricted double fStop;
  unrestricted double maxBlur;
};

/** Options of `SceneGraph.setColorLUT`. */
dictionary ColorLUTConfig {
  /** Path of the LUT strip image (N*N by N pixels); empty clears the LUT. */
  DOMString path = "";
  /** Cube size N; 0 infers it from the strip's aspect ratio. */
  long size = 0;
  /** Blend between the ungraded (0) and fully graded (1) image. */
  unrestricted double amount = 1.0;
};

dictionary FXAAConfig {
  boolean enabled;
};

[cpp_namespace="bro::js", cpp_guard="BRO_WITH_3D", gate="BRO_WITH_3D"]
interface LightNode {
  attribute sequence<unrestricted double> color;
  attribute unrestricted double intensity;
  attribute unrestricted double range;
  attribute unrestricted double innerCone;
  attribute unrestricted double outerCone;
  attribute boolean castShadow;
};

interface ShapeNode {
  attribute DOMString shapeType;
  attribute sequence<unrestricted double> color;
  attribute sequence<unrestricted double> size;
};

interface SpriteNode {
  attribute DOMString texture;
  attribute sequence<unrestricted double> size;
  [manual] void addAnimation(DOMString name, object animSpec);
  void play(DOMString name);
  void stop();
};

interface HtmlNode {
  void setHtml(DOMString html);
  void markHtmlDirty();
};

interface ParticleNode {
  void burst(long count);
  void clear();
};

interface Particles3DNode {
  void burst(long count);
  void clear();
};

interface GaussianSplatNode {
  void savePly(DOMString path);
};

interface DecalNode {
  attribute DOMString texture;
  attribute sequence<unrestricted double> size;
};

interface ReflectionProbeNode {
  void probeCapture();
};
