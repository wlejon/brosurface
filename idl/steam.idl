/**
 * =============================================================================
 * bro.steam — Steamworks Integration & Services
 * =============================================================================
 *
 * Steamworks integration providing user authentication, achievements, stats,
 * overlay activation, friends list, rich presence, matchmaking lobbies, and voice chat.
 *
 * @example
 *   if (bro.steam.available) {
 *     console.log('Logged into Steam as:', bro.steam.personaName);
 *     bro.steam.setAchievement('ACH_FIRST_WIN');
 *   }
 */

[cpp_namespace="bro::js", prefix="bro."]
namespace steam {
  readonly attribute boolean available;
  readonly attribute DOMString reason;
  readonly attribute unsigned long appId;
  readonly attribute DOMString steamId;
  readonly attribute DOMString personaName;
  readonly attribute boolean isLoggedOn;
  readonly attribute boolean isVoiceRecording;
  readonly attribute long voiceSampleRate;

  attribute EventHandler onpulse;
  attribute EventHandler onfriends;
  attribute EventHandler onoverlay;
  attribute EventHandler onjoinrequest;
  attribute EventHandler onlobbyentered;
  attribute EventHandler onlobbyupdated;
  attribute EventHandler onlobbyleft;
  attribute EventHandler onlobbyinvite;
  attribute EventHandler onlobbyjoinrequest;
  attribute EventHandler onvoicecaptured;

  boolean getAchievement(DOMString name);
  boolean setAchievement(DOMString name);
  boolean clearAchievement(DOMString name);
  double getStat(DOMString name);
  boolean setStat(DOMString name, double value);
  boolean storeStats();
  void activateOverlay(optional DOMString dialog);
  void activateOverlayToWebPage(DOMString url);
  sequence<object> getFriends();
  Promise<object> getAvatar(DOMString steamId, optional (DOMString or long) size);
  boolean setRichPresence(DOMString key, DOMString value);
  void clearRichPresence();
  Promise<object> createLobby(DOMString type, long maxMembers);
  Promise<object> joinLobby(DOMString lobbyId);
  void leaveLobby(DOMString lobbyId);
  boolean setLobbyData(DOMString lobbyId, DOMString key, DOMString value);
  sequence<object> getLobbyMembers(DOMString lobbyId);
  DOMString getLobbyOwner(DOMString lobbyId);
  DOMString getLobbyData(DOMString lobbyId, DOMString key);
  void requestLobbyList(optional object filter);
  boolean inviteUserToLobby(DOMString lobbyId, DOMString steamId);
  void startVoiceRecording();
  void stopVoiceRecording();
  Promise<Float32Array> decodeVoice(Uint8Array data, optional long sampleRate);
};
