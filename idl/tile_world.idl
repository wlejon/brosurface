/**
 * =============================================================================
 * bro Tile World API Reference
 * =============================================================================
 *
 * Infinite chunked 2D/2.5D/3D tile maps, voxel extraction, pathfinding, autotiling, and navigation grid integration.
 */

dictionary TilePickResult {
  long tileX;
  long tileY;
  long layer;
  long tileId;
  sequence<unrestricted double> worldPosition;
};

dictionary TilePathResult {
  boolean reachable;
  sequence<sequence<long>> path;
  unrestricted double totalCost;
};

dictionary TileRegionResult {
  long regionId;
  sequence<sequence<long>> tiles;
  long area;
};

dictionary TileAutotileRule {
  long matchTile;
  long outputTile;
  long mask;
};

dictionary TileLayerConfig {
  DOMString name;
  long zIndex;
  boolean collision;
  unrestricted double opacity;
  boolean visible;
};

dictionary TileChunkInfo {
  long chunkX;
  long chunkY;
  long tileCount;
  boolean dirty;
};

dictionary TileVoxelExtractOptions {
  long minX;
  long minY;
  long maxX;
  long maxY;
  unrestricted double heightScale;
};

dictionary TileAgentNavOptions {
  long agentRadius;
  boolean allowDiagonal;
  long maxSlope;
};

dictionary TileWorldConfig {
  long chunkSize;
  unrestricted double tileSize;
  sequence<TileLayerConfig> layers;
  DOMString tileAtlas;
  long atlasTileWidth;
  long atlasTileHeight;
};

[cpp_namespace="bro::js", cpp_guard="BRO_WITH_3D", gate="BRO_WITH_3D"]
interface TileWorld {
  readonly attribute SceneNode? node;
  readonly attribute long width;
  readonly attribute long height;
  readonly attribute long chunkCount;
  readonly attribute long chunks;
  attribute boolean paging;
  readonly attribute long vertexCount;
  readonly attribute long triangleCount;

  long update(optional unrestricted double camX = 0, optional unrestricted double camY = 0, optional unrestricted double camZ = 0);
  void setTile(long layer, long x, long y, long tileId);
  long getTile(long layer, long x, long y);
  void fillRect(long layer, long x, long y, long w, long h, long tileId);
  void clearLayer(long layer);

  TilePickResult? pickTile(unrestricted double worldX, unrestricted double worldZ);
  TilePathResult findPath(long startX, long startY, long endX, long endY, optional TileAgentNavOptions opts);
  sequence<TileRegionResult> computeRegions(long layer);
  void applyAutotile(long layer, sequence<TileAutotileRule> rules);

  // [manual]: bromesh mints `Mesh` as a host class, not a `__bro_native.mesh`
  // class, so the result has no native class path; bro registers the entry
  // point by hand with a dynamic result (native_scene_tile_ops.cpp).
  [manual] Mesh extractVoxelMesh(optional TileVoxelExtractOptions opts);
  void setOrigin(unrestricted double x, unrestricted double y, unrestricted double z);
  boolean advance(unrestricted double dtMs);

  [manual] void addObjectKind(long kindId, object spec);
  void addObject(long kindId, unrestricted double x, unrestricted double y, unrestricted double z);
  void clearObjects(optional long kindId);
  long objectCount(long kind);
  void rebuildObjects();

  void rebuild();
  void rebuildAll();
  [manual] void configure(object cfg);
  ArrayBuffer save();
  boolean load(ArrayBuffer data);
  void destroy();
};
