/**
 * =============================================================================
 * customElements & HTMLElement — Web Components Custom Elements Registry
 * =============================================================================
 *
 * Implements the W3C Custom Elements specification: custom element registration,
 * constructor invocation, lifecycle callbacks (connectedCallback,
 * disconnectedCallback, attributeChangedCallback), and DOM subtree upgrading.
 *
 * @example
 *   // Define and register a custom element
 *   class MyCounter extends HTMLElement {
 *     count: number = 0;
 *     static get observedAttributes() { return ["count"]; }
 *     constructor() {
 *       super();
 *       this.count = 0;
 *     }
 *     connectedCallback() {
 *       console.log("Connected to DOM");
 *     }
 *     disconnectedCallback() {
 *       console.log("Disconnected from DOM");
 *     }
 *     attributeChangedCallback(name, oldValue, newValue) {
 *       console.log("Attribute " + name + " changed from " + oldValue + " to " + newValue);
 *     }
 *   }
 *   customElements.define("my-counter", MyCounter);
 *
 * @example
 *   // Instantiate custom element via document.createElement
 *   const el = document.createElement("my-counter");
 *   document.body.appendChild(el);
 */

/**
 * Options for custom element definition (e.g. customized built-in element extension).
 */
dictionary CustomElementOptions {
  /** Tag name of built-in element being extended. */
  DOMString extends;
};

/**
 * Custom element registry for registering and querying custom element definitions.
 */
[
  cpp_file="custom_elements.cpp",
  cpp_header="js/custom_elements.h",
  cpp_includes="\"js/dom_bindings.h\"\n\"dom/element.h\"\n\"dom/node.h\"\n\"dom/document.h\"\n\"util/log.h\"\n<unordered_map>\n<vector>\n<string>\n<algorithm>\n<cctype>",
  cpp_namespace="bro::js",
  cpp_install="installCustomElements",
  install_signature="void installCustomElements(JSContext* ctx, JSClassID elementClassId, void* documentPtr)",
  global_var="customElements",
  element_registry
]
interface CustomElementRegistry {
  /**
   * Register a new custom element definition.
   *
   * @param name Custom element tag name (must contain a hyphen)
   * @param constructor Class constructor extending HTMLElement
   * @param options Optional customization options
   */
  void define(DOMString name, Function constructor, optional CustomElementOptions options);

  /**
   * Retrieve constructor for a registered custom element.
   *
   * @param name Custom element tag name
   * @returns Constructor function or undefined
   */
  Function? get(DOMString name);

  /**
   * Return a promise that resolves when the named custom element is defined.
   *
   * @param name Custom element tag name
   */
  Promise<void> whenDefined(DOMString name);
};

/**
 * Base class for all HTML elements, extended by custom web components.
 */
[cpp_file="custom_elements.cpp", element_base]
interface HTMLElement {
  /**
   * Creates a new HTMLElement instance.
   */
  constructor();
};
