// idl/wake.idl - WebIDL definition for bro.wake (streaming wake-word detection)

/**
 * @file wake.idl
 * @description Streaming wake-word detection via BcResnet2d. Dual-homed on bro.wake
 * (default microphone) and stream.wake (bro.listen.open handle).
 */

dictionary WakeSmoothingOptions {
  long hits;
  long window;
};

dictionary WakeListenOptions {
  DOMString weights;
  required Function onFire;
  double threshold = 0.85;
  WakeSmoothingOptions smoothing;
  long refractoryMs = 500;
  DOMString device;
};

dictionary WakeLoadOptions {
  required DOMString weights;
  DOMString device;
};

dictionary WakeStats {
  long long framesDelivered;
  long long samplesDelivered;
  double rollingPeak;
  double scoreMax;
};

interface WakeStreamView {
  readonly attribute boolean active;

  void listen(WakeListenOptions opts);
  void stop();
  void suspend();
  void resume();
  double lastScore();
  boolean isActive();
  boolean isSuspended();
  boolean isLoaded();
  void setThreshold(double threshold);
  WakeStats? stats();
  [manual] any feed(Float32Array samples, optional long sampleRate);
};

[cpp_namespace="bro::js", gate="BRO_WITH_SOUNDML", prefix="bro."]
namespace wake {
  void init();
  void load(WakeLoadOptions opts);
  void unload();
  void listen(WakeListenOptions opts);
  void stop();
  void suspend();
  void resume();
  double lastScore();
  boolean isActive();
  boolean isSuspended();
  boolean isLoaded();
  void setThreshold(double threshold);
  WakeStats? stats();
  [manual] any feed(Float32Array samples, optional long sampleRate);
};
