/**
 * =============================================================================
 * bro FastNoise2 API Reference
 * =============================================================================
 *
 * SIMD-accelerated procedural noise generation powered by FastNoise2.
 * Available to all bro JS workers via the global `FastNoise` constructor.
 *
 * Two ways to create nodes:
 *   const simplex = FastNoise.create("Simplex");   // generic (any type)
 *   const simplex = FastNoise.Simplex();            // shortcut (common types)
 *
 * Configure with the generic set() method:
 *   node.set("PropertyName", value);     // float, int, or enum string
 *   node.set("Source", otherNode);        // node connection
 *   node.set("Gain", 0.5);               // hybrid as constant
 *   node.set("Gain", noiseNode);          // hybrid driven by noise
 *
 * Introspect any node:
 *   node.getMembers();                    // { type, variables, nodes, hybrids }
 *   FastNoise.types();                    // list all registered node types
 *
 * =============================================================================
 *
 * =============================================================================
 * NODE TYPE REFERENCE
 * =============================================================================
 *
 * Every node type and its configurable properties. Properties are set via
 * node.set("Name", value). Types are:
 *
 *   VAR (float/int), set with a number
 *   VAR (enum), set with a string name or int index
 *   NODE, set with another FastNoise instance
 *   HYBRID, set with a number (constant) or FastNoise (node-driven)
 *
 * Per-dimension properties (marked with [per-dim]) appear multiple times in
 * getMembers(), one per dimension (X, Y, Z, W). They share the same base
 * name; the dimension index distinguishes them internally.
 *
 * =============================================================================
 * BASIC GENERATORS
 * =============================================================================
 *
 * --- Constant ---------------------------------------------------------------
 * Outputs a fixed value everywhere. Useful as input to blend/operator nodes.
 *
 *   VAR  "Value"          (float)   default: 1.0
 *
 *   const c = FastNoise.create("Constant");
 *   c.set("Value", 0.5);
 *
 * --- White ------------------------------------------------------------------
 * Pure white noise (random value per cell).
 *
 *   VAR  "Seed Offset"    (int)
 *   VAR  "Output Min"     (float)
 *   VAR  "Output Max"     (float)
 *
 * --- Checkerboard -----------------------------------------------------------
 * Alternating +1/-1 checkerboard pattern.
 *
 *   VAR  "Feature Scale"  (float)
 *   VAR  "Output Min"     (float)
 *   VAR  "Output Max"     (float)
 *
 * --- SineWave ---------------------------------------------------------------
 * Smooth sine wave pattern.
 *
 *   VAR  "Feature Scale"  (float)
 *   VAR  "Output Min"     (float)
 *   VAR  "Output Max"     (float)
 *
 * --- Gradient ---------------------------------------------------------------
 * Linear gradient along axes.
 *
 *   VAR     "Multiplier"  (float)   [per-dim]
 *   HYBRID  "Offset"      (float)   [per-dim]  default: 0
 *
 * --- DistanceToPoint --------------------------------------------------------
 * Distance from each point to a configurable target.
 *
 *   VAR     "Distance Function" (enum) {Euclidean, Euclidean Squared, Manhattan,
 *                                        Hybrid, Max Axis, Minkowski}
 *   HYBRID  "Point"       (float)   [per-dim]  default: 0
 *   HYBRID  "Minkowski P" (float)   default: 1.5
 *
 * =============================================================================
 * COHERENT NOISE
 * =============================================================================
 *
 * --- Simplex ----------------------------------------------------------------
 *   VAR  "Feature Scale"  (float)
 *   VAR  "Seed Offset"    (int)
 *   VAR  "Output Min"     (float)
 *   VAR  "Output Max"     (float)
 *
 *   const n = FastNoise.create("Simplex");
 *   n.set("Feature Scale", 0.02);
 *
 * --- SuperSimplex -----------------------------------------------------------
 *   (same properties as Simplex)
 *
 * --- Perlin -----------------------------------------------------------------
 *   (same properties as Simplex)
 *
 * --- Value ------------------------------------------------------------------
 *   (same properties as Simplex)
 *
 * =============================================================================
 * CELLULAR NOISE
 * =============================================================================
 *
 * --- CellularValue ----------------------------------------------------------
 * Returns the noise value of the closest cell.
 *
 *   VAR     "Feature Scale"      (float)
 *   VAR     "Seed Offset"        (int)
 *   VAR     "Output Min"         (float)
 *   VAR     "Output Max"         (float)
 *   VAR     "Distance Function"  (enum)  {Euclidean, Euclidean Squared, Manhattan,
 *                                          Hybrid, Max Axis, Minkowski}
 *   VAR     "Value Index"        (int)   0-3, which closest cell to use
 *   HYBRID  "Minkowski P"        (float) default: 1.5
 *   HYBRID  "Grid Jitter"        (float) default: 1.0
 *   HYBRID  "Size Jitter"        (float) default: 0.0
 *
 *   const cv = FastNoise.create("CellularValue");
 *   cv.set("Distance Function", "Manhattan");
 *   cv.set("Grid Jitter", 0.8);
 *
 * --- CellularDistance -------------------------------------------------------
 * Returns the distance to cell boundaries.
 *
 *   VAR     "Feature Scale"      (float)
 *   VAR     "Seed Offset"        (int)
 *   VAR     "Output Min"         (float)
 *   VAR     "Output Max"         (float)
 *   VAR     "Distance Function"  (enum)  {Euclidean, Euclidean Squared, Manhattan,
 *                                          Hybrid, Max Axis, Minkowski}
 *   VAR     "Distance Index 0"   (int)   0-3
 *   VAR     "Distance Index 1"   (int)   0-3
 *   VAR     "Return Type"        (enum)  {Index0, Index0Add1, Index0Sub1,
 *                                          Index0Mul1, Index0Div1}
 *   HYBRID  "Minkowski P"        (float) default: 1.5
 *   HYBRID  "Grid Jitter"        (float) default: 1.0
 *   HYBRID  "Size Jitter"        (float) default: 0.0
 *
 *   const cd = FastNoise.create("CellularDistance");
 *   cd.set("Return Type", "Index0Sub1");
 *   cd.set("Distance Function", "Euclidean");
 *
 * --- CellularLookup ---------------------------------------------------------
 * Evaluates a lookup generator at the position of the closest cell.
 *
 *   VAR     "Feature Scale"      (float)
 *   VAR     "Seed Offset"        (int)
 *   VAR     "Distance Function"  (enum)  {Euclidean, Euclidean Squared, Manhattan,
 *                                          Hybrid, Max Axis, Minkowski}
 *   NODE    "Lookup", generator evaluated at cell positions
 *   HYBRID  "Minkowski P"        (float) default: 1.5
 *   HYBRID  "Grid Jitter"        (float) default: 1.0
 *   HYBRID  "Size Jitter"        (float) default: 0.0
 *
 *   const cl = FastNoise.create("CellularLookup");
 *   cl.set("Lookup", FastNoise.create("Simplex"));
 *
 * =============================================================================
 * FRACTAL
 * =============================================================================
 *
 * --- FractalFBm -------------------------------------------------------------
 * Fractal Brownian Motion, stacks octaves of a source generator.
 *
 *   NODE    "Source", the base generator to fractalise
 *   VAR     "Octaves"            (int)    default: 3
 *   VAR     "Lacunarity"         (float)  default: 2.0
 *   HYBRID  "Gain"               (float)  default: 0.5
 *   HYBRID  "Weighted Strength"  (float)  default: 0.0
 *
 *   const fbm = FastNoise.create("FractalFBm");
 *   fbm.set("Source", FastNoise.create("Simplex"));
 *   fbm.set("Octaves", 5);
 *   fbm.set("Gain", 0.5);
 *   fbm.set("Lacunarity", 2.0);
 *
 * --- FractalRidged ----------------------------------------------------------
 * Ridged multifractal, absolute-value inversion creates ridges.
 *
 *   NODE    "Source", the base generator
 *   VAR     "Octaves"            (int)    default: 3
 *   VAR     "Lacunarity"         (float)  default: 2.0
 *   HYBRID  "Gain"               (float)  default: 0.5
 *   HYBRID  "Weighted Strength"  (float)  default: 0.0
 *
 *   const ridged = FastNoise.create("FractalRidged");
 *   ridged.set("Source", FastNoise.create("Perlin"));
 *   ridged.set("Octaves", 4);
 *
 * =============================================================================
 * DOMAIN WARP
 * =============================================================================
 *
 * --- DomainWarpGradient -----------------------------------------------------
 * Warps input coordinates using gradient-based displacement.
 *
 *   NODE    "Source", generator whose domain is warped
 *   VAR     "Feature Scale"      (float)
 *   VAR     "Seed Offset"        (int)
 *   HYBRID  "Warp Amplitude"     (float)  default: 1.0
 *
 *   const warp = FastNoise.create("DomainWarpGradient");
 *   warp.set("Source", FastNoise.create("Simplex"));
 *   warp.set("Warp Amplitude", 50.0);
 *
 * --- DomainWarpSimplex ------------------------------------------------------
 * Domain warp using simplex-style vectors.
 *
 *   NODE    "Source"
 *   VAR     "Feature Scale"      (float)
 *   VAR     "Seed Offset"        (int)
 *   HYBRID  "Warp Amplitude"     (float)  default: 1.0
 *
 * --- DomainWarpSuperSimplex -------------------------------------------------
 * Domain warp using super-simplex vectors.
 *
 *   (same properties as DomainWarpSimplex)
 *
 * =============================================================================
 * DOMAIN WARP FRACTAL
 * =============================================================================
 *
 * --- DomainWarpFractalProgressive -------------------------------------------
 * Applies fractal octaves to a domain warp, warping progressively.
 *
 *   NODE    "Domain Warp Source", must be a DomainWarp node
 *   VAR     "Octaves"            (int)    default: 3
 *   VAR     "Lacunarity"         (float)  default: 2.0
 *   HYBRID  "Gain"               (float)  default: 0.5
 *   HYBRID  "Weighted Strength"  (float)  default: 0.0
 *
 *   const dwGrad = FastNoise.create("DomainWarpGradient");
 *   dwGrad.set("Source", FastNoise.create("Simplex"));
 *   const dwFrac = FastNoise.create("DomainWarpFractalProgressive");
 *   dwFrac.set("Domain Warp Source", dwGrad);
 *   dwFrac.set("Octaves", 4);
 *
 * --- DomainWarpFractalIndependent -------------------------------------------
 * Applies fractal octaves to a domain warp, each octave independent.
 *
 *   (same properties as DomainWarpFractalProgressive)
 *
 * =============================================================================
 * OPERATORS / BLENDS
 * =============================================================================
 *
 * Operators combine two noise sources. LHS is always a node connection.
 * RHS is a hybrid (accepts a constant float or another noise node).
 * Some operators (Subtract, Divide, Modulus) have hybrid LHS too.
 *
 * --- Add --------------------------------------------------------------------
 *   NODE    "LHS", left-hand source
 *   HYBRID  "RHS"    (float) default: 0.0
 *
 *   const add = FastNoise.create("Add");
 *   add.set("LHS", terrainBase);
 *   add.set("RHS", 0.1);             // constant offset
 *   add.set("RHS", anotherNoise);    // or add two noise sources
 *
 * --- Subtract ---------------------------------------------------------------
 *   HYBRID  "LHS"    (float) default: 0.0, also accepts constant
 *   HYBRID  "RHS"    (float) default: 0.0
 *
 * --- Multiply ---------------------------------------------------------------
 *   NODE    "LHS"
 *   HYBRID  "RHS"    (float) default: 1.0
 *
 *   const scaled = FastNoise.create("Multiply");
 *   scaled.set("LHS", heightNoise);
 *   scaled.set("RHS", 2.0);    // double the amplitude
 *
 * --- Divide -----------------------------------------------------------------
 *   HYBRID  "LHS"    (float) default: 0.0
 *   HYBRID  "RHS"    (float) default: 1.0
 *
 * --- Modulus ----------------------------------------------------------------
 *   HYBRID  "LHS"    (float) default: 0.0
 *   HYBRID  "RHS"    (float) default: 1.0
 *
 * --- Min --------------------------------------------------------------------
 *   NODE    "LHS"
 *   HYBRID  "RHS"    (float) default: 0.0
 *
 *   const clamped = FastNoise.create("Min");
 *   clamped.set("LHS", heightNoise);
 *   clamped.set("RHS", 0.8);   // cap at 0.8
 *
 * --- Max --------------------------------------------------------------------
 *   NODE    "LHS"
 *   HYBRID  "RHS"    (float) default: 0.0
 *
 * --- MinSmooth --------------------------------------------------------------
 * Smooth minimum, blends near the boundary instead of a hard cutoff.
 *
 *   NODE    "LHS"
 *   HYBRID  "RHS"        (float) default: 0.0
 *   HYBRID  "Smoothness" (float) default: 0.1
 *
 * --- MaxSmooth --------------------------------------------------------------
 *   NODE    "LHS"
 *   HYBRID  "RHS"        (float) default: 0.0
 *   HYBRID  "Smoothness" (float) default: 0.1
 *
 * --- Fade -------------------------------------------------------------------
 * Interpolates between two sources based on a fade value.
 *
 *   NODE    "A", source when fade = min
 *   NODE    "B", source when fade = max
 *   HYBRID  "Fade"        (float) default: 0.5
 *   HYBRID  "Fade Min"    (float) default: -1.0
 *   HYBRID  "Fade Max"    (float) default: 1.0
 *   VAR     "Interpolation" (enum) {Linear, Hermite, Quintic}
 *
 *   const blend = FastNoise.create("Fade");
 *   blend.set("A", flatlands);
 *   blend.set("B", mountains);
 *   blend.set("Fade", moistureNoise);   // node-driven blending
 *   blend.set("Interpolation", "Hermite");
 *
 * --- PowFloat ---------------------------------------------------------------
 *   HYBRID  "Value"  (float) default: 2.0
 *   HYBRID  "Pow"    (float) default: 2.0
 *
 * --- PowInt -----------------------------------------------------------------
 *   NODE    "Value"
 *   VAR     "Pow"    (int)   default: 2
 *
 * =============================================================================
 * MODIFIERS
 * =============================================================================
 *
 * --- Remap ------------------------------------------------------------------
 * Remaps the output range of a source generator.
 *
 *   NODE    "Source"
 *   HYBRID  "From Min"    (float) default: -1.0
 *   HYBRID  "From Max"    (float) default: 1.0
 *   HYBRID  "To Min"      (float) default: 0.0
 *   HYBRID  "To Max"      (float) default: 1.0
 *
 *   const remap = FastNoise.create("Remap");
 *   remap.set("Source", noise);
 *   remap.set("From Min", -1.0);
 *   remap.set("From Max", 1.0);
 *   remap.set("To Min", 0.0);
 *   remap.set("To Max", 1.0);
 *
 * --- Terrace ----------------------------------------------------------------
 * Creates terrace/step-like output from continuous noise.
 *
 *   NODE    "Source"
 *   VAR     "Step Count"   (float)
 *   HYBRID  "Smoothness"   (float) default: 0.0
 *
 *   const terrace = FastNoise.create("Terrace");
 *   terrace.set("Source", terrainNoise);
 *   terrace.set("Step Count", 8.0);
 *   terrace.set("Smoothness", 0.3);
 *
 * --- PingPong ---------------------------------------------------------------
 * Folds the output into a ping-pong pattern.
 *
 *   NODE    "Source"
 *   HYBRID  "Ping Pong Strength" (float) default: 2.0
 *
 * --- SeedOffset -------------------------------------------------------------
 * Offsets the seed before passing to the source. Useful for creating
 * independent variations from the same source graph.
 *
 *   NODE    "Source"
 *   VAR     "Seed Offset"  (int)   default: 1
 *
 * --- GeneratorCache ---------------------------------------------------------
 * Caches the source output. Useful when the same generator is used as input
 * to multiple nodes to avoid redundant computation.
 *
 *   NODE    "Source"
 *
 * --- Abs --------------------------------------------------------------------
 * Takes the absolute value of the source output.
 *
 *   NODE    "Source"
 *
 * --- SignedSquareRoot -------------------------------------------------------
 * Applies sign-preserving square root.
 *
 *   NODE    "Source"
 *
 * --- ConvertRGBA8 -----------------------------------------------------------
 * Converts noise to RGBA8 packed format.
 *
 *   NODE    "Source"
 *   VAR     "Min"     (float)
 *   VAR     "Max"     (float)
 *
 * =============================================================================
 * DOMAIN MODIFIERS
 * =============================================================================
 *
 * --- DomainScale ------------------------------------------------------------
 * Scales the input coordinates uniformly.
 *
 *   NODE    "Source"
 *   VAR     "Scaling"  (float) default: 1.0
 *
 *   const ds = FastNoise.create("DomainScale");
 *   ds.set("Source", noise);
 *   ds.set("Scaling", 0.5);   // halves feature frequency
 *
 * --- DomainOffset -----------------------------------------------------------
 * Offsets input coordinates per-dimension.
 *
 *   NODE    "Source"
 *   HYBRID  "Offset"  (float)  [per-dim] default: 0.0
 *
 * --- DomainRotate -----------------------------------------------------------
 * Rotates input coordinates in 3D.
 *
 *   NODE    "Source"
 *   VAR     "Yaw"    (float)   in degrees
 *   VAR     "Pitch"  (float)   in degrees
 *   VAR     "Roll"   (float)   in degrees
 *
 * --- DomainAxisScale --------------------------------------------------------
 * Scales input coordinates per-axis independently.
 *
 *   NODE    "Source"
 *   VAR     "Scaling"  (float)  [per-dim] default: 1.0
 *
 * --- AddDimension -----------------------------------------------------------
 * Adds an extra dimension with a fixed or noise-driven position.
 *
 *   NODE    "Source"
 *   HYBRID  "New Dimension Position"  (float)  default: 0.0
 *
 * --- RemoveDimension --------------------------------------------------------
 * Removes a dimension from the input.
 *
 *   NODE    "Source"
 *   VAR     "Remove Dimension"  (enum)  {X, Y, Z, W}
 *
 * =============================================================================
 *
 * EXAMPLES:
 *
 * @example
 *   // --- Terrain heightmap with FBm -----------------------------------------
 *   const terrainSrc = FastNoise.create("Simplex");
 *   const terrain = FastNoise.create("FractalFBm");
 *   terrain.set("Source", terrainSrc);
 *   terrain.set("Octaves", 6);
 *   terrain.set("Gain", 0.5);
 *   terrain.set("Lacunarity", 2.0);
 *   const heightmap = terrain.genUniformGrid2D(0, 0, 512, 512, 0.002, 1337);
 *   // heightmap is a Float32Array with 262144 values
 *
 * @example
 *   // --- Ridged mountains blended with plains -------------------------------
 *   const plains = FastNoise.create("FractalFBm");
 *   plains.set("Source", FastNoise.create("Simplex"));
 *   plains.set("Octaves", 4);
 *
 *   const mountains = FastNoise.create("FractalRidged");
 *   mountains.set("Source", FastNoise.create("Perlin"));
 *   mountains.set("Octaves", 5);
 *
 *   const biomeNoise = FastNoise.create("Simplex");
 *
 *   const blended = FastNoise.create("Fade");
 *   blended.set("A", plains);
 *   blended.set("B", mountains);
 *   blended.set("Fade", biomeNoise);       // biome noise drives the blend
 *   blended.set("Interpolation", "Hermite");
 *
 *   const world = blended.genUniformGrid2D(0, 0, 1024, 1024, 0.001, 42);
 *
 * @example
 *   // --- 3D voxel density field for caves -----------------------------------
 *   const caveShape = FastNoise.create("FractalRidged");
 *   caveShape.set("Source", FastNoise.create("Perlin"));
 *   caveShape.set("Octaves", 3);
 *   caveShape.set("Gain", 0.6);
 *
 *   const warped = FastNoise.create("DomainWarpGradient");
 *   warped.set("Source", caveShape);
 *   warped.set("Warp Amplitude", 30.0);
 *
 *   const density = warped.genUniformGrid3D(0, 0, 0, 64, 64, 64, 0.02, 7);
 *   // density[z * 64*64 + y * 64 + x], negative = solid, positive = air
 *
 * @example
 *   // --- Domain warp fractal for organic terrain ----------------------------
 *   const dwGrad = FastNoise.create("DomainWarpGradient");
 *   dwGrad.set("Source", FastNoise.create("Simplex"));
 *   dwGrad.set("Warp Amplitude", 20.0);
 *
 *   const dwFrac = FastNoise.create("DomainWarpFractalProgressive");
 *   dwFrac.set("Domain Warp Source", dwGrad);
 *   dwFrac.set("Octaves", 4);
 *   dwFrac.set("Gain", 0.6);
 *
 *   const organic = dwFrac.genUniformGrid2D(0, 0, 256, 256, 0.005, 99);
 *
 * @example
 *   // --- Cellular biome map -------------------------------------------------
 *   const biomes = FastNoise.create("CellularValue");
 *   biomes.set("Distance Function", "Euclidean");
 *   biomes.set("Grid Jitter", 0.8);
 *   biomes.set("Feature Scale", 0.01);
 *   const biomeMap = biomes.genUniformGrid2D(0, 0, 256, 256, 0.01, 55);
 *
 * @example
 *   // --- Terraced plateaus --------------------------------------------------
 *   const baseTerrain = FastNoise.create("FractalFBm");
 *   baseTerrain.set("Source", FastNoise.create("Simplex"));
 *   baseTerrain.set("Octaves", 5);
 *
 *   const plateaus = FastNoise.create("Terrace");
 *   plateaus.set("Source", baseTerrain);
 *   plateaus.set("Step Count", 6.0);
 *   plateaus.set("Smoothness", 0.2);
 *
 *   const terraced = plateaus.genUniformGrid2D(0, 0, 256, 256, 0.005, 123);
 *
 * @example
 *   // --- Runtime introspection ----------------------------------------------
 *   const allTypes = FastNoise.types();
 *   const fbmInfo = FastNoise.create("FractalFBm").getMembers();
 */

/**
 * Metadata record for a FastNoise node type.
 */
dictionary FastNoiseTypeInfo {
  DOMString name;
  sequence<DOMString> groups;
};

/**
 * Configurable member variable metadata.
 */
dictionary FastNoiseMemberVariable {
  DOMString name;
  DOMString type;
  sequence<DOMString>? enumValues;
};

/**
 * Configurable node input lookup metadata.
 */
dictionary FastNoiseMemberNode {
  DOMString name;
};

/**
 * Configurable hybrid (constant or noise-driven) property metadata.
 */
dictionary FastNoiseMemberHybrid {
  DOMString name;
  unrestricted double default;
};

/**
 * Complete introspection descriptor for a FastNoise node.
 */
dictionary FastNoiseNodeMembers {
  DOMString type;
  sequence<FastNoiseMemberVariable> variables;
  sequence<FastNoiseMemberNode> nodes;
  sequence<FastNoiseMemberHybrid> hybrids;
};

/**
 * FastNoise procedural SIMD-accelerated noise generator.
 */
[cpp_file="noise.cpp", cpp_header="api/api.h", cpp_includes="\"runtime/runtime.h\"\n\n#include <FastNoise/FastNoise.h>\n#include <FastNoise/Metadata.h>\n#include <vector>\n#include <cstdint>\n#include <cstring>", cpp_namespace="brokit::api", cpp_install="installNoise", class_id_var="noise_class_id", wrapper_struct="NoiseWrapper", wrapper_member="FastNoise::SmartNode<> node;"]
interface FastNoise {
  /**
   * Create from an encoded node tree string (from FN2 Node Editor).
   * @param encodedNodeTree Base64-encoded node graph
   */
  [cpp_body="if (argc < 1 || !JS_IsString(argv[0]))\n    return JS_ThrowTypeError(ctx, \"FastNoise: expected encoded node tree string\");\n\nconst char* encoded = JS_ToCString(ctx, argv[0]);\nif (!encoded) return JS_EXCEPTION;\n\nauto node = FastNoise::NewFromEncodedNodeTree(encoded);\nJS_FreeCString(ctx, encoded);\n\nif (!node)\n    return JS_ThrowTypeError(ctx, \"FastNoise: invalid encoded node tree\");\n\nJSValue proto = JS_GetPropertyStr(ctx, new_target, \"prototype\");\nif (JS_IsException(proto)) return proto;\n\nJSValue obj = JS_NewObjectProtoClass(ctx, proto, noise_class_id);\nJS_FreeValue(ctx, proto);\nif (JS_IsException(obj)) return obj;\n\nauto* w = new NoiseWrapper{std::move(node)};\nJS_SetOpaque(obj, w);\nreturn obj;"]
  constructor(DOMString encodedNodeTree);

  /**
   * Create any node type by name. Works for all registered FastNoise2 node types.
   * @param typeName e.g. "Simplex", "FractalFBm", "Add"
   * @returns FastNoise instance
   */
  [custom, cpp_body="if (argc < 1 || !JS_IsString(argv[0])) return JS_ThrowTypeError(ctx, \"FastNoise.create(typeName)\");\nconst char* typeName = JS_ToCString(ctx, argv[0]); if (!typeName) return JS_EXCEPTION;\nfor (const auto* meta : FastNoise::Metadata::GetAll()) {\n    if (meta && strcmp(meta->name, typeName) == 0) {\n        JS_FreeCString(ctx, typeName); return wrap_node(ctx, meta->CreateNode());\n    }\n}\nJSValue err = JS_ThrowReferenceError(ctx, \"Unknown FastNoise type '%s'\", typeName); JS_FreeCString(ctx, typeName); return err;"]
  static FastNoise create(DOMString typeName);

  /**
   * List all registered node types with their group categories.
   * @returns Array of node type descriptions
   */
  [custom, cpp_body="JSValue arr = JS_NewArray(ctx); uint32_t idx = 0;\nfor (const auto* meta : FastNoise::Metadata::GetAll()) {\n    if (!meta) continue;\n    JSValue entry = JS_NewObject(ctx); JS_SetPropertyStr(ctx, entry, \"name\", JS_NewString(ctx, meta->name));\n    JSValue groups = JS_NewArray(ctx);\n    for (size_t gi = 0; gi < meta->groups.size(); gi++) JS_SetPropertyUint32(ctx, groups, static_cast<uint32_t>(gi), JS_NewString(ctx, meta->groups[gi]));\n    JS_SetPropertyStr(ctx, entry, \"groups\", groups); JS_SetPropertyUint32(ctx, arr, idx++, entry);\n}\nreturn arr;"]
  static sequence<FastNoiseTypeInfo> types();

  /**
   * Coherent Noise convenience factory: Simplex
   */
  [factory_type="FastNoise::Simplex"]
  static FastNoise Simplex();

  /**
   * Coherent Noise convenience factory: SuperSimplex
   */
  [factory_type="FastNoise::SuperSimplex"]
  static FastNoise SuperSimplex();

  /**
   * Coherent Noise convenience factory: Perlin
   */
  [factory_type="FastNoise::Perlin"]
  static FastNoise Perlin();

  /**
   * Coherent Noise convenience factory: Value
   */
  [factory_type="FastNoise::Value"]
  static FastNoise Value();

  /**
   * Coherent Noise convenience factory: CellularValue
   */
  [factory_type="FastNoise::CellularValue"]
  static FastNoise CellularValue();

  /**
   * Coherent Noise convenience factory: CellularDistance
   */
  [factory_type="FastNoise::CellularDistance"]
  static FastNoise CellularDistance();

  /**
   * Coherent Noise convenience factory: CellularLookup
   */
  [factory_type="FastNoise::CellularLookup"]
  static FastNoise CellularLookup();

  /**
   * Fractal convenience factory: FractalFBm
   */
  [factory_type="FastNoise::FractalFBm"]
  static FastNoise FractalFBm();

  /**
   * Fractal convenience factory: FractalRidged
   */
  [factory_type="FastNoise::FractalRidged"]
  static FastNoise FractalRidged();

  /**
   * Domain Warp convenience factory: DomainWarpGradient
   */
  [factory_type="FastNoise::DomainWarpGradient"]
  static FastNoise DomainWarpGradient();

  /**
   * Set any property by name. Automatically routes to the correct member type
   * (variable, node lookup, or hybrid) using FN2 metadata.
   *
   * @param name Property name
   * @param value float/int variable, enum string, or FastNoise node
   */
  [custom, cpp_body="if (argc < 2 || !JS_IsString(argv[0])) return JS_ThrowTypeError(ctx, \"set(name, value)\");\nconst char* name = JS_ToCString(ctx, argv[0]); if (!name) return JS_EXCEPTION;\nconst auto& meta = w->node->GetMetadata(); JSValueConst val = argv[1];\nfor (const auto& mv : meta.memberVariables) {\n    if (!memberNameMatches(name, mv)) continue;\n    JS_FreeCString(ctx, name);\n    if (mv.type == FastNoise::Metadata::MemberVariable::EFloat) {\n        double d; if (JS_ToFloat64(ctx, &d, val)) return JS_EXCEPTION;\n        return mv.setFunc(w->node.get(), FastNoise::Metadata::MemberVariable::ValueUnion(static_cast<float>(d))) ? JS_UNDEFINED : JS_ThrowTypeError(ctx, \"Failed to set variable\");\n    }\n    if (mv.type == FastNoise::Metadata::MemberVariable::EInt) {\n        int32_t i; if (JS_ToInt32(ctx, &i, val)) return JS_EXCEPTION;\n        return mv.setFunc(w->node.get(), FastNoise::Metadata::MemberVariable::ValueUnion(static_cast<int>(i))) ? JS_UNDEFINED : JS_ThrowTypeError(ctx, \"Failed to set variable\");\n    }\n    if (mv.type == FastNoise::Metadata::MemberVariable::EEnum) {\n        int32_t i = -1;\n        if (JS_IsNumber(val)) { JS_ToInt32(ctx, &i, val); }\n        else if (JS_IsString(val)) {\n            const char* es = JS_ToCString(ctx, val); if (!es) return JS_EXCEPTION;\n            for (size_t ei = 0; ei < mv.enumNames.size(); ei++) { if (strcmp(mv.enumNames[ei], es) == 0) { i = static_cast<int32_t>(ei); break; } }\n            JS_FreeCString(ctx, es); if (i < 0) return JS_ThrowRangeError(ctx, \"Unknown enum value\");\n        } else return JS_ThrowTypeError(ctx, \"Enum expects int or string\");\n        return mv.setFunc(w->node.get(), FastNoise::Metadata::MemberVariable::ValueUnion(static_cast<int>(i))) ? JS_UNDEFINED : JS_ThrowTypeError(ctx, \"Failed to set enum\");\n    }\n    return JS_ThrowTypeError(ctx, \"Unknown variable type\");\n}\nfor (const auto& mn : meta.memberNodeLookups) {\n    if (!memberNameMatches(name, mn)) continue;\n    JS_FreeCString(ctx, name); auto* sw = static_cast<NoiseWrapper*>(JS_GetOpaque2(ctx, val, noise_class_id));\n    if (!sw) return JS_ThrowTypeError(ctx, \"Node input requires a FastNoise node\");\n    return mn.setFunc(w->node.get(), sw->node) ? JS_UNDEFINED : JS_ThrowTypeError(ctx, \"Failed to set node source (type mismatch)\");\n}\nfor (const auto& mh : meta.memberHybrids) {\n    if (!memberNameMatches(name, mh)) continue;\n    JS_FreeCString(ctx, name); auto* sw = static_cast<NoiseWrapper*>(JS_GetOpaque(val, noise_class_id));\n    if (sw) return mh.setNodeFunc(w->node.get(), sw->node) ? JS_UNDEFINED : JS_ThrowTypeError(ctx, \"Failed to set hybrid node source\");\n    double d; if (JS_ToFloat64(ctx, &d, val)) return JS_EXCEPTION;\n    return mh.setValueFunc(w->node.get(), static_cast<float>(d)) ? JS_UNDEFINED : JS_ThrowTypeError(ctx, \"Failed to set hybrid value\");\n}\nJSValue err = JS_ThrowReferenceError(ctx, \"No member '%s' on this node type\", name); JS_FreeCString(ctx, name); return err;"]
  void set(DOMString name, (unrestricted double or DOMString or FastNoise) value);

  /**
   * Introspect this node's configurable members.
   * @returns Node structure description
   */
  [custom, cpp_body="const auto& meta = w->node->GetMetadata(); JSValue result = JS_NewObject(ctx); JS_SetPropertyStr(ctx, result, \"type\", JS_NewString(ctx, meta.name));\nJSValue vars = JS_NewArray(ctx);\nfor (size_t i = 0; i < meta.memberVariables.size(); i++) {\n    const auto& mv = meta.memberVariables[i]; JSValue entry = JS_NewObject(ctx);\n    JS_SetPropertyStr(ctx, entry, \"name\", JS_NewString(ctx, mv.name));\n    JS_SetPropertyStr(ctx, entry, \"type\", JS_NewString(ctx, mv.type == FastNoise::Metadata::MemberVariable::EFloat ? \"float\" : mv.type == FastNoise::Metadata::MemberVariable::EInt ? \"int\" : \"enum\"));\n    if (mv.type == FastNoise::Metadata::MemberVariable::EEnum) {\n        JSValue names = JS_NewArray(ctx); for (size_t ei = 0; ei < mv.enumNames.size(); ei++) JS_SetPropertyUint32(ctx, names, static_cast<uint32_t>(ei), JS_NewString(ctx, mv.enumNames[ei]));\n        JS_SetPropertyStr(ctx, entry, \"enumValues\", names);\n    }\n    JS_SetPropertyUint32(ctx, vars, static_cast<uint32_t>(i), entry);\n}\nJS_SetPropertyStr(ctx, result, \"variables\", vars); JSValue nodes = JS_NewArray(ctx);\nfor (size_t i = 0; i < meta.memberNodeLookups.size(); i++) {\n    JSValue entry = JS_NewObject(ctx); JS_SetPropertyStr(ctx, entry, \"name\", JS_NewString(ctx, meta.memberNodeLookups[i].name));\n    JS_SetPropertyUint32(ctx, nodes, static_cast<uint32_t>(i), entry);\n}\nJS_SetPropertyStr(ctx, result, \"nodes\", nodes); JSValue hybrids = JS_NewArray(ctx);\nfor (size_t i = 0; i < meta.memberHybrids.size(); i++) {\n    JSValue entry = JS_NewObject(ctx); JS_SetPropertyStr(ctx, entry, \"name\", JS_NewString(ctx, meta.memberHybrids[i].name));\n    JS_SetPropertyStr(ctx, entry, \"default\", JS_NewFloat64(ctx, meta.memberHybrids[i].valueDefault)); JS_SetPropertyUint32(ctx, hybrids, static_cast<uint32_t>(i), entry);\n}\nJS_SetPropertyStr(ctx, result, \"hybrids\", hybrids); return result;"]
  FastNoiseNodeMembers getMembers();

  /**
   * Sample a single 2D noise value.
   * @param x X coordinate
   * @param y Y coordinate
   * @param seed Integer seed
   * @returns Noise value at (x, y)
   */
  [cpp_call="return JS_NewFloat64(ctx, w->node->GenSingle2D(\n    static_cast<float>(x), static_cast<float>(y), seed));"]
  unrestricted double genSingle2D(unrestricted double x, unrestricted double y, long seed);

  /**
   * Sample a single 3D noise value.
   * @param x X coordinate
   * @param y Y coordinate
   * @param z Z coordinate
   * @param seed Integer seed
   * @returns Noise value at (x, y, z)
   */
  [cpp_call="return JS_NewFloat64(ctx, w->node->GenSingle3D(\n    static_cast<float>(x), static_cast<float>(y),\n    static_cast<float>(z), seed));"]
  unrestricted double genSingle3D(unrestricted double x, unrestricted double y, unrestricted double z, long seed);

  /**
   * Generate a 2D grid of noise values. Output layout: out[y * xSize + x]
   * @param xOffset Starting X position in world space
   * @param yOffset Starting Y position in world space
   * @param xSize Number of samples along X
   * @param ySize Number of samples along Y
   * @param frequency Step size between samples (both axes)
   * @param seed Integer seed
   * @returns Allocated Float32Array with grid samples
   */
  [cpp_call="if (xSize <= 0 || ySize <= 0)\n    return JS_ThrowRangeError(ctx, \"Grid dimensions must be positive\");\n\nfloat step = static_cast<float>(frequency);\nsize_t count = static_cast<size_t>(xSize) * static_cast<size_t>(ySize);\nstd::vector<float> output(count);\nw->node->GenUniformGrid2D(output.data(),\n                           static_cast<float>(xOffset), static_cast<float>(yOffset),\n                           xSize, ySize, step, step, seed);\nreturn make_float32_array(ctx, output.data(), count);"]
  Float32Array genUniformGrid2D(unrestricted double xOffset, unrestricted double yOffset, long xSize, long ySize, unrestricted double frequency, long seed);

  /**
   * In-place variant of genUniformGrid2D. Writes into a caller-supplied
   * Float32Array (xSize*ySize floats minimum); no per-call allocation.
   * Preferred on the per-frame path: pair with bro.image.alloc(w, h, 1).
   *
   * @param dest Reusable buffer, length >= xSize*ySize
   * @param xOffset Starting X position in world space
   * @param yOffset Starting Y position in world space
   * @param xSize Number of samples along X
   * @param ySize Number of samples along Y
   * @param frequency Step size between samples
   * @param seed Integer seed
   */
  [cpp_call="if (xSize <= 0 || ySize <= 0)\n    return JS_ThrowRangeError(ctx, \"Grid dimensions must be positive\");\n\nsize_t count = static_cast<size_t>(xSize) * static_cast<size_t>(ySize);\nif (n_dest < count)\n    return JS_ThrowRangeError(ctx, \"dest too small: %zu floats required\", count);\n\nfloat step = static_cast<float>(frequency);\nw->node->GenUniformGrid2D(dest,\n                           static_cast<float>(xOffset), static_cast<float>(yOffset),\n                           xSize, ySize, step, step, seed);\nreturn JS_UNDEFINED;"]
  void genUniformGrid2DInto(Float32Array dest, unrestricted double xOffset, unrestricted double yOffset, long xSize, long ySize, unrestricted double frequency, long seed);

  /**
   * Generate a 3D grid of noise values. Output: out[(z * ySize + y) * xSize + x]
   * @param xOffset Starting X position
   * @param yOffset Starting Y position
   * @param zOffset Starting Z position
   * @param xSize Number of samples along X
   * @param ySize Number of samples along Y
   * @param zSize Number of samples along Z
   * @param frequency Step size between samples (all axes)
   * @param seed Integer seed
   * @returns Allocated Float32Array with grid samples
   */
  [cpp_call="if (xSize <= 0 || ySize <= 0 || zSize <= 0)\n    return JS_ThrowRangeError(ctx, \"Grid dimensions must be positive\");\n\nfloat step = static_cast<float>(frequency);\nsize_t count = static_cast<size_t>(xSize) * static_cast<size_t>(ySize) * static_cast<size_t>(zSize);\nstd::vector<float> output(count);\nw->node->GenUniformGrid3D(output.data(),\n                           static_cast<float>(xOff), static_cast<float>(yOff),\n                           static_cast<float>(zOff),\n                           xSize, ySize, zSize,\n                           step, step, step, seed);\nreturn make_float32_array(ctx, output.data(), count);"]
  Float32Array genUniformGrid3D(unrestricted double xOff, unrestricted double yOff, unrestricted double zOff, long xSize, long ySize, long zSize, unrestricted double frequency, long seed);

  /**
   * In-place variant of genUniformGrid3D.
   *
   * @param dest Reusable buffer, length >= xSize*ySize*zSize
   * @param xOffset Starting X position
   * @param yOffset Starting Y position
   * @param zOffset Starting Z position
   * @param xSize Number of samples along X
   * @param ySize Number of samples along Y
   * @param zSize Number of samples along Z
   * @param frequency Step size between samples
   * @param seed Integer seed
   */
  [cpp_call="if (xSize <= 0 || ySize <= 0 || zSize <= 0)\n    return JS_ThrowRangeError(ctx, \"Grid dimensions must be positive\");\n\nsize_t count = static_cast<size_t>(xSize) * static_cast<size_t>(ySize) * static_cast<size_t>(zSize);\nif (n_dest < count)\n    return JS_ThrowRangeError(ctx, \"dest too small: %zu floats required\", count);\n\nfloat step = static_cast<float>(frequency);\nw->node->GenUniformGrid3D(dest,\n                           static_cast<float>(xOff), static_cast<float>(yOff),\n                           static_cast<float>(zOff),\n                           xSize, ySize, zSize,\n                           step, step, step, seed);\nreturn JS_UNDEFINED;"]
  void genUniformGrid3DInto(Float32Array dest, unrestricted double xOff, unrestricted double yOff, unrestricted double zOff, long xSize, long ySize, long zSize, unrestricted double frequency, long seed);

  /**
   * Sample at arbitrary 2D positions rather than on a lattice.
   *
   * Positions are consumed as given — there is no `frequency` argument, because
   * there is no lattice step to scale. Pre-multiply the positions instead.
   *
   * The run length is the SHORTEST of xs/ys, so over-allocating one axis yields
   * the intersection rather than reading past the end of the other. `dest` must
   * hold at least that many floats or the call throws.
   *
   * @param dest Reusable output, length >= min(xs.length, ys.length)
   * @param xs X coordinate array
   * @param ys Y coordinate array
   * @param xOffset Added to every xs value
   * @param yOffset Added to every ys value
   * @param seed Integer seed
   */
  [cpp_call="size_t count = n_xs < n_ys ? n_xs : n_ys;\nif (count == 0) return JS_UNDEFINED;\nif (n_dest < count)\n    return JS_ThrowRangeError(ctx, \"dest too small: %zu floats required\", count);\nif (count > static_cast<size_t>(INT32_MAX))\n    return JS_ThrowRangeError(ctx, \"position count exceeds INT_MAX\");\n\nw->node->GenPositionArray2D(dest, static_cast<int>(count), xs, ys,\n                             static_cast<float>(x_off), static_cast<float>(y_off),\n                             seed);\nreturn JS_UNDEFINED;"]
  void genPositionArray2D(Float32Array dest, Float32Array xs, Float32Array ys, unrestricted double x_off, unrestricted double y_off, long seed);

  /**
   * Sample at arbitrary 3D positions rather than on a lattice.
   *
   * The uniform-grid calls can only express an axis-aligned box, which rules out
   * any sample set that is regular in some *other* space. The motivating case is
   * a cube-sphere planet: its vertices form a regular grid in face space but an
   * irregular point set in 3D, so no genUniformGrid3D call can produce them.
   *
   * Sampling a 3D field directly on a sphere surface also involves no projection,
   * so spherical noise built this way has no wrap seam, no pole singularity, and
   * no discontinuity where cube faces meet — unlike any 2D-per-face scheme.
   *
   * @param dest Reusable output buffer
   * @param xs X coordinate array
   * @param ys Y coordinate array
   * @param zs Z coordinate array
   * @param xOffset Added to every xs value
   * @param yOffset Added to every ys value
   * @param zOffset Added to every zs value
   * @param seed Integer seed
   */
  [cpp_call="size_t count = n_xs;\nif (n_ys < count) count = n_ys;\nif (n_zs < count) count = n_zs;\nif (count == 0) return JS_UNDEFINED;\nif (n_dest < count)\n    return JS_ThrowRangeError(ctx, \"dest too small: %zu floats required\", count);\nif (count > static_cast<size_t>(INT32_MAX))\n    return JS_ThrowRangeError(ctx, \"position count exceeds INT_MAX\");\n\nw->node->GenPositionArray3D(dest, static_cast<int>(count), xs, ys, zs,\n                             static_cast<float>(x_off), static_cast<float>(y_off),\n                             static_cast<float>(z_off), seed);\nreturn JS_UNDEFINED;"]
  void genPositionArray3D(Float32Array dest, Float32Array xs, Float32Array ys, Float32Array zs, unrestricted double x_off, unrestricted double y_off, unrestricted double z_off, long seed);

  /**
   * Generate seamlessly tileable 2D noise. Maps onto a 4D hypertorus internally.
   * @param xSize Tile width in samples
   * @param ySize Tile height in samples
   * @param frequency Step size between samples
   * @param seed Integer seed
   * @returns Allocated Float32Array
   */
  [cpp_call="if (xSize <= 0 || ySize <= 0)\n    return JS_ThrowRangeError(ctx, \"Grid dimensions must be positive\");\n\nfloat step = static_cast<float>(frequency);\nsize_t count = static_cast<size_t>(xSize) * static_cast<size_t>(ySize);\nstd::vector<float> output(count);\nw->node->GenTileable2D(output.data(), xSize, ySize, step, step, seed);\nreturn make_float32_array(ctx, output.data(), count);"]
  Float32Array genTileable2D(long xSize, long ySize, unrestricted double frequency, long seed);
};
