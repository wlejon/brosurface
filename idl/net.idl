/**
 * =============================================================================
 * bro.net & bro.net.sync — Game Networking and Replication System
 * =============================================================================
 *
 * Low-level UDP game networking backed by GameNetworkingSockets, with raw
 * binary packets, structured clone messaging, and multi-channel delivery.
 * Includes bro.net.sync high-level multiplayer state replication and RPCs.
 *
 * @example
 *   bro.net.onconnect = (peerId) => console.log('Peer connected:', peerId);
 *   bro.net.onmessage = (peerId, data) => console.log('Received message:', data);
 *   bro.net.host(7777);
 */

[json]
dictionary NetStats {
  double ping;
  double packetLoss;
  double bytesSent;
  double bytesRecv;
};

[cpp_namespace="bro::js", cpp_guard="BRO_WITH_NET", prefix="bro."]
namespace net {
  void host(long port, optional Function callback);
  void unhost();
  long connect(DOMString address, long port, optional Function callback);
  void disconnect(long peerId);
  void disconnectAll();
  void send(long peerId, (ArrayBuffer or ArrayBufferView) data, optional long channel = 0);
  void broadcast((ArrayBuffer or ArrayBufferView) data, optional long channel = 0);
  [manual] void sendClone(long peerId, any value, optional long channel = 0);
  [manual] void broadcastClone(any value, optional long channel = 0);
  /**
   * The live connection ids, the same numbers onconnect / onmessage hand
   * out. A connection id is a full unsigned 32-bit GameNetworkingSockets
   * handle: as `sequence<long>` the top-bit ids came back negative and no
   * longer compared equal to the id an event delivered.
   */
  sequence<unsigned long> peers();
  DOMString getPeerAddress(long peerId);
  NetStats stats();
  NetStats getPeerStats(long peerId);
  void setPeerSimulatedLoss(long peerId, double chance, double latencyMin, double latencyMax);

  [manual] attribute EventHandler onconnect;
  [manual] attribute EventHandler ondisconnect;
  [manual] attribute EventHandler onmessage;
};
