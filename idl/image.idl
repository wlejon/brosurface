/**
 * =============================================================================
 * bro.image / Image / bro.image.gpu — Image Processing and CPU/GPU Kernels
 * =============================================================================
 *
 * Composable typed-array kernels, CPU/GPU image decoding, transformation, and
 * WebGL2-backed canvas rendering.
 *
 * @example
 *   // FastNoise2 colormap pipeline
 *   const lut = bro.image.gradient([
 *     [0.00,  10,  30,  80],
 *     [0.45, 230, 220, 150],
 *     [0.55, 100, 170,  90],
 *     [0.75, 250, 250, 250],
 *   ]);
 *   const noise = bro.image.alloc(w, h, 1);
 *   const {min, max} = bro.image.reduce(noise, 'minmax');
 *   bro.image.lookup(imgData.data, noise, lut, {lo: min, hi: max});
 *   ctx.putImageData(imgData, 0, 0);
 */

/**
 * Standard HTML Image / DOM Image helper constructor.
 */
interface Image {
  constructor();

  /** Image source URL or path. */
  attribute DOMString src;

  /** Intrinsic image width in pixels. */
  readonly attribute long width;

  /** Intrinsic image height in pixels. */
  readonly attribute long height;

  /** Natural width of image. */
  readonly attribute long naturalWidth;

  /** Natural height of image. */
  readonly attribute long naturalHeight;

  /** True if image has finished loading. */
  readonly attribute boolean complete;

  /** Callback invoked on successful load. */
  attribute Function? onload;

  /** Callback invoked on load error. */
  attribute Function? onerror;

  /** Adds an event listener for image events. */
  void addEventListener(DOMString type, Function listener);

  /** Removes an event listener for image events. */
  void removeEventListener(DOMString type, Function listener);
};

/**
 * Alias for HTMLImageElement DOM interface.
 */
interface HTMLImageElement : Image {};

/**
 * CPU and GPU image manipulation and kernel acceleration suite.
 */
[cpp_namespace="bro::js", prefix="bro."]
namespace image {
  /** Collapse a buffer to a scalar or histogram. */
  any reduce(ArrayBufferView src, DOMString op, optional object params);

  /** Element-wise unary kernel. dst[i] = f(src[i]). */
  void map(Float32Array dst, Float32Array src, object opSpec);

  /** Element-wise binary kernel. dst[i] = f(a[i], b[i]). */
  void combine(Float32Array dst, Float32Array a, Float32Array b, object opSpec);

  /** Map each scalar in src through a 1D RGBA8 LUT into dst. */
  void lookup(ArrayBufferView dst, ArrayBufferView src, Uint8Array lut, object params);

  /** Convolve src with kernel into dst. */
  void stencil(Float32Array dst, Float32Array src, object kernel, object params);

  /** Resize a Float32Array image. */
  void resample(Float32Array dst, Float32Array src, object params);

  /** Build a 1D RGBA8 LUT from color stops. */
  Uint8Array gradient(sequence<sequence<double>> stops, optional long n);

  /** Allocate a TypedArray sized for w*h*channels. */
  ArrayBufferView alloc(long w, long h, long channels, optional DOMString dtype);

  /** Decode a 16-bit image into RGBA. */
  object? decodeU16(any src);

  /** Decode a float / HDR image. */
  object? decodeF32(any src);

  /** Decode 8-bit RGBA and apply EXIF orientation. */
  object decodeOriented(any src);

  /** Cheap header probe for dimensions. */
  object? probeDimensions(ArrayBufferView bytes);

  /** Transcode a KTX2 texture. */
  object transcodeKTX2(ArrayBufferView bytes, optional DOMString format);

  /** Read EXIF orientation tag. */
  long readExifOrientation(any src);

  /** Apply EXIF orientation transform to an RGBA8 buffer. */
  object applyExifOrientation(Uint8Array pixels, long width, long height, long orient);

  /** Encode PNG to file. */
  boolean encodePngFile(DOMString path, Uint8Array pixels, long width, long height, long channels, optional long strideBytes);

  /** Encode PNG to memory. */
  Uint8Array? encodePng(Uint8Array pixels, long width, long height, long channels, optional long strideBytes);

  /** Encode JPEG to file. */
  boolean encodeJpegFile(DOMString path, Uint8Array pixels, long width, long height, long channels, optional long quality);

  /** Encode JPEG to memory. */
  Uint8Array? encodeJpeg(Uint8Array pixels, long width, long height, long channels, optional long quality);

  /** Resize HWC uint8. */
  void resizeU8(Uint8Array dst, Uint8Array src, object params);

  /** Resize HWC float32. */
  void resizeF32(Float32Array dst, Float32Array src, object params);

  /** Resize planar CHW float32. */
  void resizeChwF32(Float32Array dst, Float32Array src, object params);

  /** Letterbox HWC uint8. */
  object letterboxU8(Uint8Array dst, Uint8Array src, object params);

  /** Constant-pad HWC uint8. */
  void padU8(Uint8Array dst, Uint8Array src, object params);

  /** Crop an [x,y,w,h] rect. */
  void cropU8(Uint8Array dst, Uint8Array src, object params);

  /** Center-crop a cropW x cropH rect. */
  void centerCropU8(Uint8Array dst, Uint8Array src, object params);

  /** Mirror left to right. */
  void flipHorizontalU8(Uint8Array dst, Uint8Array src, object params);

  /** Mirror top to bottom. */
  void flipVerticalU8(Uint8Array dst, Uint8Array src, object params);

  /** Rotate by 90-degree multiples. */
  void rotate90U8(Uint8Array dst, Uint8Array src, object params);

  /** Premultiply alpha. */
  void premultiplyAlpha(Uint8Array dst, Uint8Array src);

  /** Unpremultiply alpha. */
  void unpremultiplyAlpha(Uint8Array dst, Uint8Array src);

  /** Alpha-aware RGBA8 resize. */
  void resizeRgba8Alpha(Uint8Array dst, Uint8Array src, object params);

  /** Alpha-aware RGBA8 letterbox. */
  object letterboxRgba8Alpha(Uint8Array dst, Uint8Array src, object params);

  /** RGBA8 to RGB8. */
  void rgbaToRgb(Uint8Array dst, Uint8Array src);

  /** RGB8 to RGBA8. */
  void rgbToRgba(Uint8Array dst, Uint8Array src, optional long alpha);

  /** RGBA8 to gray8. */
  void rgbaToGray(Uint8Array dst, Uint8Array src);

  /** RGB8 to gray8. */
  void rgbToGray(Uint8Array dst, Uint8Array src);

  /** Interleaved HWC to planar CHW float32. */
  void hwcToChw(Float32Array dst, Float32Array src, object params);

  /** Planar CHW to interleaved HWC float32. */
  void chwToHwc(Float32Array dst, Float32Array src, object params);

  /** Apply gamma curve to float32 buffer. */
  void applyGamma(Float32Array dst, Float32Array src, double gamma);

  /** sRGB to linear conversion. */
  void srgbToLinear(Float32Array dst, Float32Array src);

  /** Linear to sRGB conversion. */
  void linearToSrgb(Float32Array dst, Float32Array src);

  /** uint8 sRGB to float32 linear in one pass. */
  void srgbToLinearU8ToF32(Float32Array dst, Uint8Array src);

  /** float32 linear to uint8 sRGB in one pass. */
  void linearF32ToSrgbU8(Uint8Array dst, Float32Array src);

  /** RGB to HSV conversion. */
  void rgbToHsv(Float32Array dst, Float32Array src);

  /** HSV to RGB conversion. */
  void hsvToRgb(Float32Array dst, Float32Array src);

  /** RGB to HSL conversion. */
  void rgbToHsl(Float32Array dst, Float32Array src);

  /** HSL to RGB conversion. */
  void hslToRgb(Float32Array dst, Float32Array src);

  /** Apply row-major 3x3 color matrix. */
  void applyColorMatrix3x3(Float32Array dst, Float32Array src, object params);

  /** Apply row-major 3x4 color matrix. */
  void applyColorMatrix3x4(Float32Array dst, Float32Array src, object params);

  /** Packed NHWC uint8 to planar NCHW float32. */
  void u8NhwcToF32Nchw(Float32Array dst, Uint8Array src, object params);

  /** Float32 NHWC to NCHW. */
  void nhwcToNchwF32(Float32Array dst, Float32Array src, object params);

  /** Float32 NCHW to NHWC. */
  void nchwToNhwcF32(Float32Array dst, Float32Array src, object params);

  /** Planar NCHW float32 to packed NHWC uint8. */
  void f32NchwToU8Nhwc(Uint8Array dst, Float32Array src, object params);

  /** Normalize NCHW float32 buffer with mean/std. */
  void normalizeNchw(Float32Array dst, Float32Array src, object params);

  /** Preprocessing normalization presets (clip, imagenet, sam). */
  readonly attribute object presets;

  /** Multi-channel stencil convolution. */
  void stencilHwc(Float32Array dst, Float32Array src, object kernel, object params);

  /** Fill single-channel feather window. */
  void featherWindow(Float32Array win, object params);

  /** Accumulate tile into global accumulator. */
  void accumulateTile(Float32Array acc, Float32Array wacc, Float32Array tile, Float32Array window, object params);

  /** Normalize tiled accumulator in place. */
  void normalizeAccumulator(Float32Array acc, Float32Array wacc, object params);
};

/**
 * WebGL2-backed GPU image rendering and procedural generation.
 */
[js_alias="bro.image.gpu"]
namespace image_gpu {
  /** Colormap a scalar field to canvas via WebGL2 fragment shader. */
  void colormap(object canvas, Float32Array src, Uint8Array lut, optional object params);

  /** Generate 2D Simplex FBm noise field directly on GPU. */
  void fbm2D(object canvas, Uint8Array lut, object params);
};
