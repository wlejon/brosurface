/**
 * =============================================================================
 * bro.motion — Text-to-Motion Generation (NVIDIA ARDY, Unitree G1 Skeleton)
 * =============================================================================
 *
 * Generates humanoid motion clips from text prompts using the NVIDIA ARDY-G1
 * autoregressive diffusion motion model at 25 fps.
 *
 * @example
 *   // Load ARDY motion pipeline and generate walking clip
 *   const m = bro.motion.load({
 *     checkpoint: '../brodiffusion/weights/ardy-g152',
 *     textEncoder: '../brolm/weights/llm2vec-llama3-8b'
 *   });
 *   const clip = m.generate('a person walks forward and waves', {
 *     frames: 104,
 *     steps: 10,
 *     cfg: 2.5,
 *     seed: 0
 *   });
 *   console.log('Generated frames:', clip.frames, 'joints:', clip.joints, 'fps:', clip.fps);
 *
 * @example
 *   // Probe runtime backends
 *   bro.motion.init();
 */

/**
 * Configuration options for loading an ARDY motion model pipeline.
 */
dictionary MotionLoadOptions {
  /** Path to ARDY g152 weights directory (denoiser, tokenizer, stats) */
  [strict] DOMString checkpoint;
  /** Path to merged LLM2Vec Llama-3-8B text encoder weights directory */
  [strict] DOMString textEncoder;
  /** Optional target device ('cuda', 'metal', or 'cpu') */
  [strict] DOMString device;
};

/**
 * Generation options for ARDY text-to-motion inference.
 */
dictionary MotionGenerateOptions {
  /** Requested clip length in frames at 25 fps (rounded to multiple of 52) */
  long frames = 104;
  /** DDIM denoising steps per window */
  long steps = 10;
  /** Classifier-free guidance weight */
  double cfg = 2.5;
  /** RNG seed for noise reproducibility */
  long seed = 0;
  /** Frame-0 heading angle in radians */
  double heading = 0.0;
};

/**
 * Generated motion clip containing skeletal transforms and foot contact state.
 */
dictionary MotionClip {
  /** Actual frame count */
  long frames;
  /** Joint count (34 for Unitree G1) */
  long joints;
  /** Frames per second (25) */
  double fps;
  /** World joint positions (frames * joints * 3 floats in meters) */
  Float32Array positions;
  /** Joint parent indices (34 entries, -1 for root) */
  Int32Array parents;
  /** Foot contact indicator flags (frames * 4 floats: L-heel, L-toe, R-heel, R-toe) */
  Float32Array footContacts;
};

/**
 * ARDY text-to-motion generation pipeline instance.
 */
[cpp_namespace="bro::js"]
interface ArdyMotionPipeline {
  /** Execution device ('CUDA', 'Metal', or 'CPU') */
  readonly attribute DOMString device;

  /**
   * Generates a motion clip from a text prompt.
   * @param text Motion prompt description
   * @param opts Generation configuration options
   * @returns Generated motion clip object
   */
  MotionClip generate(DOMString text, optional MotionGenerateOptions opts);
};

/**
 * Motion generation engine namespace.
 */
[gate="BRO_WITH_DIFFUSION && BRO_WITH_LM", cpp_namespace="bro::js", prefix="bro."]
namespace motion {
  /**
   * Initializes the brotensor runtime backend probe.
   */
  void init();

  /**
   * Loads an ARDY motion model pipeline.
   * @param opts Configuration paths and device
   * @returns Loaded motion generation pipeline
   */
  ArdyMotionPipeline load(MotionLoadOptions opts);
};
